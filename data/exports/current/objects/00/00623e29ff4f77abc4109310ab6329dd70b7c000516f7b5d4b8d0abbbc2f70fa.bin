.item-page{color:#eee5cc;overflow-wrap:anywhere;min-width:0}.item-page h2{margin:8px 0 24px;font-family:Georgia,serif;font-size:clamp(2rem,4vw,3.6rem);font-weight:400;line-height:1}.item-page button{min-height:44px;color:inherit;cursor:pointer;background:0 0;border:1px solid #d3bc7e40;border-radius:8px;padding:10px 14px}.item-page__breadcrumbs{margin-bottom:18px}.item-page__breadcrumbs ol{min-width:0;color:var(--muted);flex-wrap:wrap;align-items:center;gap:4px;margin:0;padding:0;list-style:none;display:flex}.item-page__breadcrumbs li{align-items:center;gap:4px;min-width:0;display:inline-flex}.item-page__breadcrumbs li+li:before{content:"›";color:var(--gold-bright)}.item-page__breadcrumbs button{min-height:36px;color:var(--gold-bright);border-color:#0000;padding:5px 7px}.item-page__breadcrumbs button:hover{background:#d3bc7e14;border-color:#d3bc7e40}.item-page__tabs{flex-wrap:wrap;gap:6px;margin-bottom:24px;display:flex}.item-page__tabs [aria-selected=true]{background:#d3bc7e26;border-color:#d3bc7e}.item-page :focus-visible{outline-offset:3px;outline:2px solid #d3bc7e}.item-page [role=tabpanel]{border:1px solid #d3bc7e26;border-radius:8px;padding:16px}@media (max-width:390px){.item-page__tabs button{flex:90px;padding-inline:8px}}.item-details__lead{grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);align-items:start;gap:24px;display:grid}.item-details__lead--text{grid-template-columns:1fr;gap:14px}.item-details__media{background:#00000029;border-radius:10px;min-width:0}.item-details__media .entity-media-gallery{grid-template-columns:1fr;gap:12px;display:grid}.item-details__media figure{margin:0}.item-details__media img{object-fit:contain;border-radius:10px;width:100%;height:auto;max-height:480px;display:block}.item-details__media figcaption,.item-details__media .media-fallback{color:var(--muted);padding:14px}.item-details__description{white-space:pre-wrap;margin-top:0;line-height:1.65}.item-details__description--empty{color:var(--muted);font-style:italic}.item-details__facts,.item-details__properties{gap:12px;margin:18px 0;display:grid}.item-details__facts{grid-template-columns:repeat(auto-fit,minmax(min(100%,180px),1fr))}.item-details__facts>div,.item-details__properties>div{background:#ffffff06;border-radius:8px;min-width:0;padding:12px}.item-details dt,.item-details__facts dt{color:var(--muted);margin-bottom:5px;font-size:.85rem}.item-details dd,.item-details__facts dd{white-space:pre-wrap;margin:0}.item-details__properties{grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr))}.item-details__knowledge{color:var(--gold-bright);margin-block:8px;display:block}.item-details__sources{color:var(--muted);margin-top:12px;font-size:.85rem}.item-details__sources summary{cursor:pointer;align-items:center;min-height:44px;display:flex}.item-details__sources ul{padding-left:20px}.item-details__notice{border:1px solid var(--gold-soft);border-radius:8px;margin-bottom:20px;padding:14px}@media (max-width:700px){.item-details__lead{grid-template-columns:1fr}.item-details__media img{max-height:320px}}.item-recipes__group{min-width:0;margin-block:1.5rem}.item-recipes__entry{background:var(--surface);overflow-wrap:anywhere;border:1px solid #d3bc7e40;border-radius:.6rem;margin-block:.75rem;padding:1rem}.item-recipes__entry h3,.item-recipes__entry h4{margin-block:.5rem}.item-recipes__status{font-size:.9rem}.item-recipes button{white-space:normal;min-height:44px}.item-recipes__definition-link{border:1px solid var(--line-strong);background:var(--gold-soft);color:var(--gold-bright);cursor:pointer;text-align:left;border-radius:.4rem;padding:.35rem .55rem}.item-recipes__definition-link:hover{border-color:var(--gold)}@media (max-width:340px){body:has(.item-page){min-width:0}}
