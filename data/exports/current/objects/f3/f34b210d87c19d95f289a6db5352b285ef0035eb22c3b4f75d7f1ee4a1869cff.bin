ero__monogram{font-family:var(--serif);font-size:1.5rem}.character-hero__identity{min-width:0}.character-hero__identity h2{font-family:var(--serif);margin:2px 0;font-size:clamp(2rem,4vw,3.7rem);font-weight:400;line-height:1}.character-hero__identity p{color:var(--character-gold);margin:0}.character-hero__identity small{color:var(--character-muted);margin-top:5px;display:block}.character-hero__status{text-align:right;gap:8px;margin:0;display:grid}.character-hero__status div{display:grid}.character-hero__status dt{color:var(--character-muted);text-transform:uppercase;letter-spacing:.1em;font-size:.56rem}.character-hero__status dd{margin:2px 0 0;font-size:.72rem}.character-tabs{border-bottom:1px solid var(--character-line);scrollbar-width:thin;padding:0 16px;display:flex;overflow-x:auto}.character-tabs button{min-height:48px;color:var(--character-muted);cursor:pointer;background:0 0;border:0;border-bottom:2px solid #0000;flex:none;align-items:center;gap:7px;padding:0 13px;display:inline-flex}.character-tabs button:hover,.character-tabs button[aria-current=page]{border-bottom-color:var(--character-gold);color:var(--character-text)}.character-dossier__content{min-width:0;padding:26px}.character-section-heading{margin-bottom:20px}.character-section-heading h2{font-family:var(--serif);margin:2px 0 0;font-size:clamp(1.7rem,3vw,2.5rem);font-weight:400}.character-overview,.character-overview-skeleton{gap:18px;display:grid}.character-overview-skeleton__lead,.character-overview-skeleton__facts span{border:1px solid var(--character-line);background:linear-gradient(100deg,#d8b96d0d 20%,#d8b96d26 45%,#d8b96d0d 70%) 0 0/220% 100%;animation:1.4s ease-in-out infinite character-skeleton-shimmer;overflow:hidden}.character-overview-skeleton__lead{border-radius:14px;align-content:end;gap:12px;min-height:230px;padding:clamp(24px,5vw,54px);display:grid}.character-overview-skeleton__lead span{background:#eee9dc2b;border-radius:999px;width:7rem;height:.65rem}.character-overview-skeleton__lea