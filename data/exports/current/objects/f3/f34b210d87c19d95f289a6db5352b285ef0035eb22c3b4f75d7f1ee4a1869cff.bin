let__totals{grid-template-columns:1fr}.character-state{grid-template-columns:auto minmax(0,1fr)}.character-state button{grid-column:1/-1}.character-skeleton__grid{grid-template-columns:repeat(2,1fr)}}@media (max-width:340px){body:has(.character-page){min-width:0}}@media (prefers-reduced-motion:reduce){.character-skeleton__wide,.character-skeleton__grid i{animation:none}}
