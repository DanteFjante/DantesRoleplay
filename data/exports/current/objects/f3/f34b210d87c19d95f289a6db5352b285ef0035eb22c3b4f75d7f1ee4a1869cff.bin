lor:var(--character-gold);border-radius:8px;flex:none;place-items:center;display:grid;overflow:hidden}.character-inventory__item-media img{object-fit:cover;width:100%;height:100%}.character-inventory__item-copy{flex:auto;min-width:0}.character-inventory__item-copy strong,.character-inventory__item-copy small{overflow-wrap:anywhere;white-space:normal;display:block}.character-inventory__item-copy small{color:var(--character-muted);margin-top:2px;font-size:.63rem}.character-inventory__unknown{color:var(--character-gold)!important}.character-inventory__view-cue{color:var(--character-gold);white-space:nowrap;flex:none;align-items:center;gap:3px;font-size:.64rem;display:inline-flex}.character-inventory__disclosure{width:100%;min-height:38px;color:var(--character-muted);text-align:left;cursor:pointer;background:#d8b96d09;border:0;border-top:1px solid #d3bc7e1c;align-items:center;gap:5px;padding:5px 11px;display:flex}.character-inventory__disclosure:hover{color:var(--character-text);background:#d8b96d14}.character-inventory__disclosure[aria-expanded=true]>svg{transform:rotate(90deg)}.character-inventory__disclosure small{color:var(--character-gold);margin-left:auto}.character-inventory__contents{border-top:1px solid #d3bc7e14;min-width:0;padding:5px 8px 9px}.character-inventory__contents>p{color:var(--character-muted);margin:7px 5px;font-size:.7rem}.character-wallet{position:sticky;top:92px}.character-wallet>header{align-items:center;gap:10px;margin-bottom:14px;display:flex}.character-wallet>header>span{background:var(--character-gold-soft);width:38px;height:38px;color:var(--character-gold);border-radius:50%;place-items:center;display:grid}.character-wallet>header small{color:var(--character-muted);text-transform:uppercase;letter-spacing:.08em}.character-wallet__totals{grid-template-columns:1fr}.character-wallet__denominations{gap:5px;margin-top:12px;display:grid}.character-wallet__denominations li{background:#d8b96d0f;border-radius:8px;grid-template-columns:34px auto minma