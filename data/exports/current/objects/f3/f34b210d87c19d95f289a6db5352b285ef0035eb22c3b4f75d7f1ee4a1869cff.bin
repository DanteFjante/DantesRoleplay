.character-page{--character-gold:#d8b96d;--character-gold-soft:#d8b96d29;--character-surface:#0d1916f0;--character-surface-raised:#162621eb;--character-line:#d3bc7e33;--character-text:#eee9dc;--character-muted:#a9b3ab;min-width:0;color:var(--character-text)}.character-page *,.character-page :before,.character-page :after{box-sizing:border-box}.character-page button,.character-page summary,.character-page input{font:inherit}.character-page button:focus-visible,.character-page summary:focus-visible,.character-page input:focus-visible{outline:2px solid var(--character-gold);outline-offset:3px}.character-page__heading,.character-section-heading,.character-inventory>header{justify-content:space-between;align-items:end;gap:20px;display:flex}.character-page__heading{margin-bottom:22px}.character-page__heading h1{font-family:var(--serif);margin:2px 0 4px;font-size:clamp(2.2rem,4vw,4.4rem);font-weight:400;line-height:.95}.character-page__heading p,.character-section-heading p,.character-inventory>header p{color:var(--character-muted);margin:0}.character-page__heading>strong{border:1px solid var(--character-line);color:var(--character-gold);white-space:nowrap;border-radius:999px;padding:8px 12px;font-size:.72rem}.character-workspace{grid-template-columns:minmax(220px,.25fr) minmax(0,1fr);align-items:start;gap:18px;min-width:0;display:grid}.character-roster,.character-dossier{border:1px solid var(--character-line);background:var(--character-surface);border-radius:16px;min-width:0;box-shadow:0 20px 60px #0000002e}.character-roster{flex-direction:column;max-height:calc(100vh - 116px);display:flex;position:sticky;top:92px;overflow:hidden}.character-roster__heading{border-bottom:1px solid var(--character-line);justify-content:space-between;align-items:center;padding:15px 16px;display:flex}.character-roster__heading small{color:var(--character-gold)}.character-roster__list{overscroll-behavior:contain;scrollbar-width:thin;display:grid;overflow-y:auto}.character-roster__member{min-wi