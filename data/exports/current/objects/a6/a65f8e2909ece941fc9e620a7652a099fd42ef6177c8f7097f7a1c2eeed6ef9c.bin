.party-registry{min-width:0;color:var(--ink)}.party-registry button{border:1px solid var(--line-strong);min-height:44px;color:inherit;cursor:pointer;background:0 0;border-radius:9px}.party-registry__breadcrumbs{margin-bottom:18px}.party-registry__breadcrumbs ol{color:var(--muted);align-items:center;gap:5px;margin:0;padding:0;list-style:none;display:flex}.party-registry__breadcrumbs li{align-items:center;gap:5px;display:inline-flex}.party-registry__breadcrumbs li+li:before{content:"›";color:var(--gold-bright)}.party-registry__breadcrumbs button{min-height:36px;color:var(--gold-bright);border-color:#0000;padding:5px 7px}.party-registry__heading{justify-content:space-between;align-items:end;gap:24px;margin-bottom:22px;display:flex}.party-registry__heading h1{font-family:var(--serif);margin:6px 0 10px;font-size:clamp(2.5rem,6vw,4.8rem);font-weight:400;line-height:.95}.party-registry__heading p{max-width:680px;color:var(--muted);line-height:1.6}.party-registry__heading>strong{color:var(--gold-bright);white-space:nowrap}.party-registry__tabs{gap:8px;margin-bottom:20px;display:flex}.party-registry__tabs button{align-items:center;gap:8px;padding:10px 16px;display:inline-flex}.party-registry__tabs [aria-current=page]{border-color:var(--gold);background:var(--gold-soft);color:var(--gold-bright)}.party-registry__filter-status{border:1px solid var(--line);background:var(--surface-soft);border-radius:10px;grid-template-columns:auto 1fr;align-items:baseline;gap:3px 10px;margin-bottom:18px;padding:14px 16px;display:grid}.party-registry__filter-status>span{color:var(--gold-bright);letter-spacing:.09em;text-transform:uppercase;font-size:.75rem;font-weight:800}.party-registry__filter-status small{color:var(--muted);grid-column:2}.party-registry__search{align-items:end;gap:10px;margin-bottom:20px;display:flex}.party-registry__search label{min-width:0;color:var(--muted);flex:1;font-size:.82rem;font-weight:700}.party-registry__search-field{border:1px solid var(--line-strong);min-height:46px;color:var(--muted);background:#00000029;border-radius:9px;align-items:center;gap:9px;margin-top:7px;padding:0 13px;display:flex}.party-registry__search input{width:100%;min-width:0;color:var(--ink);background:0 0;border:0;outline:0}.party-registry__search>button{border-color:var(--gold);background:var(--gold-soft);padding:10px 18px}.party-registry__search>.party-registry__clear{color:var(--gold-bright);background:0 0;border-color:#0000}.party-registry__items{grid-template-columns:repeat(auto-fit,minmax(min(100%,360px),1fr));gap:12px;display:grid}.party-registry-card{text-align:left;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:14px;width:100%;padding:16px;transition:border-color .16s,background .16s,transform .16s;display:grid;background:var(--surface)!important}.party-registry-card:hover{border-color:var(--gold);transform:translateY(-1px);background:var(--surface-raised)!important}.party-registry-card__icon{background:var(--gold-soft);width:44px;height:44px;color:var(--gold-bright);border-radius:10px;place-items:center;display:grid}.party-registry-card__body{gap:4px;min-width:0;display:grid}.party-registry-card__body small{color:var(--gold-bright);text-overflow:ellipsis;white-space:nowrap;overflow:hidden}.party-registry-card__body strong{font-family:var(--serif);font-size:1.25rem}.party-registry-card__body span{color:var(--muted);text-transform:capitalize;font-size:.84rem}.party-registry-card__action{color:var(--gold-bright);white-space:nowrap;align-items:center;gap:4px;font-size:.82rem;display:inline-flex}.party-registry__more{margin:20px auto 0;padding:10px 18px;display:block;border-color:var(--gold)!important}.party-registry__notice,.party-registry__empty{border:1px solid var(--line);background:var(--surface-soft);border-radius:10px;padding:20px}.party-registry__notice--error{border-color:#a65f528c}.party-registry__notice button{padding:9px 14px}.party-registry__empty{color:var(--muted);align-items:start;gap:14px;display:flex}.party-registry__empty h2{color:var(--ink);font-family:var(--serif);margin-bottom:6px;font-weight:400}.recipe-registry{min-width:0}.recipe-registry--embedded{padding-top:6px}.recipe-registry__embedded-heading{justify-content:space-between;align-items:end;gap:18px;margin-bottom:18px;display:flex}.recipe-registry__embedded-heading h2{font-family:var(--serif);margin:4px 0 0;font-size:clamp(1.7rem,4vw,2.35rem);font-weight:400}.recipe-registry__embedded-heading>strong{color:var(--gold-bright);white-space:nowrap}.recipe-page{border:1px solid var(--line);background:var(--surface);min-width:0;color:var(--ink);border-radius:16px;padding:26px 32px 40px}.recipe-page>header{margin-bottom:24px}.recipe-page>header h2{font-family:var(--serif);margin:7px 0 0;font-size:clamp(2.25rem,5vw,4rem);font-weight:400;line-height:1}.recipe-page__scope{border-left:3px solid var(--gold);background:var(--gold-soft);color:var(--muted);padding:12px 14px}.recipe-page .item-recipes__entry{background:var(--surface-soft)}@media (max-width:700px){.party-registry__heading{flex-direction:column;align-items:start}.party-registry__search{flex-direction:column;align-items:stretch}.party-registry__search>button{width:100%}.party-registry-card{grid-template-columns:auto minmax(0,1fr)}.party-registry-card__action{grid-column:2}.recipe-registry__embedded-heading{flex-direction:column;align-items:start}.recipe-page{padding:20px 16px 30px}}
