.board-draft-workshop{gap:1rem;min-width:0;display:grid}.board-draft-workshop fieldset{border:1px solid var(--color-border,#647268);border-radius:.6rem;min-width:0;padding:1rem}.board-draft-workshop label{gap:.4rem;min-width:0;display:grid}.board-draft-fields,.board-draft-obstacle{grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:.8rem;margin-bottom:1rem;display:grid}.board-draft-workshop input:not([type=checkbox]),.board-draft-workshop textarea,.board-draft-workshop select{box-sizing:border-box;color:#f5ecd8;background:#13211b;border:1px solid #87958b;border-radius:.3rem;width:100%;min-width:0;padding:.7rem}.board-draft-workshop textarea{resize:vertical;min-height:6rem}.board-draft-workshop button{min-height:44px;margin:.5rem .5rem .5rem 0;padding:.6rem .8rem}.board-draft-workshop :focus-visible{outline-offset:3px;outline:3px solid #ffdf94}
