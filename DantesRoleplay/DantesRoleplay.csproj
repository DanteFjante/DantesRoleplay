<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DantesRoleplay</RootNamespace>
  </PropertyGroup>

  <!--
    The core project has NO package references, and that is the point. It holds domain types and
    the interfaces the rest of the solution talks to. Entity Framework, SQLite and Jint all live
    in projects that reference this one, never the other way round.

    If a PackageReference ever needs to be added here, that is a signal something belongs in
    DataAccess or RuleAccess instead.
  -->

  <ItemGroup>
    <!-- Core procedure contracts have ONE authored copy: the non-ruleset procedures in catalog/.
         They are embedded under the historical Bootstrap resource name so ProcedureSeeder can
         install the operating manual into a fresh database without maintaining a second folder.
         Ruleset procedures are intentionally excluded: the kernel can start without a game. -->
    <EmbeddedResource Include="..\catalog\procedures\**\*.md"
                      Exclude="..\catalog\procedures\ruleset\**\*.md">
      <Link>Bootstrap\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <LogicalName>DantesRoleplay.Bootstrap.%(Filename)%(Extension)</LogicalName>
      <!-- `.run.md` otherwise looks like the `run` culture and is moved to a satellite
           assembly, silently dropping action.run and mechanic.run from startup seeding. -->
      <WithCulture>false</WithCulture>
    </EmbeddedResource>

    <!-- The two generic example mechanics also come directly from their canonical catalog
         metadata/source pairs. Ruleset mechanics remain installable content, not kernel seed. -->
    <EmbeddedResource Include="..\catalog\mechanics\**\*.md;..\catalog\mechanics\**\*.js"
                      Exclude="..\catalog\mechanics\ruleset\**\*">
      <Link>Rules\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <LogicalName>DantesRoleplay.Rules.%(Filename)%(Extension)</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>

    <!-- Structural event types are kernel contracts and must exist in a fresh database. Embed the
         canonical catalog definitions and schema sidecars rather than maintaining a mirror. -->
    <EmbeddedResource Include="..\catalog\event-types\**\*.json">
      <Link>EventTypes\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <LogicalName>DantesRoleplay.EventTypes.%(Filename)%(Extension)</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Capability-owned domain source moves here incrementally while retaining this assembly. -->
    <Compile Include="..\src\system\**\domain\*.cs">
      <Link>Components\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <!-- Transitional consumers compiled in this assembly use provider-neutral model contracts.
         The local-AI assembly has no reverse reference to this project. -->
    <ProjectReference Include="..\DantesRoleplay.LocalAI\DantesRoleplay.LocalAI.csproj" />
  </ItemGroup>

</Project>
