<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DantesRoleplay</RootNamespace>
  </PropertyGroup>

  <!--
    The core project has NO package references, and that is the point. It holds domain types and
    the interfaces the rest of the solution talks to. Entity Framework, SQLite and Jint all live
    in projects that reference this one, never the other way round.

    If a PackageReference ever needs to be added here, that is a signal something belongs in
    DataAccess or RuleAccess instead.
  -->

  <ItemGroup>
    <!-- Bootstrap contracts are authored as markdown and embedded, so the seeded operating
         manual travels with the assembly and cannot go missing at runtime. -->
    <EmbeddedResource Include="Bootstrap\**\*.md" />

    <!-- The bootstrap game rules, same idea. A SEPARATE folder rather than a subfolder of
         Bootstrap, so the two seeders cannot see each other's files — one folder holding two
         markdown formats would have each seeder failing to parse the other's, which is a
         confusing way to discover a layout decision. -->
    <EmbeddedResource Include="Rules\**\*.md" />

    <!-- The nine world.* structural event types. These are kernel contracts, not game content:
         every commit(kind: "effects") records events against them, so a database without them
         cannot change the world at all. They shipped as catalog files only, which meant a fresh
         install was mute until somebody happened to run an import. The catalog copy still exists
         and still round-trips; this is the copy that guarantees the kernel can run alone. -->
    <EmbeddedResource Include="EventTypes\**\*.json" />
  </ItemGroup>

</Project>
