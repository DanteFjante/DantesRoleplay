{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["test", "level", "proficiencyBonus", "abilities", "abilityModifiers", "savingThrows", "savingThrowProficiencies", "savingThrowModifiers", "skills", "skillProficiencies", "skillModifiers", "initiative", "initiativeModifier", "basePassivePerceptionBreakdown", "basePassivePerception", "sourceId", "sourceLocators"],
  "properties": {
    "test": { "const": "character-sheet-core" },
    "level": { "type": "integer", "minimum": 1, "maximum": 20 },
    "proficiencyBonus": { "type": "integer", "minimum": 2, "maximum": 6 },
    "abilities": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "$ref": "#/$defs/abilityEntry" } },
    "abilityModifiers": { "$ref": "#/$defs/abilityModifiers" },
    "savingThrows": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "$ref": "#/$defs/saveEntry" } },
    "savingThrowProficiencies": { "$ref": "#/$defs/abilityIds" },
    "savingThrowModifiers": { "$ref": "#/$defs/saveModifiers" },
    "skills": { "type": "array", "minItems": 18, "maxItems": 18, "items": { "$ref": "#/$defs/skillEntry" } },
    "skillProficiencies": { "$ref": "#/$defs/skillIds" },
    "skillModifiers": { "$ref": "#/$defs/skillModifiers" },
    "initiative": {
      "type": "object", "additionalProperties": false, "required": ["ability", "modifier"],
      "properties": { "ability": { "const": "dex" }, "modifier": { "$ref": "#/$defs/abilityModifier" } }
    },
    "initiativeModifier": { "type": "integer", "minimum": -5, "maximum": 10 },
    "basePassivePerceptionBreakdown": {
      "type": "object", "additionalProperties": false, "required": ["base", "skill", "modifier", "total"],
      "properties": {
        "base": { "const": 10 }, "skill": { "const": "perception" },
        "modifier": { "$ref": "#/$defs/proficientModifier" },
        "total": { "type": "integer", "minimum": 5, "maximum": 26 }
      }
    },
    "basePassivePerception": { "type": "integer", "minimum": 5, "maximum": 26 },
    "sourceId": { "const": "source.dnd2024.srd-5.2.1" },
    "sourceLocators": {
      "const": [
        "Character Creation > Step 5: Character Creation Details > Fill In Numbers",
        "Character Creation > Level Advancement > Character Advancement",
        "Playing the Game > The Six Abilities > Ability Scores/Ability Modifiers",
        "Playing the Game > Proficiency > Saving Throw Proficiencies",
        "Playing the Game > Proficiency > Skill Proficiencies and Skills",
        "Rules Glossary > Passive Perception"
      ]
    }
  },
  "$defs": {
    "abilityId": { "enum": ["str", "dex", "con", "int", "wis", "cha"] },
    "skillId": { "enum": ["acrobatics", "animal-handling", "arcana", "athletics", "deception", "history", "insight", "intimidation", "investigation", "medicine", "nature", "perception", "performance", "persuasion", "religion", "sleight-of-hand", "stealth", "survival"] },
    "abilityIds": { "type": "array", "maxItems": 6, "uniqueItems": true, "items": { "enum": ["str", "dex", "con", "int", "wis", "cha"] } },
    "skillIds": { "type": "array", "maxItems": 18, "uniqueItems": true, "items": { "enum": ["acrobatics", "animal-handling", "arcana", "athletics", "deception", "history", "insight", "intimidation", "investigation", "medicine", "nature", "perception", "performance", "persuasion", "religion", "sleight-of-hand", "stealth", "survival"] } },
    "abilityEntry": {
      "type": "object", "additionalProperties": false, "required": ["id", "score", "modifier"],
      "properties": { "id": { "$ref": "#/$defs/abilityId" }, "score": { "type": "integer", "minimum": 1, "maximum": 30 }, "modifier": { "$ref": "#/$defs/abilityModifier" } }
    },
    "saveEntry": {
      "type": "object", "additionalProperties": false, "required": ["ability", "proficient", "modifier"],
      "properties": { "ability": { "$ref": "#/$defs/abilityId" }, "proficient": { "type": "boolean" }, "modifier": { "$ref": "#/$defs/proficientModifier" } }
    },
    "skillEntry": {
      "type": "object", "additionalProperties": false, "required": ["id", "ability", "proficient", "modifier"],
      "properties": { "id": { "$ref": "#/$defs/skillId" }, "ability": { "$ref": "#/$defs/abilityId" }, "proficient": { "type": "boolean" }, "modifier": { "$ref": "#/$defs/proficientModifier" } }
    },
    "abilityModifiers": {
      "type": "object", "additionalProperties": false,
      "required": ["str", "dex", "con", "int", "wis", "cha"],
      "properties": { "str": { "$ref": "#/$defs/abilityModifier" }, "dex": { "$ref": "#/$defs/abilityModifier" }, "con": { "$ref": "#/$defs/abilityModifier" }, "int": { "$ref": "#/$defs/abilityModifier" }, "wis": { "$ref": "#/$defs/abilityModifier" }, "cha": { "$ref": "#/$defs/abilityModifier" } }
    },
    "saveModifiers": {
      "type": "object", "additionalProperties": false,
      "required": ["str", "dex", "con", "int", "wis", "cha"],
      "properties": { "str": { "$ref": "#/$defs/proficientModifier" }, "dex": { "$ref": "#/$defs/proficientModifier" }, "con": { "$ref": "#/$defs/proficientModifier" }, "int": { "$ref": "#/$defs/proficientModifier" }, "wis": { "$ref": "#/$defs/proficientModifier" }, "cha": { "$ref": "#/$defs/proficientModifier" } }
    },
    "skillModifiers": {
      "type": "object", "additionalProperties": false,
      "required": ["acrobatics", "animal-handling", "arcana", "athletics", "deception", "history", "insight", "intimidation", "investigation", "medicine", "nature", "perception", "performance", "persuasion", "religion", "sleight-of-hand", "stealth", "survival"],
      "properties": {
        "acrobatics": { "$ref": "#/$defs/proficientModifier" }, "animal-handling": { "$ref": "#/$defs/proficientModifier" }, "arcana": { "$ref": "#/$defs/proficientModifier" }, "athletics": { "$ref": "#/$defs/proficientModifier" }, "deception": { "$ref": "#/$defs/proficientModifier" }, "history": { "$ref": "#/$defs/proficientModifier" }, "insight": { "$ref": "#/$defs/proficientModifier" }, "intimidation": { "$ref": "#/$defs/proficientModifier" }, "investigation": { "$ref": "#/$defs/proficientModifier" }, "medicine": { "$ref": "#/$defs/proficientModifier" }, "nature": { "$ref": "#/$defs/proficientModifier" }, "perception": { "$ref": "#/$defs/proficientModifier" }, "performance": { "$ref": "#/$defs/proficientModifier" }, "persuasion": { "$ref": "#/$defs/proficientModifier" }, "religion": { "$ref": "#/$defs/proficientModifier" }, "sleight-of-hand": { "$ref": "#/$defs/proficientModifier" }, "stealth": { "$ref": "#/$defs/proficientModifier" }, "survival": { "$ref": "#/$defs/proficientModifier" }
      }
    },
    "abilityModifier": { "type": "integer", "minimum": -5, "maximum": 10 },
    "proficientModifier": { "type": "integer", "minimum": -5, "maximum": 16 }
  }
}
