{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "wrapperSourcePath", "wrapperResultSchemaPath", "archiveRecordPath", "archiveSourceProperty", "mutationSourcePath", "roles", "components", "sharedResultPointers", "candidateScorePointer", "scenarios", "seedChange"],
  "properties": {
    "format": { "const": "dnd-code-adoption-parity-probe/v1" },
    "wrapperSourcePath": { "type": "string", "minLength": 1, "maxLength": 500 },
    "wrapperResultSchemaPath": { "type": "string", "minLength": 1, "maxLength": 500 },
    "archiveRecordPath": { "type": "string", "minLength": 1, "maxLength": 500 },
    "archiveSourceProperty": { "type": "string", "minLength": 1, "maxLength": 100 },
    "mutationSourcePath": { "type": "string", "minLength": 1, "maxLength": 500 },
    "roles": {
      "type": "object", "additionalProperties": false, "required": ["candidate", "archive"],
      "properties": { "candidate": { "type": "string", "minLength": 1, "maxLength": 100 }, "archive": { "type": "string", "minLength": 1, "maxLength": 100 } }
    },
    "components": {
      "type": "object", "additionalProperties": false, "required": ["candidate", "archive"],
      "properties": { "candidate": { "type": "string", "minLength": 1, "maxLength": 200 }, "archive": { "type": "string", "minLength": 1, "maxLength": 200 } }
    },
    "sharedResultPointers": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
    "candidateScorePointer": { "type": "string", "minLength": 1, "maxLength": 200 },
    "scenarios": { "type": "array", "minItems": 6, "maxItems": 32, "items": { "$ref": "#/$defs/scenario" } },
    "seedChange": {
      "type": "object", "additionalProperties": false, "required": ["scenario", "alternateSeed"],
      "properties": { "scenario": { "type": "string", "minLength": 1, "maxLength": 200 }, "alternateSeed": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 } }
    }
  },
  "$defs": {
    "scores": {
      "type": "object", "additionalProperties": false,
      "required": ["str", "dex", "con", "int", "wis", "cha"],
      "properties": {
        "str": { "type": "integer", "minimum": 1, "maximum": 30 }, "dex": { "type": "integer", "minimum": 1, "maximum": 30 },
        "con": { "type": "integer", "minimum": 1, "maximum": 30 }, "int": { "type": "integer", "minimum": 1, "maximum": 30 },
        "wis": { "type": "integer", "minimum": 1, "maximum": 30 }, "cha": { "type": "integer", "minimum": 1, "maximum": 30 }
      }
    },
    "input": {
      "type": "object", "additionalProperties": false, "required": ["ability", "dc"],
      "properties": { "ability": { "enum": ["str", "dex", "con", "int", "wis", "cha"] }, "dc": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 } }
    },
    "scenario": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "scores", "input", "seed", "selectedScorePointer"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 }, "scores": { "$ref": "#/$defs/scores" },
        "input": { "$ref": "#/$defs/input" }, "seed": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "selectedScorePointer": { "type": "string", "minLength": 1, "maxLength": 20 }
      }
    }
  }
}
