{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dantesroleplay.example/schemas/adoption/projection-dependency-mapping/v1",
  "title": "Candidate projection dependency mapping",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "applicationId", "candidateKey", "projection", "roles", "inputs", "impactEvidence"],
  "properties": {
    "format": { "const": "application-adoption-projection-dependency-mapping/v1" },
    "applicationId": { "$ref": "#/$defs/identifier" },
    "candidateKey": { "$ref": "#/$defs/candidateKey" },
    "projection": { "$ref": "#/$defs/projectionReference" },
    "roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
    "inputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/input" } },
    "impactEvidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/impactEvidence" } }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "qualifiedId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}(?:\\.[a-z][a-z0-9-]{0,63})+$" },
    "candidateKey": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,159}$" },
    "hash": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "pointer": { "type": "string", "pattern": "^(?:|/(?:[^~/]|~[01])*)+$" },
    "projectionReference": {
      "type": "object", "additionalProperties": false, "required": ["qualifiedId", "version", "contentHash"],
      "properties": { "qualifiedId": { "$ref": "#/$defs/qualifiedId" }, "version": { "type": "integer", "minimum": 1 }, "contentHash": { "$ref": "#/$defs/hash" } }
    },
    "componentReference": {
      "type": "object", "additionalProperties": false, "required": ["qualifiedTypeId", "typeVersion", "schemaHash"],
      "properties": { "qualifiedTypeId": { "$ref": "#/$defs/qualifiedId" }, "typeVersion": { "type": "integer", "minimum": 1 }, "schemaHash": { "$ref": "#/$defs/hash" } }
    },
    "roleBindings": {
      "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/identifier" }
    },
    "input": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "sourcePointer", "targetPointer"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" }, "kind": { "enum": ["component", "projection"] },
        "entityRole": { "$ref": "#/$defs/identifier" }, "component": { "$ref": "#/$defs/componentReference" },
        "projection": { "$ref": "#/$defs/projectionReference" }, "roleBindings": { "$ref": "#/$defs/roleBindings" },
        "sourcePointer": { "$ref": "#/$defs/pointer" }, "targetPointer": { "$ref": "#/$defs/pointer" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "component" } } }, "then": { "required": ["entityRole", "component"], "not": { "anyOf": [ { "required": ["projection"] }, { "required": ["roleBindings"] } ] } } },
        { "if": { "properties": { "kind": { "const": "projection" } } }, "then": { "required": ["projection", "roleBindings"], "not": { "anyOf": [ { "required": ["entityRole"] }, { "required": ["component"] } ] } } }
      ]
    },
    "impactEvidence": {
      "type": "object", "additionalProperties": false, "required": ["inputId", "canonicalRoot", "dependentProjection"],
      "properties": { "inputId": { "$ref": "#/$defs/identifier" }, "canonicalRoot": { "type": "string", "maxLength": 500, "pattern": "^(?:component|projection):" }, "dependentProjection": { "$ref": "#/$defs/projectionReference" } }
    }
  }
}
