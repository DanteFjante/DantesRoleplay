{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"D&D 2024 playtest character record","type":"object","additionalProperties":false,"required":["format","state","entries"],"properties":{"format":{"const":"dnd2024-playtest-character-record-v1"},"state":{"enum":["draft","active","retired"]},"entries":{"type":"array","maxItems":200,"items":{"type":"object","additionalProperties":false,"required":["kind","key","label"],"properties":{"kind":{"enum":["class","background","subclass","spell","equipment","feature","species-trait","feat","rule-ruling","note"]},"key":{"type":"string","minLength":1,"maxLength":64,"pattern":"^[a-z][a-z0-9-]{0,63}$"},"label":{"type":"string","minLength":1,"maxLength":160},"details":{"type":"string","minLength":1,"maxLength":2000}}}}},"$comment":"Governed by procedure.character.playtest-bootstrap. This temporary record is a bounded narrative/declaration ledger only. It cannot store references, effects, rules text, component JSON, resource values, actor/campaign identity, or rule outcomes."}
