{"$schema": "https://json-schema.org/draft/2020-12/schema", "title": "D&D 2024 ability scores", "type": "object", "additionalProperties": false, "required": ["str", "dex", "con", "int", "wis", "cha"], "properties": {"str": {"type": "integer", "minimum": 1, "maximum": 30, "description": "Strength"}, "dex": {"type": "integer", "minimum": 1, "maximum": 30, "description": "Dexterity"}, "con": {"type": "integer", "minimum": 1, "maximum": 30, "description": "Constitution"}, "int": {"type": "integer", "minimum": 1, "maximum": 30, "description": "Intelligence"}, "wis": {"type": "integer", "minimum": 1, "maximum": 30, "description": "Wisdom"}, "cha": {"type": "integer", "minimum": 1, "maximum": 30, "description": "Charisma"}}, "$comment": "Modifier is floor((score - 10) / 2), derived never stored. Source: SRD 5.2.1, 'Playing the Game - Ability Scores', CC-BY-4.0, https://www.dndbeyond.com/srd"}
