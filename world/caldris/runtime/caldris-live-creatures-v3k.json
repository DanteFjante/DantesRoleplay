      "expectedRevision": 0,
      "components": [
        {
          "qualifiedTypeId": "dnd2024.game.core.world.motive",
          "expectedRevision": 0,
          "value": {
            "status": "active",
            "summary": "Dwells somewhere among Lantern Sea salt caverns and maintains a hoard of testimonies, treaty copies, jokes, trial records, and mutually contradictory memoirs. Ilyr prizes a well-told truthful failure more than gold and has impersonated at least four mediocre historians. The dragon aided the Lantern Concord in its early centuries, then withdrew when its archives became instruments of control. Several Seventh Ledger members wrongly believe Ilyr still authorizes their work.",
            "visibility": "public"
          }
        }
      ],
