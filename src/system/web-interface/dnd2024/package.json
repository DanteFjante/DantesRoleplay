{
  "name": "dantes-roleplay-dnd2024-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build:server": "vite build --config vite.server.config.ts",
    "release:manifest": "node scripts/create-release-manifest.mjs",
    "release:verify-live": "node scripts/verify-live-release.mjs",
    "typecheck": "tsc --noEmit",
    "slice19:preflight": "node scripts/campaign-simulation-preflight.mjs",
    "slice19:simulate": "node scripts/campaign-simulation.mjs",
    "test:node": "node --test \"test/*.test.js\"",
    "test:mounted": "tsx --test \"test/mounted/*.test.tsx\"",
    "test": "npm run test:node && npm run test:mounted",
    "verify": "npm run typecheck && npm run test:node && npm run test:mounted && npm run build:server"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "ajv": "^8.20.0",
    "ajv-formats": "3.0.1",
    "axe-core": "^4.13.0",
    "jsdom": "^27.2.0",
    "lucide": "^0.468.0",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
