{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "D&D 2024 class progression declaration",
  "type": "object",
  "additionalProperties": false,
  "required": ["hitDieSides", "fixedHitPointGainBeforeConstitution", "levels", "sourceRef"],
  "properties": {
    "hitDieSides": { "type": "integer", "enum": [6, 8, 10, 12] },
    "fixedHitPointGainBeforeConstitution": { "type": "integer", "minimum": 1, "maximum": 12 },
    "levels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["classLevel", "featureDefinitionIds", "choiceSetDefinitionIds"],
        "properties": {
          "classLevel": { "type": "integer", "minimum": 1, "maximum": 20 },
          "featureDefinitionIds": { "type": "array", "maxItems": 32, "items": { "type": "string", "pattern": "^content\\.dnd2024\\.feature\\.[a-z0-9.-]+\\.v[1-9][0-9]*$" } },
          "choiceSetDefinitionIds": { "type": "array", "maxItems": 32, "items": { "type": "string", "pattern": "^content\\.dnd2024\\.choice-set\\.[a-z0-9.-]+\\.v[1-9][0-9]*$" } }
        }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "locator"],
      "properties": {
        "sourceId": { "type": "string", "const": "source.dnd2024.srd-5.2.1" },
        "locator": { "type": "string", "minLength": 4, "maxLength": 200, "pattern": "^.{1,198}PDF page(?:s)? [0-9]+(?:[–-][0-9]+)?$" }
      }
    }
  },
  "$comment": "Governed by procedure.mechanic.dnd2024.class-progression. Levels and child IDs are canonically ordered by the governing reader; actor state and all feature behavior remain separate owners."
}
