{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "D&D 2024 immutable item definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["definitionVersion", "kind", "stackPolicy", "massPounds", "sourceRef"],
  "properties": {
    "definitionVersion": { "const": 1 },
    "kind": { "enum": ["adventuring-gear", "ammunition", "weapon", "armor", "shield", "currency"] },
    "stackPolicy": { "enum": ["separate", "fungible"] },
    "massPounds": { "$ref": "#/$defs/rational" },
    "lengthFeet": { "$ref": "#/$defs/rational" },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "weightPounds": { "$ref": "#/$defs/rational" },
        "volumeCubicFeet": { "$ref": "#/$defs/rational" },
        "itemCount": { "type": "integer", "minimum": 1 },
        "permittedItemKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["ammunition"] }
        }
      }
    },
    "currency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["denomination", "copperValue", "coinsPerPound"],
      "properties": {
        "denomination": { "enum": ["cp", "sp", "ep", "gp", "pp"] },
        "copperValue": { "type": "integer", "minimum": 1 },
        "coinsPerPound": { "const": 50 }
      }
    },
    "weaponProfileId": { "type": "string", "pattern": "^weapon\\.dnd2024\\.[a-z0-9-]+$" },
    "armorProfile": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["category", "baseArmorClass", "dexterityRule", "stealthDisadvantage", "donDoff"],
          "properties": {
            "category": { "const": "light" },
            "baseArmorClass": { "enum": [11, 12] },
            "dexterityRule": { "const": "full" },
            "stealthDisadvantage": { "type": "boolean" },
            "donDoff": { "type": "object", "additionalProperties": false, "required": ["donMinutes", "doffMinutes"], "properties": { "donMinutes": { "const": 1 }, "doffMinutes": { "const": 1 } } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["category", "baseArmorClass", "dexterityRule", "stealthDisadvantage", "donDoff"],
          "properties": {
            "category": { "const": "medium" },
            "baseArmorClass": { "enum": [12, 13, 14, 15] },
            "dexterityRule": { "const": "max-2" },
            "stealthDisadvantage": { "type": "boolean" },
            "donDoff": { "type": "object", "additionalProperties": false, "required": ["donMinutes", "doffMinutes"], "properties": { "donMinutes": { "const": 5 }, "doffMinutes": { "const": 1 } } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["category", "baseArmorClass", "dexterityRule", "stealthDisadvantage", "donDoff"],
          "properties": {
            "category": { "const": "heavy" },
            "baseArmorClass": { "enum": [14, 16, 17, 18] },
            "dexterityRule": { "const": "none" },
            "strengthMinimum": { "enum": [13, 15] },
            "stealthDisadvantage": { "type": "boolean" },
            "donDoff": { "type": "object", "additionalProperties": false, "required": ["donMinutes", "doffMinutes"], "properties": { "donMinutes": { "const": 10 }, "doffMinutes": { "const": 5 } } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["category", "armorClassBonus", "donDoff"],
          "properties": {
            "category": { "const": "shield" },
            "armorClassBonus": { "const": 2 },
            "donDoff": { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "utilize-action" } } }
          }
        }
      ]
    },
    "equipmentModes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["held", "worn"] },
      "description": "The closed equipment states this immutable definition may enter. This is eligibility only; it creates no slot, custody, combat, armor, or timing rule."
    },
    "sourceRef": { "$ref": "#/$defs/sourceRef" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "weapon" } }, "required": ["kind"] },
      "then": { "required": ["weaponProfileId"] },
      "else": { "not": { "required": ["weaponProfileId"] } }
    },
    {
      "if": { "properties": { "kind": { "const": "currency" } }, "required": ["kind"] },
      "then": { "required": ["currency"], "properties": { "stackPolicy": { "const": "fungible" } } },
      "else": { "not": { "required": ["currency"] } }
    },
    {
      "if": { "properties": { "kind": { "const": "armor" } }, "required": ["kind"] },
      "then": { "required": ["armorProfile", "equipmentModes"], "properties": { "stackPolicy": { "const": "separate" }, "equipmentModes": { "const": ["worn"] }, "armorProfile": { "properties": { "category": { "enum": ["light", "medium", "heavy"] } }, "required": ["category"] } } }
    },
    {
      "if": { "properties": { "kind": { "const": "shield" } }, "required": ["kind"] },
      "then": { "required": ["armorProfile", "equipmentModes"], "properties": { "stackPolicy": { "const": "separate" }, "equipmentModes": { "const": ["held"] }, "armorProfile": { "properties": { "category": { "const": "shield" } }, "required": ["category"] } } }
    },
    {
      "if": { "properties": { "kind": { "not": { "enum": ["armor", "shield"] } } }, "required": ["kind"] },
      "then": { "not": { "required": ["armorProfile"] } }
    }
  ],
  "$defs": {
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": { "type": "integer", "minimum": 0 },
        "denominator": { "type": "integer", "minimum": 1 }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "locator"],
      "properties": {
        "sourceId": { "const": "source.dnd2024.srd-5.2.1" },
        "locator": { "type": "string", "pattern": "^Equipment > ", "minLength": 12, "maxLength": 160 }
      }
    }
  },
  "$comment": "The containing entity id is the durable, versioned definition identity. Item instances retain that exact id; static facts are not copied to campaign entities."
}
