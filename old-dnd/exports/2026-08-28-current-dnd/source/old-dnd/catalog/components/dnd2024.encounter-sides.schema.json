{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "D&D 2024 encounter sides",
  "type": "object",
  "additionalProperties": false,
  "required": ["assignments", "hostilePairs", "sourceRef"],
  "properties": {
    "assignments": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["participantId", "sideId"],
        "properties": {
          "participantId": {"type": "string", "minLength": 1, "maxLength": 200},
          "sideId": {"type": "string", "pattern": "^side\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$", "minLength": 6, "maxLength": 100}
        }
      }
    },
    "hostilePairs": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["firstSideId", "secondSideId"],
        "properties": {
          "firstSideId": {"type": "string", "pattern": "^side\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$", "minLength": 6, "maxLength": 100},
          "secondSideId": {"type": "string", "pattern": "^side\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$", "minLength": 6, "maxLength": 100}
        }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "locator"],
      "properties": {
        "sourceId": {"const": "source.dnd2024.srd-5.2.1"},
        "locator": {"const": "Playing the Game > Movement and Position > Moving around Other Creatures; Making an Attack > Ranged Attacks in Close Combat"}
      }
    }
  },
  "$comment": "The writer enforces exact direct-roster coverage, canonical ordering, side existence, and unique ordered hostility pairs."
}
