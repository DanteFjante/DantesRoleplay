{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "D&D 2024 immutable item activities",
  "type": "object",
  "additionalProperties": false,
  "required": ["activities"],
  "properties": {
    "activities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "consumeQuantity", "grant"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "kind": { "const": "consume-and-grant-item" },
          "consumeQuantity": { "type": "integer", "minimum": 1, "maximum": 999999 },
          "grant": {
            "type": "object",
            "additionalProperties": false,
            "required": ["definitionId", "name", "slot"],
            "properties": {
              "definitionId": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*\\.v[1-9][0-9]*$", "maxLength": 200 },
              "name": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": ".*\\S.*" },
              "slot": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z][a-z0-9-]*$" }
            }
          }
        }
      }
    }
  },
  "$comment": "Activity data is immutable definition data. It is intentionally a closed descriptor, not a generic effect list or authored script."
}
