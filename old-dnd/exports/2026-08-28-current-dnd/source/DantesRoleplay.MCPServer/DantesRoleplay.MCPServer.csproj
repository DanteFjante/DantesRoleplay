<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64;osx-arm64;linux-x64;linux-arm64;linux-musl-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>82960eed-70c3-4c5e-90ee-d1c114a4acff</UserSecretsId>

    <!-- Set up the MCP server to be a self-contained application that does not rely on a shared framework -->
    <SelfContained>true</SelfContained>
    <PublishSelfContained>true</PublishSelfContained>

    <!-- Set up the MCP server to be a single file executable -->
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Retained compatibility sources for the former game host. They are deliberately not
         compiled by the generic server until an application adapter owns their dependencies. -->
    <Compile Remove="DevelopmentKnowledgeAudience.cs" />
    <Compile Remove="KnowledgeBackgroundWorker.cs" />
    <Compile Remove="StoryPlanWorker.cs" />
    <Compile Remove="Tools\CampaignTools.cs" />
    <Compile Remove="Tools\CommitTool.cs" />
    <Compile Remove="Tools\ItineraryAdvanceTools.cs" />
    <Compile Remove="Tools\JourneyPlanTools.cs" />
    <Compile Remove="Tools\KnowledgeTools.cs" />
    <Compile Remove="Tools\ModeAwareItineraryTools.cs" />
    <Compile Remove="Tools\QuestTools.cs" />
    <Compile Remove="Tools\StoryPlanTools.cs" />
    <Compile Remove="Tools\VerbSurface.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DantesRoleplay.DataAccess\DantesRoleplay.DataAccess.csproj" />
    <ProjectReference Include="..\src\system\local-ai\DantesRoleplay.LocalAI\DantesRoleplay.LocalAI.csproj" />
    <ProjectReference Include="..\src\system\web-interface\DantesRoleplay.Web\DantesRoleplay.Web.csproj" />

    <!-- The JavaScript sandbox. The only dependency in the solution that executes code it did
         not write, which is why it is referenced explicitly by the host rather than arriving
         transitively with something else. -->
    <ProjectReference Include="..\DantesRoleplay.RuleAccess\DantesRoleplay.RuleAccess.csproj" />
  </ItemGroup>

</Project>
