{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["damageResponses"],
  "properties": {
    "armorClass": {
      "oneOf": [
        { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mechanicId", "inputBindings"],
          "properties": {
            "mechanicId": { "type": "string", "minLength": 1, "maxLength": 200 },
            "inputBindings": { "type": "object", "maxProperties": 12 }
          }
        }
      ]
    },
    "damageResponses": { "type": "array", "maxItems": 128 }
  }
}
