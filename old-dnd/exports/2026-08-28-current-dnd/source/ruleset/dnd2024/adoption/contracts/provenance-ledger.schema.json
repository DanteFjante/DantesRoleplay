{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dantesroleplay:development:dnd-code-adoption:provenance-ledger:v1",
  "title": "D&D code-adoption provenance ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "lockSha256", "entries"],
  "properties": {
    "format": { "const": "dnd-code-adoption-provenance-ledger/v1" },
    "lockSha256": { "$ref": "#/$defs/hash" },
    "entries": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)[.][.](?:/|$))[^\\\\]+$"
    },
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "evidence"],
      "properties": {
        "state": { "enum": ["not-reviewed", "approved", "rejected", "not-applicable"] },
        "evidence": {
          "type": ["string", "null"],
          "maxLength": 500
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "result", "evidenceSha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "result": { "enum": ["passed", "failed", "not-run"] },
        "evidenceSha256": {
          "oneOf": [
            { "$ref": "#/$defs/hash" },
            { "type": "null" }
          ]
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateKey",
        "target",
        "source",
        "license",
        "ruleset",
        "ownership",
        "transformation",
        "dependencies",
        "validation",
        "status"
      ],
      "properties": {
        "candidateKey": { "$ref": "#/$defs/key" },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path", "symbol", "sha256"],
          "properties": {
            "kind": {
              "enum": ["catalog-javascript", "content-data", "json-schema", "test-vector", "documentation", "development-tool"]
            },
            "path": { "$ref": "#/$defs/relativePath" },
            "symbol": {
              "type": ["string", "null"],
              "maxLength": 300
            },
            "sha256": {
              "oneOf": [
                { "$ref": "#/$defs/hash" },
                { "type": "null" }
              ]
            }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceKey", "repository", "commit", "path", "symbol", "sha256"],
          "properties": {
            "sourceKey": {
              "enum": ["current-catalog", "old-dnd", "dnd-srd-engine", "foundry-dnd5e", "native-srd-implementation"]
            },
            "repository": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "commit": { "$ref": "#/$defs/commit" },
            "path": { "$ref": "#/$defs/relativePath" },
            "symbol": {
              "type": ["string", "null"],
              "maxLength": 300
            },
            "sha256": { "$ref": "#/$defs/hash" }
          }
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "classification",
            "disposition",
            "noticeFiles",
            "copyrightNoticePreserved",
            "attribution",
            "changesIndicated"
          ],
          "properties": {
            "classification": {
              "enum": ["first-party", "MIT", "CC-BY-4.0", "asset", "mixed", "unknown", "non-srd", "premium"]
            },
            "disposition": {
              "enum": [
                "first-party-recovery",
                "approved-mit-software",
                "approved-cc-by-srd-content",
                "reference-only",
                "blocked-asset",
                "blocked-mixed-or-unknown",
                "blocked-non-srd-or-premium",
                "rejected"
              ]
            },
            "noticeFiles": {
              "type": "array",
              "maxItems": 20,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/relativePath" }
            },
            "copyrightNoticePreserved": { "type": "boolean" },
            "attribution": {
              "type": ["string", "null"],
              "maxLength": 3000
            },
            "changesIndicated": { "type": "boolean" }
          }
        },
        "ruleset": {
          "type": "object",
          "additionalProperties": false,
          "required": ["alignment", "edition", "sourceId", "locator", "officialVerified"],
          "properties": {
            "alignment": { "enum": ["dnd2024-owned", "dnd2024-compatible", "ruleset-neutral"] },
            "edition": { "enum": ["2024", "2014", "not-applicable"] },
            "sourceId": {
              "type": ["string", "null"],
              "maxLength": 200
            },
            "locator": {
              "type": ["string", "null"],
              "maxLength": 1000
            },
            "officialVerified": { "type": "boolean" }
          }
        },
        "ownership": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existingOwner", "ownerEvidence", "conflicts"],
          "properties": {
            "existingOwner": {
              "type": ["string", "null"],
              "maxLength": 300
            },
            "ownerEvidence": {
              "type": "array",
              "maxItems": 50,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/relativePath" }
            },
            "conflicts": {
              "type": "array",
              "maxItems": 50,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/boundedText" }
            }
          }
        },
        "transformation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "description", "tool", "mappingSha256"],
          "properties": {
            "kind": { "enum": ["unchanged", "adapted", "generated", "test-vector", "reference-only", "rejected"] },
            "description": { "$ref": "#/$defs/boundedText" },
            "tool": {
              "type": ["string", "null"],
              "maxLength": 300
            },
            "mappingSha256": {
              "oneOf": [
                { "$ref": "#/$defs/hash" },
                { "type": "null" }
              ]
            }
          }
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": false,
          "required": ["components", "projections", "mechanics"],
          "properties": {
            "components": {
              "type": "array",
              "maxItems": 100,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/key" }
            },
            "projections": {
              "type": "array",
              "maxItems": 100,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/key" }
            },
            "mechanics": {
              "type": "array",
              "maxItems": 100,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/key" }
            }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tests", "semanticReview", "licenseReview", "foundryIndependenceReview", "acceptedBy"],
          "properties": {
            "tests": {
              "type": "array",
              "maxItems": 200,
              "items": { "$ref": "#/$defs/test" }
            },
            "semanticReview": { "$ref": "#/$defs/review" },
            "licenseReview": { "$ref": "#/$defs/review" },
            "foundryIndependenceReview": { "$ref": "#/$defs/review" },
            "acceptedBy": {
              "type": ["string", "null"],
              "maxLength": 500
            }
          }
        },
        "status": { "enum": ["candidate", "blocked", "reviewed", "accepted", "rejected"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "ruleset": { "properties": { "alignment": { "const": "dnd2024-owned" } } } }
          },
          "then": {
            "properties": {
              "ruleset": {
                "properties": {
                  "edition": { "const": "2024" },
                  "sourceId": { "const": "source.dnd2024.srd-5.2.1" },
                  "locator": { "type": "string", "minLength": 5 },
                  "officialVerified": { "const": true }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "license": { "properties": { "classification": { "const": "CC-BY-4.0" } } } }
          },
          "then": {
            "properties": {
              "target": { "properties": { "kind": { "const": "content-data" } } },
              "license": {
                "properties": {
                  "disposition": { "const": "approved-cc-by-srd-content" },
                  "attribution": { "type": "string", "minLength": 20 },
                  "changesIndicated": { "const": true }
                }
              },
              "ruleset": {
                "properties": {
                  "alignment": { "const": "dnd2024-owned" },
                  "edition": { "const": "2024" },
                  "sourceId": { "const": "source.dnd2024.srd-5.2.1" },
                  "locator": { "type": "string", "minLength": 5 },
                  "officialVerified": { "const": true }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "license": { "properties": { "classification": { "const": "MIT" } } } }
          },
          "then": {
            "properties": {
              "license": {
                "properties": {
                  "disposition": { "enum": ["approved-mit-software", "reference-only", "rejected"] },
                  "noticeFiles": { "minItems": 1 },
                  "copyrightNoticePreserved": { "const": true }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "license": { "properties": { "classification": { "const": "first-party" } } } }
          },
          "then": {
            "properties": {
              "license": {
                "properties": {
                  "disposition": { "enum": ["first-party-recovery", "reference-only", "rejected"] }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "license": { "properties": { "disposition": { "const": "reference-only" } } } }
          },
          "then": {
            "properties": {
              "status": { "enum": ["candidate", "blocked", "reviewed", "rejected"] },
              "transformation": { "properties": { "kind": { "const": "reference-only" } } }
            }
          }
        },
        {
          "if": {
            "properties": {
              "license": {
                "properties": {
                  "classification": { "enum": ["asset", "mixed", "unknown", "non-srd", "premium"] }
                }
              }
            }
          },
          "then": {
            "properties": {
              "status": { "enum": ["blocked", "rejected"] },
              "license": {
                "properties": {
                  "disposition": {
                    "enum": ["blocked-asset", "blocked-mixed-or-unknown", "blocked-non-srd-or-premium", "rejected"]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "source": { "properties": { "sourceKey": { "const": "foundry-dnd5e" } } } }
          },
          "then": {
            "if": {
              "properties": { "status": { "const": "accepted" } }
            },
            "then": {
              "properties": {
                "license": { "properties": { "disposition": { "const": "approved-mit-software" } } },
                "validation": {
                  "properties": {
                    "foundryIndependenceReview": { "properties": { "state": { "const": "approved" } } }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "license": {
                  "properties": {
                    "disposition": { "enum": ["reference-only", "approved-mit-software", "blocked-asset", "blocked-mixed-or-unknown", "rejected"] }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "accepted" } } },
          "then": {
            "properties": {
              "target": { "properties": { "sha256": { "$ref": "#/$defs/hash" } } },
              "ownership": { "properties": { "conflicts": { "maxItems": 0 } } },
              "validation": {
                "properties": {
                  "tests": {
                    "minItems": 1,
                    "items": {
                      "properties": {
                        "result": { "const": "passed" },
                        "evidenceSha256": { "$ref": "#/$defs/hash" }
                      }
                    }
                  },
                  "semanticReview": { "properties": { "state": { "const": "approved" } } },
                  "licenseReview": { "properties": { "state": { "const": "approved" } } },
                  "acceptedBy": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      ]
    }
  }
}
