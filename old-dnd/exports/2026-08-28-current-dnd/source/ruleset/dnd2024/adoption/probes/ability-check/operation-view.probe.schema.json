{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "fixture", "projections", "materialization", "expected"],
  "properties": {
    "format": { "const": "dnd-code-adoption-operation-view-probe/v1" },
    "fixture": { "$ref": "#/$defs/fixture" },
    "projections": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/projection" }
    },
    "materialization": { "$ref": "#/$defs/materialization" },
    "expected": { "$ref": "#/$defs/expected" }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 200 },
    "shortIdentifier": { "type": "string", "minLength": 1, "maxLength": 200 },
    "pointer": { "type": "string", "maxLength": 1000 },
    "roleBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject"],
      "properties": { "subject": { "const": "subject" } }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "qualifiedTypeId", "schema", "data"],
      "properties": {
        "id": { "$ref": "#/$defs/shortIdentifier" },
        "qualifiedTypeId": { "$ref": "#/$defs/identifier" },
        "schema": { "type": "object" },
        "data": { "type": "object" }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicationId", "applicationName", "stateSpaceId", "subject", "components"],
      "properties": {
        "applicationId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "applicationName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "stateSpaceId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 200 },
            "name": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        },
        "components": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/component" } }
      }
    },
    "componentInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputId", "entityRole", "componentId"],
      "properties": {
        "inputId": { "$ref": "#/$defs/shortIdentifier" },
        "entityRole": { "const": "subject" },
        "componentId": { "$ref": "#/$defs/shortIdentifier" }
      }
    },
    "dependencyInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputId", "projectionId", "roleBindings"],
      "properties": {
        "inputId": { "$ref": "#/$defs/shortIdentifier" },
        "projectionId": { "$ref": "#/$defs/identifier" },
        "roleBindings": { "$ref": "#/$defs/roleBindings" }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputId", "sourcePointer", "targetPointer"],
      "properties": {
        "inputId": { "$ref": "#/$defs/shortIdentifier" },
        "sourcePointer": { "$ref": "#/$defs/pointer" },
        "targetPointer": { "$ref": "#/$defs/pointer" }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "outputSchema", "componentInputs", "dependencyInputs", "mappings"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "outputSchema": { "type": "object" },
        "componentInputs": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/componentInput" } },
        "dependencyInputs": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/dependencyInput" } },
        "mappings": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/mapping" } }
      }
    },
    "materialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectionId", "roleEntityIds"],
      "properties": {
        "projectionId": { "$ref": "#/$defs/identifier" },
        "roleEntityIds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subject"],
          "properties": { "subject": { "type": "string", "minLength": 1, "maxLength": 200 } }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output", "sourceRevision", "componentImpact"],
      "properties": {
        "output": { "type": "object" },
        "sourceRevision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "componentImpact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["componentId", "pointer", "dependentProjectionIds"],
          "properties": {
            "componentId": { "$ref": "#/$defs/shortIdentifier" },
            "pointer": { "$ref": "#/$defs/pointer" },
            "dependentProjectionIds": { "type": "array", "minItems": 2, "maxItems": 16, "items": { "$ref": "#/$defs/identifier" } }
          }
        }
      }
    }
  }
}
