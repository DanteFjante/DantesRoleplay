{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dantesroleplay.example/schemas/adoption/conformance-scenario/v1",
  "title": "Portable conformance scenario suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "suite", "cases"],
  "properties": {
    "format": { "const": "application-adoption-conformance-scenarios/v1" },
    "suite": { "$ref": "#/$defs/suite" },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "pointer": { "type": "string", "pattern": "^(?:/(?:[^~/]|~[01])*)+$" },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "identity"],
      "properties": {
        "kind": { "enum": ["archive", "donor", "adapted", "native", "fixture"] },
        "identity": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
      }
    },
    "suite": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "subject", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "subject": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "context", "input", "seed", "compare"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "context": { "type": "object" },
        "input": { "type": "object" },
        "seed": { "type": ["integer", "string", "null"] },
        "compare": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "pointer"],
            "properties": { "name": { "$ref": "#/$defs/identifier" }, "pointer": { "$ref": "#/$defs/pointer" } }
          }
        }
      }
    }
  }
}
