{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "tags"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,159}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "tags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } }
  }
}
