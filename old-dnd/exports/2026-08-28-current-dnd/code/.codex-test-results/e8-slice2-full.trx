          CONSTRAINT "CK_snapshot_package_encoding" CHECK ("ContentEncoding" = 'dantes-canonical-json-v1'),&#xD;
          CONSTRAINT "CK_snapshot_package_id" CHECK (length("Id") = 41 AND substr("Id", 1, 9) = 'snapshot.' AND substr("Id", 10) NOT GLOB '*[^0-9a-f]*'),&#xD;
          CONSTRAINT "CK_snapshot_package_producer_version" CHECK ("ProducerVersion" &gt; 0),&#xD;
          CONSTRAINT "CK_snapshot_package_root_operation" CHECK (length("RootOperationId") = 32 AND "RootOperationId" NOT GLOB '*[^0-9a-f]*'),&#xD;
          CONSTRAINT "CK_snapshot_package_scope_version" CHECK ("ScopeContractVersion" &gt; 0)&#xD;
      );&#xD;
