          CONSTRAINT "CK_system_feedback_retention_action_reference" CHECK (("Action" IN ('PlaceHold', 'ReleaseHold') AND "Reference" IS NOT NULL AND length("Reference") BETWEEN 1 AND 100) OR ("Action" IN ('Archive', 'Restore') AND "Reference" IS NULL)),&#xD;
          CONSTRAINT "CK_system_feedback_retention_action_revision" CHECK ("Revision" &gt; 0),&#xD;
          CONSTRAINT "CK_system_feedback_retention_action_to_hold" CHECK ("ToHoldState" IN ('None', 'Held')),&#xD;
          CONSTRAINT "FK_system_feedback_retention_action_system_feedback_report_ReportId" FOREIGN KEY ("ReportId") REFERENCES "system_feedback_report" ("Id") ON DELETE CASCADE&#xD;
      );&#xD;
