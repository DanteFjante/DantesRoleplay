          CONSTRAINT "CK_snapshot_package_availability" CHECK ("Availability" = 'available'),&#xD;
          CONSTRAINT "CK_snapshot_package_boundary_fingerprint" CHECK (length("BoundaryFingerprint") = 64 AND "BoundaryFingerprint" NOT GLOB '*[^0-9a-f]*'),&#xD;
          CONSTRAINT "CK_snapshot_package_byte_count" CHECK ("ByteCount" BETWEEN 1 AND 1048576 AND "ByteCount" = length("Content")),&#xD;
