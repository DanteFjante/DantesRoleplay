      SELECT "s1"."Id", "s1"."CampaignId", "s1"."CancelRequested", "s1"."CompletedStepCount", "s1"."CreatedAtUtc", "s1"."HandoffJson", "s1"."LeaseOwner", "s1"."LeaseUntilUtc", "s1"."NextStepIndex", "s1"."Objective", "s1"."PlanJson", "s1"."PolicyRevision", "s1"."PrincipalId", "s1"."RequestToken", "s1"."Revision", "s1"."Status", "s1"."StopCode", "s1"."StopMessage", "s1"."UpdatedAtUtc", "s0"."StoryPlanId", "s0"."StepIndex", "s0"."ActionOperationId", "s0"."CompletedAtUtc", "s0"."ErrorCode", "s0"."ErrorMessage", "s0"."InputJson", "s0"."Intent", "s0"."Kind", "s0"."MechanicId", "s0"."MechanicVersion", "s0"."ProcedureEvidenceJson", "s0"."ResultJson", "s0"."RoleEntityIdsJson", "s0"."StartedAtUtc", "s0"."Status", "s0"."StepId"&#xD;
      FROM (&#xD;
          SELECT "s"."Id", "s"."CampaignId", "s"."CancelRequested", "s"."CompletedStepCount", "s"."CreatedAtUtc", "s"."HandoffJson", "s"."LeaseOwner", "s"."LeaseUntilUtc", "s"."NextStepIndex", "s"."Objective", "s"."PlanJson", "s"."PolicyRevision", "s"."PrincipalId", "s"."RequestToken", "s"."Revision", "s"."Status", "s"."StopCode", "s"."StopMessage", "s"."UpdatedAtUtc"&#xD;
          FROM "story_plan_run" AS "s"&#xD;
          WHERE "s"."Status" NOT IN ('completed', 'blocked', 'failed', 'cancelled') AND ("s"."Status" = 'pending' OR "s"."LeaseUntilUtc" IS NULL OR "s"."LeaseUntilUtc" &lt; @nowUtc)&#xD;
          ORDER BY "s"."UpdatedAtUtc", "s"."Id"&#xD;
          LIMIT 1&#xD;
      ) AS "s1"&#xD;
      LEFT JOIN "story_plan_step_run" AS "s0" ON "s1"."Id" = "s0"."StoryPlanId"&#xD;
      ORDER BY "s1"."UpdatedAtUtc", "s1"."Id", "s0"."StoryPlanId"&#xD;
