      CREATE TABLE "snapshot_package" (&#xD;
          "Id" TEXT NOT NULL CONSTRAINT "PK_snapshot_package" PRIMARY KEY,&#xD;
          "ScopeContractId" TEXT NOT NULL,&#xD;
          "ScopeContractVersion" INTEGER NOT NULL,&#xD;
          "ProducerId" TEXT NOT NULL,&#xD;
