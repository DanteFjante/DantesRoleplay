{
  "format": "dnd-code-adoption-negative-cases/v1",
  "base": "provenance-ledger.valid.example.json",
  "schema": "provenance-ledger.schema.json",
  "cases": [
    {
      "name": "prohibited asset cannot retain reference-only disposition",
      "mutations": [
        { "pointer": "/entries/0/license/classification", "value": "asset" }
      ]
    },
    {
      "name": "CC BY content requires exact SRD locator and content target",
      "mutations": [
        { "pointer": "/entries/0/license/classification", "value": "CC-BY-4.0" },
        { "pointer": "/entries/0/license/disposition", "value": "approved-cc-by-srd-content" }
      ]
    },
    {
      "name": "unknown license cannot be reviewed as reusable",
      "mutations": [
        { "pointer": "/entries/0/license/classification", "value": "unknown" }
      ]
    },
    {
      "name": "accepted candidate cannot retain conflict or missing target hash",
      "mutations": [
        { "pointer": "/entries/0/status", "value": "accepted" },
        { "pointer": "/entries/0/ownership/conflicts", "value": ["Example unresolved owner conflict."] }
      ]
    },
    {
      "name": "Foundry reference-only candidate cannot be accepted",
      "mutations": [
        { "pointer": "/entries/0/source/sourceKey", "value": "foundry-dnd5e" },
        { "pointer": "/entries/0/status", "value": "accepted" }
      ]
    }
  ]
}
