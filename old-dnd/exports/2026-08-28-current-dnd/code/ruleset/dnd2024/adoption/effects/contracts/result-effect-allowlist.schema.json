{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dantesroleplay.example/schemas/adoption/result-effect-allowlist/v1",
  "title": "Candidate result effect allowlist",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "applicationId", "candidateKey", "projectionMapping", "roles", "result", "allowlist"],
  "properties": {
    "format": { "const": "application-adoption-result-effect-allowlist/v1" },
    "applicationId": { "$ref": "#/$defs/identifier" },
    "candidateKey": { "$ref": "#/$defs/candidateKey" },
    "projectionMapping": { "$ref": "#/$defs/candidateReference" },
    "roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
    "result": { "$ref": "#/$defs/result" },
    "allowlist": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/template" } }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "candidateKey": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,159}$" },
    "qualifiedId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}(?:\\.[a-z][a-z0-9-]{0,63})+$" },
    "hash": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "pointer": { "type": "string", "pattern": "^(?:|/(?:[^~/]|~[01])*)+$" },
    "candidateReference": { "type": "object", "additionalProperties": false, "required": ["candidateKey", "manifestPath", "sha256"], "properties": { "candidateKey": { "$ref": "#/$defs/candidateKey" }, "manifestPath": { "$ref": "#/$defs/relativePath" }, "sha256": { "$ref": "#/$defs/hash" } } },
    "componentReference": { "type": "object", "additionalProperties": false, "required": ["qualifiedTypeId", "typeVersion", "schemaHash"], "properties": { "qualifiedTypeId": { "$ref": "#/$defs/qualifiedId" }, "typeVersion": { "type": "integer", "minimum": 1 }, "schemaHash": { "$ref": "#/$defs/hash" } } },
    "relativePath": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)[.][.](?:/|$))[A-Za-z0-9._/-]+$" },
    "result": { "type": "object", "additionalProperties": false, "required": ["schemaPath", "schemaHash", "proposalsPointer"], "properties": { "schemaPath": { "$ref": "#/$defs/relativePath" }, "schemaHash": { "$ref": "#/$defs/hash" }, "proposalsPointer": { "$ref": "#/$defs/pointer" } } },
    "template": {
      "type": "object", "additionalProperties": false, "required": ["proposalKind", "effectType"],
      "properties": {
        "proposalKind": { "$ref": "#/$defs/identifier" },
        "effectType": { "enum": ["entity.create", "entity.delete", "component.add", "component.set", "component.merge", "component.remove", "containment.move", "relationship.create", "relationship.remove"] },
        "entityRole": { "$ref": "#/$defs/identifier" }, "targetRole": { "$ref": "#/$defs/identifier" },
        "component": { "$ref": "#/$defs/componentReference" }, "relationshipKind": { "$ref": "#/$defs/qualifiedId" },
        "dataPointer": { "$ref": "#/$defs/pointer" }, "entityIdPointer": { "$ref": "#/$defs/pointer" },
        "namePointer": { "$ref": "#/$defs/pointer" }, "slotPointer": { "$ref": "#/$defs/pointer" }
      }
    }
  }
}
