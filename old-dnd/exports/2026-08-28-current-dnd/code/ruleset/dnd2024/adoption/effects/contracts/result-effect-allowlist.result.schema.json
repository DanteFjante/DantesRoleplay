{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dantesroleplay.example/schemas/adoption/result-effect-allowlist-fixture-result/v1",
  "title": "Neutral candidate result fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposals"],
  "properties": {
    "proposals": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "state"],
        "properties": {
          "kind": { "const": "set-subject-state" },
          "state": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value"],
            "properties": { "value": { "type": "integer" } }
          }
        }
      }
    }
  }
}
