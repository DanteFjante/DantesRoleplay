{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["contentKey", "contentVersion", "sourceRef", "eligibleAbilities", "allowedPatterns"],
  "properties": {
    "contentKey": { "type": "string", "minLength": 1, "maxLength": 80 },
    "contentVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "locator"],
      "properties": {
        "sourceId": { "const": "source.dnd2024.srd-5.2.1" },
        "locator": { "type": "string", "minLength": 4, "maxLength": 200 }
      }
    },
    "eligibleAbilities": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["str", "dex", "con", "int", "wis", "cha"] }
    },
    "allowedPatterns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["plus-2-plus-1", "plus-1-each"] }
    }
  }
}
