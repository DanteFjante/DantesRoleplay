{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "roleId", "status", "healthPoints", "conditionIds"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "roleId": { "type": "string", "minLength": 1, "maxLength": 100 },
    "status": { "enum": ["active", "incapacitated", "dead", "departed"] },
    "healthPoints": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "conditionIds": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 100 }
    }
  }
}
