{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenarioId", "scenarioVersion", "scenarioContentHash", "rulesProfileId"],
  "properties": {
    "scenarioId": { "type": "string", "minLength": 1, "maxLength": 100 },
    "scenarioVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "scenarioContentHash": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "rulesProfileId": { "type": "string", "minLength": 1, "maxLength": 100 }
  }
}
