{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "choiceIds", "openedTurn"],
  "properties": {
    "eventId": { "type": "string", "minLength": 1, "maxLength": 100 },
    "choiceIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 100 }
    },
    "openedTurn": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
  }
}
