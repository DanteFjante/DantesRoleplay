<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DantesRoleplay.Tools</RootNamespace>
    <AssemblyName>roleplay</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!--
      DataAccess only, and deliberately NOT RuleAccess. Nothing in here executes a mechanic, so the
      Jint sandbox has no business being in a developer tool's dependency graph — the one component
      in this solution that runs code it did not write should be reachable from exactly the places
      that need it.

      No PackageReference of its own either. Everything these tools need arrives transitively with
      DataAccess, which is the check that a tool has not quietly grown into a second application.
    -->
    <ProjectReference Include="..\DantesRoleplay.DataAccess\DantesRoleplay.DataAccess.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\src\system\catalog-tools\tooling\**\*.cs">
      <Link>Components\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

</Project>
