{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dantesroleplay:dnd2024:prototype:value:dice-expression",
  "title": "Dice expression",
  "type": "object",
  "additionalProperties": false,
  "required": ["count", "dieRef", "modifier"],
  "properties": {
    "count": { "type": "integer", "minimum": 1, "maximum": 100 },
    "dieRef": { "$ref": "urn:dantesroleplay:dnd2024:prototype:value:entity-reference" },
    "modifier": { "type": "integer", "minimum": -1000, "maximum": 1000 }
  }
}
