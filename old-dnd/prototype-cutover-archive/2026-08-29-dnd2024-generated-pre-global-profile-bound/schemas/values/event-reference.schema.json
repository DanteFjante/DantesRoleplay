{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dantesroleplay:dnd2024:prototype:value:event-reference",
  "title": "Event reference",
  "description": "A reference to one immutable generic event-ledger record.",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId"],
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    }
  }
}
