{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dantesroleplay:dnd2024:prototype:value:calculation-reference",
  "title": "Calculation mechanic reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["mechanicId", "inputBindings"],
  "properties": {
    "mechanicId": { "type": "string", "pattern": "^mechanic\\.[a-z][a-z0-9.-]*$", "maxLength": 200 },
    "inputBindings": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]*$" },
      "additionalProperties": {
        "anyOf": [
          { "type": "integer" },
          { "type": "number" },
          { "type": "string", "minLength": 1 },
          { "type": "boolean" },
          { "$ref": "urn:dantesroleplay:dnd2024:prototype:value:entity-reference" }
        ]
      }
    }
  }
}
