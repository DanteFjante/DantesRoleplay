{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["grants"],
  "properties": {
    "grants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["definitionId", "grantedByDefinitionId", "grantKind", "configurationKey", "sourceRef"],
            "properties": {
              "definitionId": {"type": "string", "minLength": 20, "maxLength": 200, "pattern": "^[a-z0-9.-]+$"},
              "grantedByDefinitionId": {"type": "string", "minLength": 20, "maxLength": 200, "pattern": "^[a-z0-9.-]+$"},
              "grantKind": {"const": "origin-feat"},
              "configurationKey": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z0-9-]+$"},
              "sourceRef": {"$ref": "#/$defs/sourceRef"}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["definitionId", "grantedByDefinitionId", "grantKind", "classLevel", "sourceRef"],
            "properties": {
              "definitionId": {"type": "string", "minLength": 20, "maxLength": 200, "pattern": "^[a-z0-9.-]+$"},
              "grantedByDefinitionId": {"type": "string", "minLength": 20, "maxLength": 200, "pattern": "^[a-z0-9.-]+$"},
              "grantKind": {"const": "class-feature"},
              "classLevel": {"type": "integer", "minimum": 1, "maximum": 20},
              "sourceRef": {"$ref": "#/$defs/sourceRef"}
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "locator"],
      "properties": {
        "sourceId": {"const": "source.dnd2024.srd-5.2.1"},
        "locator": {"type": "string", "minLength": 4, "maxLength": 200}
      }
    }
  }
}
