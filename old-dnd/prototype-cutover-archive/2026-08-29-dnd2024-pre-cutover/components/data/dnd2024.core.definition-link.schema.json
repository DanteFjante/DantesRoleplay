{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["definition"],
  "properties": {
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entityId"],
      "properties": {
        "entityId": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "definitionRevision": { "type": "integer", "minimum": 1 }
  }
}
