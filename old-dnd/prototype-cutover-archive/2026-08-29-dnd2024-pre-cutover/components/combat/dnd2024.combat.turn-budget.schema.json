{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["turn", "remaining", "movementSpent", "interactionsUsed"],
  "properties": {
    "turn": {
      "type": "object", "additionalProperties": false, "required": ["entityId"],
      "properties": { "entityId": { "type": "string", "minLength": 1, "maxLength": 200 } }
    },
    "remaining": {
      "type": "object", "additionalProperties": false,
      "required": ["actions", "bonusActions", "reactions"],
      "properties": {
        "actions": { "type": "integer", "minimum": 0 },
        "bonusActions": { "type": "integer", "minimum": 0 },
        "reactions": { "type": "integer", "minimum": 0 }
      }
    },
    "movementSpent": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["mode", "distance"],
        "properties": {
          "mode": {
            "type": "object", "additionalProperties": false, "required": ["entityId"],
            "properties": { "entityId": { "type": "string", "minLength": 1, "maxLength": 200 } }
          },
          "distance": {
            "type": "object", "additionalProperties": false,
            "required": ["dimension", "value", "unit"],
            "properties": {
              "dimension": { "const": "distance" },
              "value": {
                "type": "object", "additionalProperties": false, "required": ["numerator", "denominator"],
                "properties": {
                  "numerator": { "type": "integer", "minimum": 0 },
                  "denominator": { "type": "integer", "minimum": 1 }
                }
              },
              "unit": {
                "type": "object", "additionalProperties": false, "required": ["entityId"],
                "properties": { "entityId": { "const": "dnd2024.vocabulary.distance-unit.meter" } }
              }
            }
          }
        }
      }
    },
    "interactionsUsed": { "type": "integer", "minimum": 0 },
    "lastUpdatedByOperation": {
      "type": "object", "additionalProperties": false, "required": ["operationId"],
      "properties": { "operationId": { "type": "string", "minLength": 1, "maxLength": 200 } }
    }
  }
}
