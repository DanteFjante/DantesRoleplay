{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["encounter", "round", "participant", "ordinal", "status"],
  "properties": {
    "encounter": {
      "type": "object", "additionalProperties": false, "required": ["entityId"],
      "properties": { "entityId": { "type": "string", "minLength": 1, "maxLength": 200 } }
    },
    "round": {
      "type": "object", "additionalProperties": false, "required": ["entityId"],
      "properties": { "entityId": { "type": "string", "minLength": 1, "maxLength": 200 } }
    },
    "participant": {
      "type": "object", "additionalProperties": false, "required": ["entityId"],
      "properties": { "entityId": { "type": "string", "minLength": 1, "maxLength": 200 } }
    },
    "ordinal": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["pending", "active", "complete", "skipped"] },
    "startedByEvent": {
      "type": "object", "additionalProperties": false, "required": ["eventId"],
      "properties": { "eventId": { "type": "string", "minLength": 1, "maxLength": 200 } }
    },
    "endedByEvent": {
      "type": "object", "additionalProperties": false, "required": ["eventId"],
      "properties": { "eventId": { "type": "string", "minLength": 1, "maxLength": 200 } }
    },
    "openedWindows": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["entityId"],
        "properties": { "entityId": { "type": "string", "minLength": 1, "maxLength": 200 } }
      }
    }
  }
}
