{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["entries", "recordedFamilies"],
  "properties": {
    "entries": {
      "type": "object",
      "maxProperties": 256,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rankRef", "sourceRefs"],
        "properties": {
          "rankRef": {
            "type": "object",
            "additionalProperties": false,
            "required": ["entityId"],
            "properties": {
              "entityId": {
                "enum": [
                  "dnd2024.vocabulary.proficiency-rank.proficiency",
                  "dnd2024.vocabulary.proficiency-rank.expertise"
                ]
              }
            }
          },
          "sourceRefs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["entityId"],
              "properties": {
                "entityId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[a-z0-9.-]+$"
                }
              }
            }
          }
        }
      }
    },
    "recordedFamilies": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": ["armor-training", "saving-throw", "skill", "tool", "weapon"]
      }
    }
  }
}
