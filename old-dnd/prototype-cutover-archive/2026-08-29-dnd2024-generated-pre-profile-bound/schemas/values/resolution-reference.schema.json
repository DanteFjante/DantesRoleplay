{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dantesroleplay:dnd2024:prototype:value:resolution-reference",
  "title": "Resolution reference",
  "description": "A reference to one immutable generic interaction-resolution receipt.",
  "type": "object",
  "additionalProperties": false,
  "required": ["resolutionReceiptId"],
  "properties": {
    "resolutionReceiptId": {
      "type": "string",
      "pattern": "^interaction-receipt\\.[0-9a-f]{32}$",
      "maxLength": 52
    }
  }
}
