{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dantesroleplay:dnd2024:prototype:value:range",
  "title": "Range",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "enum": ["self", "touch", "sight", "unlimited", "special"] } }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "normal"],
      "properties": {
        "kind": { "const": "distance" },
        "normal": { "$ref": "urn:dantesroleplay:dnd2024:prototype:value:distance-measurement" },
        "long": { "$ref": "urn:dantesroleplay:dnd2024:prototype:value:distance-measurement" }
      }
    }
  ]
}
