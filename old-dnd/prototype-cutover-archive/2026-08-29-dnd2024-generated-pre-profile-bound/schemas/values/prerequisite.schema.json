{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dantesroleplay:dnd2024:prototype:value:prerequisite",
  "title": "Prerequisite expression",
  "$defs": {
    "node": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operator", "children"],
          "properties": {
            "operator": { "enum": ["all", "any"] },
            "children": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operator", "child"],
          "properties": {
            "operator": { "const": "not" },
            "child": { "$ref": "#/$defs/node" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operator", "predicateId", "arguments"],
          "properties": {
            "operator": { "const": "predicate" },
            "predicateId": { "type": "string", "pattern": "^predicate\\.[a-z][a-z0-9.-]*$", "maxLength": 200 },
            "arguments": {
              "type": "array",
              "items": {
                "anyOf": [
                  { "type": "integer" },
                  { "type": "number" },
                  { "type": "string", "minLength": 1 },
                  { "type": "boolean" },
                  { "$ref": "urn:dantesroleplay:dnd2024:prototype:value:entity-reference" }
                ]
              }
            }
          }
        }
      ]
    }
  },
  "$ref": "#/$defs/node"
}
