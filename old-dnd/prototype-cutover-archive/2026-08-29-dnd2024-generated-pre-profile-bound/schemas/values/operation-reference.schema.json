{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dantesroleplay:dnd2024:prototype:value:operation-reference",
  "title": "Operation reference",
  "description": "A reference to one canonical generic operation-history record.",
  "type": "object",
  "additionalProperties": false,
  "required": ["operationId"],
  "properties": {
    "operationId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    }
  }
}
