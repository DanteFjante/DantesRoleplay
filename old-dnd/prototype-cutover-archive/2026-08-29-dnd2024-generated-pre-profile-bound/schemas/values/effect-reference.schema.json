{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dantesroleplay:dnd2024:prototype:value:effect-reference",
  "title": "Effect definition reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["effect"],
  "properties": {
    "effect": { "$ref": "urn:dantesroleplay:dnd2024:prototype:value:entity-reference" },
    "condition": { "$ref": "urn:dantesroleplay:dnd2024:prototype:value:prerequisite" },
    "parameters": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]*$" },
      "additionalProperties": {
        "anyOf": [
          { "type": "integer" },
          { "type": "number" },
          { "type": "string" },
          { "type": "boolean" },
          { "$ref": "urn:dantesroleplay:dnd2024:prototype:value:dice-expression" },
          { "$ref": "urn:dantesroleplay:dnd2024:prototype:value:entity-reference" }
        ]
      }
    }
  }
}
