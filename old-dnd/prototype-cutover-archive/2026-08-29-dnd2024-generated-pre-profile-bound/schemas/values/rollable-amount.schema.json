{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dantesroleplay:dnd2024:prototype:value:rollable-amount",
  "title": "Rollable amount",
  "description": "A fixed amount, a dice expression, or the paired printed average and dice expression used by SRD stat blocks.",
  "oneOf": [
    {
      "type": "integer",
      "minimum": 0
    },
    {
      "$ref": "urn:dantesroleplay:dnd2024:prototype:value:dice-expression"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["average", "roll"],
      "properties": {
        "average": {
          "type": "integer",
          "minimum": 0
        },
        "roll": {
          "$ref": "urn:dantesroleplay:dnd2024:prototype:value:dice-expression"
        }
      }
    }
  ]
}
