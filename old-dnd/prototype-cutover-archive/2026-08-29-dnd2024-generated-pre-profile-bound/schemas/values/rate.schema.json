{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dantesroleplay:dnd2024:prototype:value:rate",
  "title": "Distance rate",
  "description": "A non-negative distance divided by a positive period, such as feet per round or miles per hour.",
  "type": "object",
  "additionalProperties": false,
  "required": ["distance", "period"],
  "properties": {
    "distance": {
      "$ref": "urn:dantesroleplay:dnd2024:prototype:value:distance-measurement"
    },
    "period": {
      "allOf": [
        { "$ref": "urn:dantesroleplay:dnd2024:prototype:value:time-measurement" },
        {
          "properties": {
            "value": { "$ref": "urn:dantesroleplay:dnd2024:prototype:value:positive-rational" }
          }
        }
      ]
    }
  }
}
