{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dantesroleplay:dnd2024:prototype:value:relationship-edge-reference",
  "title": "Relationship edge reference",
  "description": "The complete identity of one generic state-space relationship edge.",
  "type": "object",
  "additionalProperties": false,
  "required": ["stateSpaceId", "fromEntityId", "toEntityId", "qualifiedKind"],
  "properties": {
    "stateSpaceId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 200
    },
    "fromEntityId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 200
    },
    "toEntityId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 200
    },
    "qualifiedKind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}(?:\\.[a-z][a-z0-9-]{0,62})+$",
      "maxLength": 200
    }
  }
}
