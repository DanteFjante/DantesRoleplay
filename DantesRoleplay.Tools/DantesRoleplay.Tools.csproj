<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>DantesRoleplay.Tools</RootNamespace>
    <AssemblyName>roleplay</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Reference DataAccess, but deliberately not RuleAccess. These catalog tools do not expose a
      mechanic-execution command; DataAccess supplies their persistence services and its own
      dependencies transitively. Keeping direct package references out of this project prevents the
      CLI from quietly growing a second application composition root.
    -->
    <ProjectReference Include="..\DantesRoleplay.DataAccess\DantesRoleplay.DataAccess.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\src\system\catalog-tools\tooling\**\*.cs">
      <Link>Components\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

</Project>
