{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "firstVisitedMinute",
    "lastVisitedMinute",
    "visitCount",
    "status",
    "summary",
    "memory"
  ],
  "properties": {
    "firstVisitedMinute": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "lastVisitedMinute": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "visitCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "status": {
      "enum": ["current", "departed"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "memory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "gmContext": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  }
}
