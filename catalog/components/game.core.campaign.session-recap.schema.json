{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "chapter", "arc", "milestones"],
  "properties": {
    "protocolVersion": { "const": "session.s0.c3-only.v1" },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "title", "partyQuestion"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "status": { "const": "active" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "partyQuestion": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "arc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "title", "partyStake"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "status": { "const": "active" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "partyStake": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "milestones": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chapterId", "title", "closingSummary", "timestamp", "sequence"],
        "properties": {
          "chapterId": { "type": "string", "minLength": 1, "maxLength": 200 },
          "title": { "type": "string", "minLength": 1, "maxLength": 160 },
          "closingSummary": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "timestamp": { "type": "string", "format": "date-time" },
          "sequence": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
