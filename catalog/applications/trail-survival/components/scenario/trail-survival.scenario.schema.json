{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenarioId", "scenarioVersion", "scenarioContentHash", "rulesProfileId",
    "routeId", "startLandmarkId", "finalLandmarkId", "currencyResourceId", "foodResourceId",
    "initialResources", "memberMaxHealth", "conveyance", "defaultPolicy", "paces", "rations",
    "market", "rest", "forage", "routeLegs", "events", "outcomes"
  ],
  "properties": {
    "scenarioId": { "type": "string", "minLength": 1, "maxLength": 100 },
    "scenarioVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "scenarioContentHash": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "rulesProfileId": { "type": "string", "minLength": 1, "maxLength": 100 },
    "routeId": { "type": "string", "minLength": 1, "maxLength": 100 },
    "startLandmarkId": { "type": "string", "minLength": 1, "maxLength": 100 },
    "finalLandmarkId": { "type": "string", "minLength": 1, "maxLength": 100 },
    "currencyResourceId": { "type": "string", "minLength": 1, "maxLength": 100 },
    "foodResourceId": { "type": "string", "minLength": 1, "maxLength": 100 },
    "initialResources": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["resourceId", "quantity"],
        "properties": {
          "resourceId": { "type": "string", "minLength": 1, "maxLength": 100 },
          "quantity": { "type": "integer", "minimum": 0, "maximum": 1000000000 }
        }
      }
    },
    "memberMaxHealth": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "conveyance": {
      "type": "object", "additionalProperties": false,
      "required": ["kindId", "condition", "maximumCondition", "cargoCapacity"],
      "properties": {
        "kindId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "condition": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "maximumCondition": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "cargoCapacity": { "type": "integer", "minimum": 0, "maximum": 1000000000 }
      }
    },
    "defaultPolicy": {
      "type": "object", "additionalProperties": false, "required": ["paceId", "rationId"],
      "properties": {
        "paceId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "rationId": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "paces": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["paceId", "distancePerTurn", "minutesPerTurn", "conveyanceWear", "eventChancePer10000"],
        "properties": {
          "paceId": { "type": "string", "minLength": 1, "maxLength": 100 },
          "distancePerTurn": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
          "minutesPerTurn": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
          "conveyanceWear": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
          "eventChancePer10000": { "type": "integer", "minimum": 0, "maximum": 10000 }
        }
      }
    },
    "rations": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["rationId", "foodPerMember", "healthDelta"],
        "properties": {
          "rationId": { "type": "string", "minLength": 1, "maxLength": 100 },
          "foodPerMember": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
          "healthDelta": { "type": "integer", "minimum": -1000000, "maximum": 1000000 }
        }
      }
    },
    "market": {
      "type": "object", "additionalProperties": false, "required": ["landmarkIds", "offers"],
      "properties": {
        "landmarkIds": {
          "type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "offers": {
          "type": "array", "minItems": 1, "maxItems": 128,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["resourceId", "buyPrice", "sellPrice", "unitWeight"],
            "properties": {
              "resourceId": { "type": "string", "minLength": 1, "maxLength": 100 },
              "buyPrice": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
              "sellPrice": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
              "unitWeight": { "type": "integer", "minimum": 0, "maximum": 1000000000 }
            }
          }
        }
      }
    },
    "rest": {
      "type": "object", "additionalProperties": false,
      "required": ["minutes", "foodPerMember", "healthGain"],
      "properties": {
        "minutes": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "foodPerMember": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "healthGain": { "type": "integer", "minimum": 0, "maximum": 1000000 }
      }
    },
    "forage": {
      "type": "object", "additionalProperties": false,
      "required": ["minutes", "minimumYield", "maximumYield"],
      "properties": {
        "minutes": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "minimumYield": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "maximumYield": { "type": "integer", "minimum": 0, "maximum": 1000000000 }
      }
    },
    "routeLegs": {
      "type": "array", "minItems": 1, "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["legId", "fromLandmarkId", "toLandmarkId", "distance"],
        "properties": {
          "legId": { "type": "string", "minLength": 1, "maxLength": 100 },
          "fromLandmarkId": { "type": "string", "minLength": 1, "maxLength": 100 },
          "toLandmarkId": { "type": "string", "minLength": 1, "maxLength": 100 },
          "distance": { "type": "integer", "minimum": 1, "maximum": 1000000000 }
        }
      }
    },
    "events": {
      "type": "array", "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["eventId", "weight", "choices"],
        "properties": {
          "eventId": { "type": "string", "minLength": 1, "maxLength": 100 },
          "weight": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
          "choices": {
            "type": "array", "minItems": 1, "maxItems": 16,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["choiceId", "resourceDeltas", "healthDelta", "conveyanceDelta", "elapsedMinutes", "outcomeKind", "outcomeCauseId"],
              "properties": {
                "choiceId": { "type": "string", "minLength": 1, "maxLength": 100 },
                "resourceDeltas": {
                  "type": "array", "maxItems": 128,
                  "items": {
                    "type": "object", "additionalProperties": false, "required": ["resourceId", "quantity"],
                    "properties": {
                      "resourceId": { "type": "string", "minLength": 1, "maxLength": 100 },
                      "quantity": { "type": "integer", "minimum": -1000000000, "maximum": 1000000000 }
                    }
                  }
                },
                "healthDelta": { "type": "integer", "minimum": -1000000, "maximum": 1000000 },
                "conveyanceDelta": { "type": "integer", "minimum": -1000000000, "maximum": 1000000000 },
                "elapsedMinutes": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
                "outcomeKind": { "enum": ["none", "victory", "defeat"] },
                "outcomeCauseId": {
                  "anyOf": [
                    { "type": "string", "minLength": 1, "maxLength": 100 },
                    { "type": "null" }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "outcomes": {
      "type": "object", "additionalProperties": false,
      "required": ["victoryCauseId", "partyDefeatCauseId", "conveyanceDefeatCauseId"],
      "properties": {
        "victoryCauseId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "partyDefeatCauseId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "conveyanceDefeatCauseId": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    }
  }
}
