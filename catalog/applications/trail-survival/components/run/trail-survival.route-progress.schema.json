{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["routeId", "currentLandmarkId", "activeLegId", "distanceIntoLeg", "visitedLandmarkIds"],
  "properties": {
    "routeId": { "type": "string", "minLength": 1, "maxLength": 100 },
    "currentLandmarkId": { "type": "string", "minLength": 1, "maxLength": 100 },
    "activeLegId": {
      "anyOf": [
        { "type": "string", "minLength": 1, "maxLength": 100 },
        { "type": "null" }
      ]
    },
    "distanceIntoLeg": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
    "visitedLandmarkIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 100 }
    }
  }
}
