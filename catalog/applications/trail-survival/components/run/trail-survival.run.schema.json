{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["phase", "turn", "partyId", "randomSeed", "seedCursor"],
  "properties": {
    "phase": { "enum": ["setup", "travel", "finished"] },
    "turn": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "partyId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "randomSeed": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "seedCursor": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
  }
}
