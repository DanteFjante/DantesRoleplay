{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resourceId", "quantity"],
        "properties": {
          "resourceId": { "type": "string", "minLength": 1, "maxLength": 100 },
          "quantity": { "type": "integer", "minimum": 0, "maximum": 1000000000 }
        }
      }
    }
  }
}
