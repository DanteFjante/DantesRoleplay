{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "causeId", "reachedTurn"],
  "properties": {
    "kind": { "enum": ["victory", "defeat"] },
    "causeId": { "type": "string", "minLength": 1, "maxLength": 100 },
    "reachedTurn": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
  }
}
