{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dantesroleplay:dnd2024:prototype:meta:srd-coverage",
  "title": "SRD model coverage registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["sourceId", "sections"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "sourceId": { "const": "dnd2024.source.srd-5.2.1" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "locator", "pageStart", "pageEnd", "componentKeys", "archetypeKeys", "otherOwners"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "locator": { "type": "string", "minLength": 1 },
          "pageStart": { "type": "integer", "minimum": 1, "maximum": 364 },
          "pageEnd": { "type": "integer", "minimum": 1, "maximum": 364 },
          "componentKeys": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "urn:dantesroleplay:dnd2024:prototype:value:component-key" }
          },
          "archetypeKeys": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "urn:dantesroleplay:dnd2024:prototype:value:archetype-key" }
          },
          "otherOwners": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
