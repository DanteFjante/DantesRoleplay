{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dantesroleplay:dnd2024:prototype:meta:entity-archetype",
  "title": "Entity archetype manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["key", "kind", "description", "requiredComponents", "optionalComponents", "sourceSections"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "key": { "$ref": "urn:dantesroleplay:dnd2024:prototype:value:archetype-key" },
    "kind": { "enum": ["authored", "runtime"] },
    "description": { "type": "string", "minLength": 1 },
    "requiredComponents": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "urn:dantesroleplay:dnd2024:prototype:value:component-key" }
    },
    "optionalComponents": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "urn:dantesroleplay:dnd2024:prototype:value:component-key" }
    },
    "sourceSections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "externalOwners": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["owner", "usage"],
        "properties": {
          "owner": { "type": "string", "minLength": 1 },
          "usage": { "type": "string", "minLength": 1 }
        }
      }
    },
    "invariantNotes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
