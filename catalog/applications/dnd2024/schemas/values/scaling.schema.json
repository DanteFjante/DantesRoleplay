{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dantesroleplay:dnd2024:prototype:value:scaling",
  "title": "Scaling schedule",
  "type": "object",
  "additionalProperties": false,
  "required": ["basis", "steps"],
  "properties": {
    "basis": { "enum": ["character-level", "class-level", "spell-slot-level", "resource-spent", "quantity", "mechanic"] },
    "source": { "$ref": "urn:dantesroleplay:dnd2024:prototype:value:entity-reference" },
    "calculation": { "$ref": "urn:dantesroleplay:dnd2024:prototype:value:calculation-reference" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["atLeast", "effects"],
        "properties": {
          "atLeast": { "type": "integer", "minimum": 0 },
          "effects": { "type": "array", "minItems": 1, "items": { "$ref": "urn:dantesroleplay:dnd2024:prototype:value:effect-reference" } }
        }
      }
    }
  }
}
