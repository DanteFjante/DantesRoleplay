{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dantesroleplay:dnd2024:prototype:value:duration",
  "title": "Duration",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["instantaneous", "permanent", "special"] }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "amount", "unit"],
      "properties": {
        "kind": { "const": "measured" },
        "amount": {
          "oneOf": [
            { "$ref": "urn:dantesroleplay:dnd2024:prototype:value:rollable-amount" },
            { "$ref": "urn:dantesroleplay:dnd2024:prototype:value:calculation-reference" }
          ]
        },
        "unit": { "$ref": "urn:dantesroleplay:dnd2024:prototype:value:entity-reference" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "event"],
      "properties": {
        "kind": { "const": "until-event" },
        "event": { "$ref": "urn:dantesroleplay:dnd2024:prototype:value:trigger" }
      }
    }
  ]
}
