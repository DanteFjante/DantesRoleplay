{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dantesroleplay:dnd2024:prototype:value:area",
  "title": "Area geometry",
  "type": "object",
  "additionalProperties": false,
  "required": ["shape", "dimensions", "origin", "movesWithOrigin"],
  "properties": {
    "shape": { "$ref": "urn:dantesroleplay:dnd2024:prototype:value:entity-reference" },
    "dimensions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "enum": ["length", "width", "height", "radius", "diameter"] },
      "additionalProperties": { "$ref": "urn:dantesroleplay:dnd2024:prototype:value:distance-measurement" }
    },
    "origin": { "enum": ["source", "point-in-range", "target"] },
    "movesWithOrigin": { "type": "boolean" }
  }
}
