{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dantesroleplay:dnd2024:prototype:value:outcome",
  "title": "Resolution outcome",
  "type": "object",
  "additionalProperties": false,
  "required": ["result", "effects"],
  "properties": {
    "result": { "enum": ["success", "failure", "critical-success", "critical-failure", "always"] },
    "effects": { "type": "array", "items": { "$ref": "urn:dantesroleplay:dnd2024:prototype:value:effect-reference" } }
  }
}
