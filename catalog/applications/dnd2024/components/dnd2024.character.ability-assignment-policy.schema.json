{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["policyVersion", "sourceRef", "scoreBounds", "allocation"],
  "properties": {
    "policyVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "locator"],
      "properties": {
        "sourceId": { "const": "dnd2024.source.srd-5.2.1" },
        "locator": { "type": "string", "minLength": 4, "maxLength": 200 }
      }
    },
    "scoreBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": { "type": "integer", "minimum": 1, "maximum": 30 },
        "maximum": { "type": "integer", "minimum": 1, "maximum": 30 }
      }
    },
    "allocation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["family", "values"],
          "properties": {
            "family": { "const": "fixed-multiset" },
            "values": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "items": { "type": "integer", "minimum": 1, "maximum": 30 }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["family", "budget", "costs"],
          "properties": {
            "family": { "const": "point-budget" },
            "budget": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "costs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 30,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["score", "cost"],
                "properties": {
                  "score": { "type": "integer", "minimum": 1, "maximum": 30 },
                  "cost": { "type": "integer", "minimum": 0, "maximum": 1000 }
                }
              }
            }
          }
        }
      ]
    }
  }
}
