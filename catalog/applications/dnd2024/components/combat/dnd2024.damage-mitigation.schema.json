{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["resistances", "immunities", "vulnerabilities", "sourceRef"],
  "properties": {
    "resistances": {
      "type": "array",
      "maxItems": 13,
      "uniqueItems": true,
      "items": {
        "enum": ["acid", "bludgeoning", "cold", "fire", "force", "lightning", "necrotic", "piercing", "poison", "psychic", "radiant", "slashing", "thunder"]
      }
    },
    "immunities": {
      "type": "array",
      "maxItems": 13,
      "uniqueItems": true,
      "items": {
        "enum": ["acid", "bludgeoning", "cold", "fire", "force", "lightning", "necrotic", "piercing", "poison", "psychic", "radiant", "slashing", "thunder"]
      }
    },
    "vulnerabilities": {
      "type": "array",
      "maxItems": 13,
      "uniqueItems": true,
      "items": {
        "enum": ["acid", "bludgeoning", "cold", "fire", "force", "lightning", "necrotic", "piercing", "poison", "psychic", "radiant", "slashing", "thunder"]
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "locator"],
      "properties": {
        "sourceId": { "const": "source.dnd2024.srd-5.2.1" },
        "locator": { "const": "Playing the Game > Damage and Healing > Resistance and Vulnerability; Immunity (PDF p. 17)" }
      }
    }
  }
}
