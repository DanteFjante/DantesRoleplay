{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["skills", "sourceRef"],
  "properties": {
    "skills": {
      "type": "array",
      "maxItems": 18,
      "uniqueItems": true,
      "items": {
        "enum": ["acrobatics", "animal-handling", "arcana", "athletics", "deception", "history", "insight", "intimidation", "investigation", "medicine", "nature", "perception", "performance", "persuasion", "religion", "sleight-of-hand", "stealth", "survival"]
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "locator"],
      "properties": {
        "sourceId": { "const": "source.dnd2024.srd-5.2.1" },
        "locator": { "const": "Playing the Game > Proficiency > Skill Proficiencies and Skills" }
      }
    }
  }
}
