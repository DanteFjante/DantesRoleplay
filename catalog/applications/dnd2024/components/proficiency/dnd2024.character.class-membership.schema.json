{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["classRef", "level"],
  "properties": {
    "classRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entityId"],
      "properties": { "entityId": { "type": "string", "minLength": 1, "maxLength": 200 } }
    },
    "level": { "type": "integer", "minimum": 1, "maximum": 20 },
    "subclassRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entityId"],
      "properties": { "entityId": { "type": "string", "minLength": 1, "maxLength": 200 } }
    }
  }
}
