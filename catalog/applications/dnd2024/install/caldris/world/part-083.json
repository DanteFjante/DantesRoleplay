{
  "format": "dantesroleplay.world-package/1",
  "rootEntityId": "world.caldris",
  "entities": [
    {
      "entityId": "secret.caldris.lore.0227-the-day-little-lastlight-went-dark-traces-and-stories.1",
      "name": "The Day Little Lastlight Went Dark — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Conflicting ceremony sheets, altered brackets, and a temporary lighting rota. A present failure might arise from changed surroundings, interrupted care, or a different cause altogether. Investigation should establish which, rather than replaying this episode as a universal solution.",
            "provenance": "history-300-200-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0235-the-hearing-beneath-the-old-banner-gm-truth.1",
      "name": "The Hearing Beneath the Old Banner — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Tessa's compromise knowingly left one small settlement in a weak position because its crucial witnesses could not be found before the hearing closed. Their testimony remains a plausible archival discovery. Whether it changes a present claim depends on what happened during the intervening centuries.",
            "provenance": "history-300-200-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0235-the-hearing-beneath-the-old-banner-traces-and-stories.1",
      "name": "The Hearing Beneath the Old Banner — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Annotated renewals, lodging accounts, and unfinished petitions. A quest might recover evidence of a bridge repair that altered later obligations. Discovering an ancient charter can matter without automatically placing every living household under its oldest wording.",
            "provenance": "history-300-200-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0243-the-letters-that-wintered-abroad-gm-truth.1",
      "name": "The Letters That Wintered Abroad — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "One celebrated cache of unsent love letters was left deliberately unposted by its author. A clerk preserved it under a storage agreement, not through negligence. Its survival does not establish consent for strangers to read or circulate it.",
            "provenance": "history-300-200-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0243-the-letters-that-wintered-abroad-traces-and-stories.1",
      "name": "The Letters That Wintered Abroad — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Carrier receipts, returned envelopes, and forwarding lists. A present delivery can trace a household through changes of name and residence. Recovering a packet is only the beginning; determining who should receive it can be the more difficult task.",
            "provenance": "history-300-200-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0251-the-evening-market-of-brinefold-gm-truth.1",
      "name": "The Evening Market of Brinefold — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Jori sometimes waived inspection charges for sellers in immediate need, recording the shortfall as his own debt. One surviving account can look like theft until the corresponding household receipts are compared. Compassion did not spare him from having to explain the money.",
            "provenance": "history-300-200-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0251-the-evening-market-of-brinefold-traces-and-stories.1",
      "name": "The Evening Market of Brinefold — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Small sale tickets, repair labels, and objects bearing successive owners' marks. A modest purchase can begin a journey to identify a maker or return something borrowed generations earlier. An apparently sinister object may simply have been misunderstood when its instructions were lost.",
            "provenance": "history-300-200-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0259-salt-without-sails-gm-truth.1",
      "name": "Salt Without Sails — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Dema carried both necessary household supplies and valuable luxury goods under the same arrangements. The profits from the latter helped finance the former. Later admirers removed the luxury cargo from the story, making her work look less commercially complicated than it was.",
            "provenance": "history-300-200-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0259-salt-without-sails-traces-and-stories.1",
      "name": "Salt Without Sails — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Emergency freight agreements, concealed landing places, and warehouses built for a prosperity that did not always last. A forgotten route can support a present journey, but its old existence does not guarantee that bridges, permissions, or water levels remain suitable.",
            "provenance": "history-300-200-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0267-the-birds-in-cinder-meadow-gm-truth.1",
      "name": "The Birds in Cinder Meadow — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The birds were rare magical animals known locally as ember herons, attracted to warm mineral soils after fire. They do not resurrect people, and burning another meadow would not reliably summon them. A few properly documented impressions could teach a careful observer more than a costly supposed feather bought without provenance.",
            "provenance": "history-300-200-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0267-the-birds-in-cinder-meadow-traces-and-stories.1",
      "name": "The Birds in Cinder Meadow — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Preserved cuttings, fire boundaries, glassy footprints, and several incompatible bird illustrations. An expedition might identify a later nesting site, protect it from collectors, or recover a surviving nursery variety thought lost in the fire.",
            "provenance": "history-300-200-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0275-the-opening-of-ashglass-house-gm-truth.1",
      "name": "The Opening of Ashglass House — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Arvel once concealed a failed batch to protect the workshop's reputation. Sena discovered it before sale and made the disposal part of the accounts. Their partnership survived the dispute, but the later tale that they never disagreed was invented for an anniversary celebration.",
            "provenance": "history-300-200-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0275-the-opening-of-ashglass-house-traces-and-stories.1",
      "name": "The Opening of Ashglass House — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Batch marks, repair assessments, and objects with both old and replacement components. A present commission can reveal that a famous relic has survived through several thoughtful alterations. Finding an original recipe may help, but preserving the original material is not always the safest repair.",
            "provenance": "history-300-200-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0283-the-last-measure-in-willowrace-gm-truth.1",
      "name": "The Last Measure in Willowrace — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Orven's death is natural and final in this history. The travelling fiddle contains no hidden soul or message from beyond death. Ilda quietly changed its neck dimensions to suit the intended player, fulfilling the practical purpose of the commission rather than preserving every unfinished choice.",
            "provenance": "history-300-200-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0283-the-last-measure-in-willowrace-traces-and-stories.1",
      "name": "The Last Measure in Willowrace — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Deposit lists, unfinished components, and teaching copies with corrections in several hands. Returning an instrument to the proper successor household can be a meaningful quest. Establishing the history of a repair may matter more than proving that every part came from Orven's bench.",
            "provenance": "history-300-200-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0291-the-winter-latch-gm-truth.1",
      "name": "The Winter Latch — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Aurr had already stored food for an expected visit from another giant household and shared part of it. The rescue cost the giant something. Records do not establish Aurr's eventual death or present whereabouts; later encounters should not assume an immortal guardian waiting at the same door.",
            "provenance": "history-300-200-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0291-the-winter-latch-traces-and-stories.1",
      "name": "The Winter Latch — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Giant-cut footholds, supply rosters, and a lintel carrying both human and oversized tool marks. A present supply journey can rediscover which descent is safe after later changes. The refuge's existence does not prove that the upper stair ever became a caravan road.",
            "provenance": "history-300-200-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0299-the-wool-that-arrived-too-late-gm-truth.1",
      "name": "The Wool That Arrived Too Late — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Teren anticipated the shortage accurately and still nearly failed because a major buyer delayed payment. He later claimed to have financed Edda's purchases; he had refused the request. Her actual guarantors were three carrier households whose names survive on a damaged joint bond.",
            "provenance": "history-300-200-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0299-the-wool-that-arrived-too-late-traces-and-stories.1",
      "name": "The Wool That Arrived Too Late — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Advance contracts, samples of mixed cloth, and abandoned fulling sites. An inherited debt may originate in an apparently prosperous year. A commission to identify an old blanket can connect a traveller to the small workshops that made survival possible without becoming rich.",
            "provenance": "history-300-200-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0300-0200-place-ashglass-house.1",
      "name": "Ashglass House — history and story material",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "location",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Present-day form: A glass workshop in Istravel with a small repair room and a collection of clearly labelled failed experiments. Most of its business is ordinary glass. Its modest enchanted vessels require careful handling, compatible materials, and occasional renewal by someone who understands their particular binding. A person to meet: Glassmaker Mera Dorr has a sound replacement for a cracked support but needs help persuading an owner that repair will change the object. She also wants a missing batch book recovered before accepting several inherited pieces. Adventure: Obtain suitable material, trace an unreliable vessel's maker, or compare old mounting diagrams with the object now in hand. A powerful customer may want a dramatic restoration where a modest safe repair would serve better.",
            "provenance": "history-300-200-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    }
  ],
