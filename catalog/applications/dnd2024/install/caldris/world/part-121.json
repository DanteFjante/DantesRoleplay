    {
      "entityId": "actor.caldris.ansel-daro",
      "name": "Ansel Daro",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.motive",
          "value": {
            "status": "active",
            "summary": "charming League Chair, currently missing. Immediate want: survive long enough to reveal archive truth. Hidden depth: wrote three resignations for three anticipated kidnappers.",
