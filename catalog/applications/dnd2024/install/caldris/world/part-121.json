    {
      "entityId": "actor.caldris.architect-sola-mere",
      "name": "Architect Sola Mere",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.motive",
          "value": {
            "status": "active",
            "summary": "Cringeworthy palace guide with elaborate gestures, incorrect heroic poses, and excellent structural judgment. Wants the Unfinished Palace kept public; understands load paths and encoded measurements; longs for noble patronage. Directs pageants with Sera Lark by letter. Refusing a lucrative private commission becomes her proof of maturity.",
            "visibility": "party"
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.selucia",
        "slot": "people"
      }
    },
    {
      "entityId": "actor.caldris.auditor-celyn-marr",
      "name": "Auditor Celyn Marr",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.motive",
          "value": {
            "status": "active",
            "summary": "the sponsor above the minister. A pleasant, forgettable policy adviser who never carries a weapon and rarely tells a direct lie. Celyn leads a Seventh Ledger restoration cell and supplied Vane with convincing analyses, forged precedents, and real evidence of approaching instability. Celyn views people as entries that should be made legible for their own protection. Celyn answers to a Council of Margins distributed across both continents. The Council itself is divided: restorationists want Concord authority, custodians want dangerous archives contained, and reformers want public standards without inherited debt. “The boss” becomes a political network, not an infinite line of stronger combatants.",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.alderwick",
        "slot": "people"
      }
    },
    {
      "entityId": "actor.caldris.auntie-brin-sallow",
      "name": "Auntie Brin Sallow",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.motive",
          "value": {
            "status": "active",
            "summary": "Dry realist and elected Mackerel Crown harbour speaker who calls everyone “captain” when annoyed. Wants the fleet moving despite the dual seals; remembers customary law and every household's boat; fears compromise will look like weakness. Her rival speaker is her former closest friend. Shared danger can restore practical trust before affection.",
            "visibility": "party"
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.carrowmere",
        "slot": "people"
      }
    },
    {
      "entityId": "actor.caldris.basto-inkhand",
      "name": "Basto Inkhand",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.motive",
          "value": {
            "status": "active",
            "summary": "Gentle grump and Inkfish Wharf maker whose hands, sleeves, and household goat are permanently black. Wants the fading-document panic stopped; understands pigments and paper; once sold poor ink during hardship and expects suspicion. Supplies the Vessa Open Archive League. He confesses his old fault when others distinguish it from the current sabotage.",
            "visibility": "party"
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.ordelain",
        "slot": "people"
      }
    },
    {
      "entityId": "actor.caldris.bera-flint",
      "name": "Bera Flint",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.motive",
          "value": {
            "status": "active",
            "summary": "Tired authority and elected goat judge who prepares legal opinions while her decorated goat eats the ribbons. Wants missing animals returned without a border incident; understands grazing law and kinship networks; worries outsiders see her court as ridiculous. Respected by Oath Rope Lodges. Serious engagement with the ritual makes her an inventive negotiator.",
            "visibility": "party"
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lornesse",
        "slot": "people"
      }
    },
    {
      "entityId": "actor.caldris.borin-well",
      "name": "Borin Well",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.motive",
          "value": {
            "status": "active",
            "summary": "gentle grump smelter. Immediate want: stop copper theft. Hidden depth: hears Karsh speaking through furnace drafts—or thinks he does.",
            "visibility": "party"
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.kethria",
