{
  "format": "dantesroleplay.world-package/1",
  "rootEntityId": "world.caldris",
  "entities": [
    {
      "entityId": "chronology.caldris.tidecross.ferry-stairs",
      "name": "The Two Ferry Stairs Open",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.chronology",
          "value": {
            "status": "active",
            "title": "The Two Ferry Stairs Open",
            "summary": "Dedicated north and south ferry stairs separated passenger boats from the busiest cargo quays. Reliable harbour transfers, interpreters, lodging and repairs strengthened Tidecross's place on the continental crossing. The increase in trade also raised rents and intensified the unresolved struggle over priority berths and the fishing basin.",
            "calendarId": "caldris-common-era",
            "occurredAtMinute": -6307200,
            "precision": "era",
            "dateLabel": "The recent harbour expansion",
            "visibility": "public"
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.tidecross",
        "slot": "history"
      }
    },
    {
      "entityId": "chronology.caldris.tidecross.first-pilots",
      "name": "Fishing Stairs Become a Harbour",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.chronology",
          "value": {
            "status": "active",
            "title": "Fishing Stairs Become a Harbour",
            "summary": "Fishing families began guiding passing vessels into the island's sheltered eastern water. Their landing stairs became a place to buy fresh fish, water and local pilotage. Travellers waiting on the crossing rented rooms above net stores; the settlement that became Tidecross grew around this everyday work.",
            "calendarId": "caldris-common-era",
            "occurredAtMinute": -95000000,
            "precision": "era",
            "dateLabel": "The early harbour generations",
            "visibility": "public"
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.tidecross",
        "slot": "history"
      }
    },
    {
      "entityId": "chronology.caldris.tidecross.open-doors",
      "name": "The Night of Open Doors",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.chronology",
          "value": {
            "status": "active",
            "title": "The Night of Open Doors",
            "summary": "A violent storm drove ships from both continents into shelter and flooded the lower harbour. Islanders opened houses and workshops to stranded crews. Ferrymen and fishers worked rescue boats together. The shared meal and returning-bell custom remember those who came home and those who did not; afterwards the town built the stronger breakwater and Returning Light.",
            "calendarId": "caldris-common-era",
            "occurredAtMinute": -26000000,
            "precision": "era",
            "dateLabel": "The generation of the great harbour storm",
            "visibility": "public"
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.tidecross",
        "slot": "history"
      }
    },
    {
      "entityId": "fact.caldris.tidecross.crossing-stop",
      "name": "A Port Between Two Continents",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.fact",
          "value": {
            "status": "active",
            "summary": "Tidecross is one of the most frequently used ports of call between Eredane and Solasca. Ships replenish water and provisions, exchange cargo, hire pilots and repair damage here. Some sailings transfer passengers to another vessel; many simply wait for a useful wind. Ocean passages still take days and depend on route and season. Small harbour ferries shuttle between shore, outer anchorages and neighbouring islets; they are not a shortcut that turns the crossing into a river journey.",
            "provenance": "Tidecross harbour gazetteer; authored for the requested island port expansion.",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "location",
            "sensitivity": "open"
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.tidecross",
        "slot": "lore"
      }
    },
    {
      "entityId": "fact.caldris.tidecross.daily-life",
      "name": "A Town That Lives by Arrivals",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.fact",
          "value": {
            "status": "active",
            "summary": "The fishing auction starts before dawn, the market swells after each tender, and inn kitchens keep pots warm long after dark. Porters carry mixed cargoes through streets full of accents, sea chests and children sent to meet returning relatives. Fresh water comes from rain cisterns and supply vessels; wasteful captains pay more. During prolonged bad weather lodging spills into halls and private rooms, while the Mariners' House feeds stranded crews.",
            "provenance": "Tidecross harbour gazetteer; authored for the requested island port expansion.",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "location",
            "sensitivity": "open"
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.tidecross",
        "slot": "lore"
      }
    },
    {
      "entityId": "fact.caldris.tidecross.present-pressure",
      "name": "Who Owns the Water Stairs?",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.fact",
          "value": {
            "status": "active",
            "summary": "Tidecross's prosperity is pressing against its charter. Warehouse factors propose guaranteed priority berths to pay for a new quay; fishers fear losing Netters' Basin, and ferrymen fear that ordinary passengers will be priced off the landing steps. The wardens have announced public hearings, not a settled decision. Missing tariff copies, an overbooked sailing or a damaged water shipment can turn an ordinary day into work for a party willing to listen.",
            "provenance": "Tidecross harbour gazetteer; authored for the requested island port expansion.",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "location",
            "sensitivity": "open"
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.tidecross",
        "slot": "lore"
      }
    },
    {
      "entityId": "fact.caldris.tidecross.quay-charter",
      "name": "The Common Quay Promise",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.fact",
          "value": {
            "status": "active",
            "summary": "The Common Quay charter guarantees crews from either continent the same published tariff, access to fresh water and a hearing before goods are seized. A council of harbour wardens answers to fishers, ferrymen, shipwrights, householders and warehouse factors. It makes Tidecross useful to rivals who will not trust each other's home ports. Neutral business is hard work: the wardens hear disputes every market day, and everyone watches who receives the next berth.",
            "provenance": "Tidecross harbour gazetteer; authored for the requested island port expansion.",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "location",
            "sensitivity": "open"
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.tidecross",
        "slot": "lore"
      }
    },
    {
      "entityId": "fact.caldris.tidecross.returning-bell",
      "name": "The Bell for the Missing",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.fact",
          "value": {
            "status": "active",
            "summary": "Tide Market's old ship bell is reserved for a vessel thought lost that finally comes home. Its first ringing followed the storm remembered as the Night of Open Doors, when islanders housed strangers from both continents without asking who would pay. Families still prepare a shared meal when the bell sounds. The custom is affectionate and practical: a returned crew may have lost wages, possessions and friends even when its ship survives.",
            "provenance": "Tidecross harbour gazetteer; authored for the requested island port expansion.",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "location",
            "sensitivity": "open"
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.tidecross",
        "slot": "lore"
      }
    },
