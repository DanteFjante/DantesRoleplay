          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A modest public landing in Namarra with boat moorings, a covered waiting place, and a forwarding service. Its working records track changing channels and actual deliveries. The landing's visibility does not make confidential household lists public or settle the legal recognition of the communities its crews serve.",
            "visibility": "public",
            "status": "active"
          }
        },
