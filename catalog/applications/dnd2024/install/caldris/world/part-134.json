          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "settlement",
            "summary": "Saltmere stands on tidal islands joined by stone causeways and movable timber bridges. Royal offices share space with fish markets, salt warehouses, rescue houses, and legal chambers specialising in things that floated away.",
            "visibility": "public",
            "status": "active"
          }
        },
