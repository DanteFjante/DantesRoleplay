      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "settlement",
            "summary": "Stonewake is a northern port built behind a long breakwater of fitted dark stone. Ore, smoked fish, timber, and soldiers pass through it; so do rumours from beyond the Greyward Ocean.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 280,
