    {
      "entityId": "location.caldris.dunmarrow.saint-veys-crutch",
      "name": "Saint Vey's Crutch",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A narrow pass with an inn built around a bent pine said to have supported a wandering saint. Present pressure: An avalanche has closed the official road while an escort company monopolizes the safer goat path.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 815,
            "y": 650
          }
        }
      ],
      "containment": {
