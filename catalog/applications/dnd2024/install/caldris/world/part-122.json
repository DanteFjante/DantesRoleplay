    {
      "entityId": "location.caldris.tidecross.common-quay",
      "name": "The Common Quay",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "status": "active",
            "summary": "The port's working heart: laden sailing ships, cranes, customs tables and bonded warehouses crowd a stone waterfront. Harbourmaster Mara Venn chalks berth assignments on a board that anyone may inspect. Grain from Eredane passes sacks of Solascan spices; porters sort cargo by vessel marks rather than language. The quay charter requires the same published dues for both coasts. Its newest argument is whether paying for a longer berth means owning the steps beside it.",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 650,
            "y": 540
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.tidecross",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.tidecross.exchange-hall",
      "name": "The Two Shores Exchange",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "status": "active",
            "summary": "A long waterfront hall holds cargo brokers, interpreters, money changers and the Common Quay court. Its public scales and copied tariff protect crews unfamiliar with local measures. Merchants settle ordinary disagreements here before their vessels sail. The upper gallery is lined with names of rescuers from both continents; a proposal to sell priority docking rights has divided the elected harbour wardens.",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 613,
            "y": 381
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.tidecross",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.tidecross.fishing-basin",
      "name": "Netters' Basin",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "status": "active",
            "summary": "A sheltered basin reserved for the island's fishing boats, with low jetties, net lofts and a morning catch auction. Fishwife Sella Marr sells soup before she sells fish and knows which crews have returned short-handed. The fishing families supplied the first pilots and still claim rescue takes precedence over cargo work. They fear a proposed warehouse extension will swallow their last all-tide slip.",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 620,
            "y": 610
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.tidecross",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.tidecross.harbour-beacon",
      "name": "The Returning Light",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "status": "active",
            "summary": "The active lighthouse stands on the outer breakwater above a bell rung in fog. Its keepers mark channels, warn of changes in the shoals and coordinate boats going to ships in trouble. The light is funded by every cleared cargo and cannot be extinguished over unpaid dues under the charter. This is Tidecross's harbour light, distinct from the older Halfway Light in Morrow Strait.",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 913,
            "y": 484
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.tidecross",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.tidecross.lantern-inn",
      "name": "The Waiting Lantern",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "interior",
            "status": "active",
            "summary": "A broad inn beside Tide Market offers common bunks, family rooms, stew and a locked baggage cellar. Its notice wall lists ships seeking passengers or hands, missing luggage and letters waiting for collection. Host Tavin Pell keeps a few beds for crews whose vessels are detained or lost. The common room is the town's living timetable: pilots, cooks and passengers often know a departure has changed before a clerk does.",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 471,
            "y": 544
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.tidecross",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.tidecross.mariners-shrine",
      "name": "The Mariners' House",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "status": "active",
            "summary": "A modest shrine and shelter near the northern path welcomes mariners of different customs. Its keeper tends a memorial book, spare blankets and a kitchen supported by harbour subscriptions. Families leave a length of knotted cord while someone is away; safe arrivals untie one knot and help serve a meal. The institution grew from a rescue shelter, and its doors stay open even during trade disputes.",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 556,
            "y": 210
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.tidecross",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.tidecross.north-ferry",
      "name": "North Ferry Stairs",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "status": "active",
            "summary": "The arrival landing for harbour ferries and tenders meeting ships on the Eredane side of the roadstead. Ticket sheds, luggage scales and covered benches surround the water stairs. Ferrymaster Oren Bell keeps a separate place in each boat for people travelling to find work. These are local harbour crossings; onward passage between continents depends on a seaworthy vessel, a berth and weather, not an hourly ferry timetable.",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 688,
            "y": 307
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.tidecross",
        "slot": "location"
      }
    }
