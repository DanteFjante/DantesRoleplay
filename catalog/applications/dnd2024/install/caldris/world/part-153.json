    {
      "entityId": "location.caldris.lore.old-merecross",
      "name": "Old Merecross",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "Ancient ferry-settlement ruins near Bramblebridge, distinct from the living city of Merecross at the river confluence. Merecross is an archaeological layer beneath meadow and river silt near Bramblebridge, not a second thriving town. Some descendants of its inhabitants moved to the later bridge settlement. Drought exposes old ferry posts; exceptional floods reveal foundations and then conceal them again.",
            "visibility": "public",
            "status": "active"
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.atlas.bramble-country",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.orrel-wood",
      "name": "Orrel Wood",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "Location: North of the Alderwake road. Livelihood: Managed coppice, charcoal, mushrooms, and limited timber cutting. The wood has been felled and regrown in sections many times. Hart's Mouth remains an identifiable limestone sink, surrounded by younger trees. A modest shrine commemorates Branna and, in newer inscriptions, her companions. Forest workers know reliable paths that romantic visitor maps omit.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 795,
            "y": 230
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.atlas.orchard-march",
        "slot": "location"
      }
    },
