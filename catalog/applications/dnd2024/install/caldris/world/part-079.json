{
  "format": "dantesroleplay.world-package/1",
  "rootEntityId": "world.caldris",
  "entities": [
    {
      "entityId": "secret.caldris.lore.0069-a-small-light-in-an-unrepaired-room-traces-and-stories.1",
      "name": "A Small Light in an Unrepaired Room — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "A pane loan, material purchases, and instructions written for inexperienced keepers. A present quest can recover the correct mounting or identify a charm altered during a later repair. Returning a useful object may fulfil a promise while forcing a community to plan for its absence.",
            "provenance": "history-100-50-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0073-the-bells-returned-from-storage-gm-truth.1",
      "name": "The Bells Returned from Storage — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Teren could not identify every bell confidently. He marked uncertain conclusions, but a later commemorative booklet omitted those qualifications. An honest uncertainty in the workshop book is more useful than the booklet's neat list of unquestioned returns.",
            "provenance": "history-100-50-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0073-the-bells-returned-from-storage-traces-and-stories.1",
      "name": "The Bells Returned from Storage — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Depot inventories, incompatible brackets, and agreements over shared ownership. A present restoration can identify a bell's travels or reveal that a supposedly ancient civic custom began with a post-war compromise.",
            "provenance": "history-100-50-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0077-the-price-of-opening-a-road-again-gm-truth.1",
      "name": "The Price of Opening a Road Again — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Ossa favoured one branch partly because her sibling's household lived there. The route was also the most repairable within the available budget. The decision deserves examination of both facts rather than automatic vindication or dismissal.",
            "provenance": "history-100-50-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0077-the-price-of-opening-a-road-again-traces-and-stories.1",
      "name": "The Price of Opening a Road Again — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Repair vouchers, competing route maps, and notices advertising houses for sale. A present expedition can distinguish an abandoned settlement from a battlefield and recover useful knowledge about why a road was given up.",
            "provenance": "history-100-50-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0081-the-names-house-at-rookwater-gm-truth.1",
      "name": "The Names House at Rookwater — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Nera refused to circulate one located deserter's address after receiving credible threats against his new household. A restricted note explains the decision. Whether descendants should learn that history requires attention to the people affected, not just excitement at resolving a mystery.",
            "provenance": "history-100-50-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0081-the-names-house-at-rookwater-traces-and-stories.1",
      "name": "The Names House at Rookwater — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Search notices, forwarding records, corrected death reports, and property inventories. A present investigation may discover a survivor's later household or explain why an inheritance was divided unexpectedly. Finding someone alive does not automatically make every later arrangement fraudulent.",
            "provenance": "history-100-50-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0083-the-first-protected-grain-sailing-gm-truth.1",
      "name": "The First Protected Grain Sailing — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "One checkpoint admitted passengers using a provisional form before its final authorisation arrived. The official responsible accepted a personal risk because delay would have stranded vulnerable travellers. The irregular papers are genuine evidence of passage, not automatically forged documents.",
            "provenance": "history-100-50-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0083-the-first-protected-grain-sailing-traces-and-stories.1",
      "name": "The First Protected Grain Sailing — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Accord travel papers, inspection marks, passenger lists, and competing cargo claims. A present quest can connect a displaced person to a recorded sailing or establish how a protected route acquired its later local obligations.",
            "provenance": "history-100-50-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0085-the-winter-of-common-shovels-gm-truth.1",
      "name": "The Winter of Common Shovels — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The established account of the Empty Saddles conceals several survivors who deserted and lived under new names. The Courteous Ruin's caretaker deliberately used childhood nicknames to help officers recognise kinship. Neither secret should become common knowledge merely because this chapter places the incidents within the same winter.",
            "provenance": "history-100-50-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0085-the-winter-of-common-shovels-traces-and-stories.1",
      "name": "The Winter of Common Shovels — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Mixed tool marks, repair tallies, local testimony, and orders written after the work began. A present dispute over the bank's care may involve families whose ancestors worked beside people later described only as enemies.",
            "provenance": "history-100-50-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0087-the-siege-that-consumed-its-wagons-gm-truth.1",
      "name": "The Siege That Consumed Its Wagons — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "One commander knowingly exaggerated the redoubt's remaining supplies to obtain reinforcements. The deception prolonged a failing operation and increased losses. The decisive comparison lies between ration issues and outgoing reports, not a conveniently preserved confession.",
            "provenance": "history-100-50-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0087-the-siege-that-consumed-its-wagons-traces-and-stories.1",
      "name": "The Siege That Consumed Its Wagons — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Contradictory orders, patched wagon fittings, and unfinished siege works. A disputed object might carry marks from both armies because it changed owners repeatedly. Reconstructing a local truce can explain why someone crossed a line without necessarily betraying their neighbours.",
            "provenance": "history-100-50-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0089-the-grain-convoys-under-three-banners-gm-truth.1",
      "name": "The Grain Convoys under Three Banners — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Nera concealed a small reserve to feed drivers after officers diverted official rations. It was an unauthorised act with a practical purpose. A later accusation of hoarding omits the distribution notes kept in her personal book.",
            "provenance": "history-100-50-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0089-the-grain-convoys-under-three-banners-traces-and-stories.1",
      "name": "The Grain Convoys under Three Banners — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Requisition receipts, wagon marks, levy lists, and a road map annotated with repair failures. A present journey can locate a forgotten depot or establish whether goods were stolen, purchased, or taken under a promise of later compensation.",
            "provenance": "history-100-50-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0095-the-inheritance-with-two-seals-gm-truth.1",
      "name": "The Inheritance with Two Seals — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Alis privately accepted a narrower settlement than her employers would announce. Daro preserved that proposal rather than destroying it when talks failed. Its existence can complicate a family legend of uncompromising honour without proving that every participant was secretly insincere.",
            "provenance": "history-100-50-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0095-the-inheritance-with-two-seals-traces-and-stories.1",
      "name": "The Inheritance with Two Seals — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Draft settlements, sealed copies, and instructions sent privately to delegates. A present investigation can distinguish a document's authenticity from the authority later claimed for it. Recovering a discarded compromise may reveal an option that leaders knowingly rejected.",
            "provenance": "history-100-50-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0099-the-spring-of-full-inns-gm-truth.1",
      "name": "The Spring of Full Inns — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Mara promised more covered space than the yard initially possessed. Neighbours supplied temporary awnings in exchange for future bookings. The improvised arrangement worked, but its undocumented first season later made several legitimate claims difficult to prove.",
            "provenance": "history-100-50-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0099-the-spring-of-full-inns-traces-and-stories.1",
      "name": "The Spring of Full Inns — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Freight bookings, musicians' programmes, cart purchases, and correspondence between new business partners. A present quest might trace an object first shipped through the yard or recover the agreement behind a family's lost business share.",
            "provenance": "history-100-50-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0100-0050-place-low-fen-redoubt.1",
      "name": "Low Fen Redoubt — history and story material",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "location",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Present-day form: Overgrown wartime earthworks in the Vey Lowlands around the foundations of a former depot. Later drainage has altered parts of the site. Local households use nearby grazing while keeping known unstable pits marked; small finds are recorded inconsistently. A person to meet: Surveyor Mera Dast wants to distinguish depot remains from later dumping before contractors level a section for access. Adventure: Recover a wagon plate, locate an inventory cache, or trace goods taken under wartime authority. Flooded storage pits and unstable works provide physical danger without requiring undead soldiers to inhabit every battlefield.",
            "provenance": "history-100-50-years-ago.md",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    }
  ],
