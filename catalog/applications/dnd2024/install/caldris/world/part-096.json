  "rootEntityId": "world.caldris",
  "entities": [
    {
      "entityId": "secret.caldris.lore.1174-the-road-of-bitter-leaves-traces-and-stories.1",
      "name": "The Road of Bitter Leaves — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Small brewing pots; leaf-storage jars with dated seals; Rima's sharply worded guesthouse notes. A merchant asks travellers to verify whether a premium cargo came from the named terraces or was relabelled along the route.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1187-the-lantern-at-the-end-of-the-pier-gm-truth.1",
      "name": "The Lantern at the End of the Pier — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Faris's ghost did not become the spirit. Lastlight imitates some of his habits without possessing his memories. It cannot answer questions about his missing brother, whose eventual fate remains a separate human story.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1187-the-lantern-at-the-end-of-the-pier-traces-and-stories.1",
      "name": "The Lantern at the End of the Pier — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Oil accounts kept beside memorial names; successive lamp housings preserving an older inner bracket; farewell ribbons on later railings. A present light that keeps failing may need repairs and a renewed arrangement rather than a ritual of banishment.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1199-the-fair-beneath-the-sailcloth-gm-truth.1",
      "name": "The Fair Beneath the Sailcloth — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "One celebrated donation was a purchase quietly financed by local stallholders. Harbour patrons received most of the public credit because they could afford commemorative banners.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1199-the-fair-beneath-the-sailcloth-traces-and-stories.1",
      "name": "The Fair Beneath the Sailcloth — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Sailmakers' marks preserved in accounts; unusual tent-post sockets beneath later paving; a fair dish called Storm Supper. A scrap of canvas in a shrine can identify a ship whose recorded voyages never included the port that supposedly donated it.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1215-the-book-of-roads-left-open-gm-truth.1",
      "name": "The Book of Roads Left Open — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "No complete, current master copy exists in the campaign present. Reconstructing one region is a feasible adventure. The book provides leads and imperfect testimony, never an answer to every mystery or a substitute for visiting the people who live along the roads now.",
            "provenance": "history-1600-1200-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1215-the-book-of-roads-left-open-traces-and-stories.1",
      "name": "The Book of Roads Left Open — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Different regional editions; abandoned-route annotations; notices directing readers to other archives. Finding two copies can reveal both a lost place and why travellers stopped going there.",
            "provenance": "history-1600-1200-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1232-the-summer-of-the-travelling-stage-gm-truth.1",
      "name": "The Summer of the Travelling Stage — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Ilren knew his popular play was inaccurate and presented it as entertainment. Fraud arose later when collectors sold its painted props as genuine relics. Popular storytelling also preserved material that formal archives had ignored.",
            "provenance": "history-1600-1200-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1232-the-summer-of-the-travelling-stage-traces-and-stories.1",
      "name": "The Summer of the Travelling Stage — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Painted stage boards reused in a loft; prompt notes; a wagon wheel carved with places visited. A seemingly impossible historical clue becomes understandable once a theatrical scene is separated from the older song embedded inside it.",
            "provenance": "history-1600-1200-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1249-the-lantern-road-turns-south-gm-truth.1",
      "name": "The Lantern Road Turns South — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The spirit's consent matters because the stones are its home, not because moving them would certainly unleash a catastrophe. A future relocation problem should allow negotiation and evidence from earlier repairs rather than rely on an invented automatic curse.",
            "provenance": "history-1600-1200-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    }
