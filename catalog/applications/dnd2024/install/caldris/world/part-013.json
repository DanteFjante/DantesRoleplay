    {
      "entityId": "dnd2024.rule.combat.weapon-attacks",
      "name": "Weapon Attacks",
      "components": [
        {
          "qualifiedTypeId": "game.core.rules.readable",
          "value": {
            "section": {
              "id": "combat",
              "label": "Combat",
              "order": 20
            },
            "order": 10,
            "title": "Weapon Attacks",
            "summary": "A weapon attack resolves its attack roll and, on a hit, applies the weapon activity's recorded damage through the active combat mechanics.",
            "blocks": [
              {
                "kind": "steps",
                "heading": "Resolution",
                "body": null,
                "items": [
                  "Choose the acting character, target, and recorded weapon activity.",
                  "Resolve the attack roll against the target's current defense.",
                  "If the attack hits, resolve the activity's damage and the target's recorded damage responses."
                ]
              },
              {
                "kind": "callout",
                "heading": "Recorded state wins",
                "body": "The readable rule never substitutes browser calculations for the active weapon-attack mechanic.",
                "items": []
              }
            ],
            "examples": [
              {
                "title": "Different weapon activities",
                "body": "A weapon definition can expose distinct melee, thrown, one-handed, or two-handed activities. The selected activity determines the authoritative mechanic input."
              }
            ],
            "relatedRuleRefs": [
              {
                "entityId": "dnd2024.rule.characters.character-sheet"
              },
              {
                "entityId": "dnd2024.rule.resting.long-rests"
              }
            ],
            "relatedContentRefs": [],
            "citations": [
