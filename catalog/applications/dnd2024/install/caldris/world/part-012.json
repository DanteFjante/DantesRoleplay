  "entities": [
    {
      "entityId": "chronology.caldris.lore.1976-the-war-of-false-weights",
      "name": "The War of False Weights",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.chronology",
          "value": {
            "status": "active",
            "title": "The War of False Weights",
            "summary": "Trouble began when three neighbouring market authorities certified incompatible measures under the same name. Traders bought wool by one stone and sold it by another; tenants owed rents whose meaning changed at the estate boundary. A confiscated caravan led to reprisals. For two years, armed households seized scales, burned toll shelters, and detained merchants. Later ballads supplied great battles that contemporary burial records do not support. Most suffering came from missed planting, stolen animals, and villages cut off from salt. Sella Venn, a travelling assayer, proposed publicly accessible reference weights and the right to witness a weighing. Merchant houses opposed the expense until a fraudulent shipment embarrassed their own patrons.",
            "calendarId": "caldris-common-era",
            "occurredAtMinute": -999684000,
            "precision": "era",
            "dateLabel": "1,976–1,969 years ago",
            "visibility": "public"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "chronology.caldris.lore.1984-the-orchard-compact",
      "name": "The Orchard Compact",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.chronology",
          "value": {
            "status": "active",
            "title": "The Orchard Compact",
            "summary": "An orchard district survived a succession of late frosts unusually well. Its farmers credited a spirit called the Guest Beneath the Boughs, who appeared as a mud-stained old person with blossom caught in their hair. The oldest compact required an unharvested strip of orchard, protection for nesting birds, and a shared meal when the first fruit ripened. The Guest sheltered blossoms against a few nights of frost; the farmers maintained the habitat on which the orchards depended. The compact prospered because both sides worked. A visiting religious house recorded the agreement and offered witnesses for later renewals. Some clergy regarded the Guest as a neighbour; others called it an affliction. The disagreement never divided neatly between kind villagers and cruel priests: several tenants welcomed the clergy because orchard owners were charging them for access to supposedly sacred fruit.",
            "calendarId": "caldris-common-era",
            "occurredAtMinute": -999756000,
            "precision": "era",
            "dateLabel": "1,984–1,977 years ago",
            "visibility": "public"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "chronology.caldris.lore.1992-the-road-of-seven-suppers",
      "name": "The Road of Seven Suppers",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.chronology",
          "value": {
            "status": "active",
            "title": "The Road of Seven Suppers",
            "summary": "Recovery depended on moving seed and livestock between valleys. Seven households agreed that a traveller carrying a recognised wooden tally could receive supper and a place beside the fire, then repay the hospitality through work or goods at another participating house. Derren Vale, a muleteer with an unreliable singing voice, carried the first settlement accounts. The elven traveller Aveline Sere accompanied him for four seasons while collecting small household spells. She remembered the journey as a brief, pleasant interruption. Derren built the rest of his life around it. These stopping places established a practical route across the hills. Parts of it are proposed predecessors of the present Lantern Road, although floods, enclosures, and changing markets would later move its course.",
            "calendarId": "caldris-common-era",
            "occurredAtMinute": -999828000,
            "precision": "era",
            "dateLabel": "1,992–1,985 years ago",
            "visibility": "public"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "chronology.caldris.lore.2000-the-winter-of-borrowed-hearths",
      "name": "The Winter of Borrowed Hearths",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.chronology",
          "value": {
            "status": "active",
            "title": "The Winter of Borrowed Hearths",
            "summary": "Three poor harvests culminated in a winter that closed the upland tracks. Smoke rose from fewer chimneys as families gathered in the houses with sound roofs. The chalk-cut storage chambers of the Button Hills became communal granaries, guarded by shepherds and opened before witnesses. Maelin Rusk, a widow responsible for weighing grain, refused to use the measures brought by the estate collectors: their baskets had grown larger since the last harvest. She measured distributions in an ordinary household cooking pot. Her decision saved several hamlets from surrendering seed grain as rent and made her a criminal in the surviving estate accounts. The hill communities adopted the custom of leaving a small portion of supper beside the hearth for an absent traveller. Over time, hospitality replaced hunger in the explanation.",
            "calendarId": "caldris-common-era",
            "occurredAtMinute": -999900000,
            "precision": "era",
            "dateLabel": "2,000–1,993 years ago",
            "visibility": "public"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "chronology.caldris.sundering-of-seals",
      "name": "The Sundering of Seals",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.chronology",
          "value": {
            "status": "active",
            "title": "The Seals Were Sundered",
            "summary": "Local rulers, guilds, temples, and communities rejected Concord demands after famine, archive seizures, and violent enforcement. Roads survived, but authority splintered and many records disappeared into private hands.",
            "calendarId": "caldris-common-era",
            "occurredAtMinute": -398930400,
            "precision": "approximate",
            "dateLabel": "116 BS",
            "visibility": "public"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "history"
      }
    },
    {
      "entityId": "chronology.caldris.three-banner-war",
      "name": "The Three Banner War",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.chronology",
          "value": {
            "status": "active",
            "title": "The Three Banner War Ended",
            "summary": "A costly struggle over succession, grain passage, and mutual defense ended without a satisfying victor. Its memorials and surviving veterans still shape law, diplomacy, and ordinary fear of another war.",
            "calendarId": "caldris-common-era",
            "occurredAtMinute": -43624800,
            "precision": "exact",
            "dateLabel": "560 AS — eighty-three years ago",
            "visibility": "public"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "history"
      }
    },
