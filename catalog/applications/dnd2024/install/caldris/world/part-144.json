    },
    {
      "entityId": "location.caldris.veyr-marches.redgate",
      "name": "Redgate",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "settlement",
            "summary": "Redgate surrounds the rust-red stone arch where nine march roads meet. The High Warden's moot, escort market, banner court, and sprawling inns make it a capital only when everyone agrees.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 480,
            "y": 450
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.veyr-marches",
