    {
      "entityId": "location.caldris.veyr-marches.foxglove-relay",
      "name": "Foxglove Relay",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "Hilltop courier station breeding small hardy horses and drying purple flowers for safe medicinal trade. Present pressure: Messages arrive resealed but apparently unread.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 660,
            "y": 320
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.veyr-marches",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.veyr-marches.ninepost-field",
      "name": "Ninepost Field",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "Neutral meadow where nine carved posts mark grazing, court, market, and muster rights for different marches. Present pressure: A tenth post appears overnight with convincing weathering.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 420,
            "y": 280
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.veyr-marches",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.veyr-marches.oakshield",
      "name": "Oakshield",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "settlement",
            "summary": "Oakshield guards forest passes with layered timber walls designed to be repaired, not admired. It exports horses, charcoal, leather, and excellent preserved mushrooms.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 725,
            "y": 635
          }
        }
