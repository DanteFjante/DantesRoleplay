      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "Roofless border manor where travelers still follow elaborate guest customs preserved by its caretaker family. Present pressure: Armed claimants demand the keys to a house with no doors.",
