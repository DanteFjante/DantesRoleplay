    {
      "entityId": "location.caldris.tessarane.the-patient-stair",
      "name": "The Patient Stair",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "Thousands of shallow steps carry pilgrims, salt, and pack animals over a high pass. Present pressure: Sections have been rearranged, sending travelers in circles.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 155,
            "y": 575
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.tessarane",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.tessarane.the-thirteen-shadows",
