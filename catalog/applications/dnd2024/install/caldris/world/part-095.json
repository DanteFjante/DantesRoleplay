{
  "format": "dantesroleplay.world-package/1",
  "rootEntityId": "world.caldris",
  "entities": [
    {
      "entityId": "secret.caldris.lore.1048-the-mill-that-ground-for-both-banks-traces-and-stories.1",
      "name": "The Mill That Ground for Both Banks — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Mismatched mill fittings; a wall bearing names in different hands; repair accounts connecting formerly hostile villages. A modern restoration may uncover why a particular family's name was added later and in smaller letters.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1061-the-seven-month-war-gm-truth.1",
      "name": "The Seven-Month War — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "There was no hidden mastermind requiring the war to occur. Political ambition, fearful assumptions, and profitable opportunities were enough. Several leaders understood the costs and continued anyway.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1061-the-seven-month-war-traces-and-stories.1",
      "name": "The Seven-Month War — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Requisition tallies; a battlefield beneath later orchards; contradictory muster rolls. Recovering a soldier's effects may identify someone counted as a deserter who was buried under the wrong unit's name.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1074-the-bridge-of-untied-ribbons-gm-truth.1",
      "name": "The Bridge of Untied Ribbons — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Jalen left a few tasks unfinished because he had lost interest, not because every item concealed a final wish. His daughter chose which were worth completing. Ysra learned to respect that choice.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1074-the-bridge-of-untied-ribbons-traces-and-stories.1",
      "name": "The Bridge of Untied Ribbons — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Repair notes dividing work among apprentices; a bridge song with a verse about taking a ribbon down; a fiddle with a replaced neck. A restoration commission can reveal several owners' lives rather than one pristine heroic object.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1087-the-silver-that-would-not-travel-gm-truth.1",
      "name": "The Silver That Would Not Travel — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The policy and the official's fraud were distinct. Not every loss was stolen, and proving a coin genuine does not establish that it ever held the value its owner claims.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1087-the-silver-that-would-not-travel-traces-and-stories.1",
      "name": "The Silver That Would Not Travel — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Clipped sample coins in an assayer's board; two-price account books; a market rhyme about a king's thin face. An apparently counterfeit hoard may contain legitimate issues that circulated under different values.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1099-the-orchard-behind-the-wall-gm-truth.1",
      "name": "The Orchard Behind the Wall — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The Guest did not wake or command the outcome. The settlement was a human achievement, and the bowl's discovery was a consequence of digging rather than evidence of approval from the sleeper.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1099-the-orchard-behind-the-wall-traces-and-stories.1",
      "name": "The Orchard Behind the Wall — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "A narrow lane turning sharply around a wall; copied access agreements; a modest offering bowl displayed elsewhere for protection. A later blocked passage can be investigated through use and renewal rather than an assumption that an ancient spirit owns every nearby field.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1109-the-night-of-a-hundred-names-gm-truth.1",
      "name": "The Night of a Hundred Names — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The gathering did not use a perfect magical means of identifying the dead. Its strength came from combining incomplete records and accepting when they did not justify certainty.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1109-the-night-of-a-hundred-names-traces-and-stories.1",
      "name": "The Night of a Hundred Names — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "A register separating confirmed identifications from possibilities; small personal effects; an annual practice of reading unresolved names. A new annotation in a later copy can offer the next lead in a case that several generations failed to settle.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1122-the-companions-of-the-late-blossom-gm-truth.1",
      "name": "The Companions of the Late Blossom — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Ysra and Jalen were friends and working companions. Later love ballads invent a romance. Their affection was real without needing the relationship those songs supplied.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1122-the-companions-of-the-late-blossom-traces-and-stories.1",
      "name": "The Companions of the Late Blossom — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "A joint notebook alternating plant sketches and tune fragments; repaired instruments marked with a leaf; a scent cloth in a sealed keepsake box. A missing plant name can be reconstructed from where the companions performed rather than from botanical description alone.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1135-the-meeting-of-three-widows-gm-truth.1",
      "name": "The Meeting of Three Widows — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "One founder concealed a payment to a family outside the rules, then repaid it gradually from her own share. The institution's survival owed something to both firm limits and personal generosity that the public accounts did not explain.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1135-the-meeting-of-three-widows-traces-and-stories.1",
      "name": "The Meeting of Three Widows — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Boat marks paired with household names; contribution tallies; an old chest repaired with timbers from a wreck. An ancient claim can reveal a family's history, but modern entitlement depends on later continuity and terms, not possession of a weathered token alone.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1148-the-island-of-the-wrong-stars-gm-truth.1",
      "name": "The Island of the Wrong Stars — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The stars are a recorded pattern, not a prophecy or a doorway into the sky. The court's builders may connect to the wider glassworking tradition, but this chapter does not establish who built it or why the island was abandoned.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1148-the-island-of-the-wrong-stars-traces-and-stories.1",
      "name": "The Island of the Wrong Stars — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Glass in shoreline rubble; a temporary screen described in expense records; warning marks in later pilot books. Renewed exposure after erosion can justify a return expedition with practical preparations and a clear danger to address.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1161-the-queen-of-the-second-table-gm-truth.1",
      "name": "The Queen of the Second Table — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Maressa sometimes favoured a compelling personal story over a less eloquent but stronger claim. Later correspondence records corrections. Access to a sympathetic ruler helped people and remained an uneven form of justice.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1161-the-queen-of-the-second-table-traces-and-stories.1",
      "name": "The Queen of the Second Table — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Kitchen-side petition rolls; furniture accounts for an ordinary trestle table; renewed grazing stones. A supposed secret royal chamber may be the service room where petitioners once waited with borrowed bowls of soup.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1174-the-road-of-bitter-leaves-gm-truth.1",
      "name": "The Road of Bitter Leaves — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The unfashionable leaves were not poisonous or fraudulent. Changing taste ruined some honest growers. Counterfeit prestige and actual quality must be investigated separately.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    }
