        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.veyrs-lantern",
      "name": "Veyr's Lantern",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A rough landing, seabird cliffs, and partially buried foundations reached only in suitable conditions. Erosion has changed access and may uncover screened glass. No continuously inhabited lighthouse settlement is established by its name.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 160,
            "y": 325
