  "rootEntityId": "world.caldris",
  "entities": [
    {
      "entityId": "location.caldris.lore.dunmere-steps",
      "name": "Dunmere Steps",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "Dunmere survives as a name for an old lower quarter of Highmead. Most ancient structures have been replaced, but a market stair incorporates original weighing stones. Bakers leave flowers on one step each year without agreeing whose grave it commemorates.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 510,
            "y": 755
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.alderwick.highmead",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.lastlight-pier",
      "name": "Lastlight Pier",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A modest landing rebuilt along the old line, used by local fishers and people walking the shore. The lamp has successive outer housings around an older internal bracket. Supplies and maintenance have passed between households; the spirit's continued residence is a working present-day premise, not evidence that its wooden shelter survived untouched.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 190,
            "y": 615
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lore.leth-sarai",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.mothwatch-kiln",
      "name": "Mothwatch Kiln",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A pottery workshop and small examination room in Leth Sarai. Its older kiln is maintained with ordinary masonry, and dangerous objects are handled in rooms with mechanical closures. The public collection includes harmless fired vessels and copies of historical warnings.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 765,
            "y": 220
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lore.leth-sarai",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.rainbell-orchard",
      "name": "Rainbell Orchard",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A small nursery plot within Boughmeet's growing district. Ordinary fruit trees support the maintenance of a few carefully propagated rainbell pears. A sheltered festival instrument sounds only when rainwater reaches its dried seed cases; replacement parts are recorded by harvest year.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 570,
            "y": 395
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lore.boughmeet",
        "slot": "location"
      }
    }
  ],
