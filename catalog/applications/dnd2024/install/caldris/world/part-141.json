          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "Sheltered highland orchard producing small pale fruit and hosting astronomers during clear winters. Present pressure: Every telescope points slightly wrong despite careful calibration.",
