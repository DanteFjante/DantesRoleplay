      }
    },
    {
      "entityId": "location.caldris.seven-lamps-league.the-fifth-warehouse",
      "name": "The Fifth Warehouse",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "Neutral bonded store with four visible buildings and a famous joke about the missing fifth. Present pressure: Inventories show goods entering a warehouse no one can find.",
