    {
      "entityId": "location.caldris.seven-lamps-league.chairmans-nap",
      "name": "Chairman's Nap",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "Roadside inn founded where a League chair once slept through a vote; meetings there cannot exceed one hour. Present pressure: Delegates exploit the rule to prevent testimony from remote villages.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 575,
            "y": 260
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.seven-lamps-league",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.seven-lamps-league.glassharbor",
      "name": "Glassharbor",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "settlement",
            "summary": "Glassharbor produces windows, mirrors, lenses, beads, bottles, and elaborate navigational lights. Its furnaces glow along a sheltered bay.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 165,
            "y": 585
          }
        }
      ],
      "containment": {
