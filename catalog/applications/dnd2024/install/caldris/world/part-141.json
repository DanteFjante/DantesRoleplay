      }
    },
    {
      "entityId": "location.caldris.seven-lamps-league.halfprice-bridge",
      "name": "Halfprice Bridge",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "Merchant-funded toll bridge whose fee drops at sunset, producing a daily race of carts and insults. Present pressure: The bridge keeper abolishes the discount without council authority.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 630,
            "y": 490
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.seven-lamps-league",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.seven-lamps-league.low-lantern",
      "name": "Low Lantern",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "settlement",
            "summary": "Low Lantern occupies marshy islands at the northern strait. Warehouses, rope bridges, customs houses, and cheap lodging make it less grand and more useful than the other League cities.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 165,
            "y": 735
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.seven-lamps-league",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.seven-lamps-league.pepperglass-yard",
      "name": "Pepperglass Yard",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "Courtyard where spice brokers use coloured glass tubes to compare powders without revealing recipes. Present pressure: Every sample smells faintly of smoke and buyers suspect adulteration.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 755,
            "y": 655
          }
        }
      ],
      "containment": {
