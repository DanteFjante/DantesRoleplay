{
  "format": "dantesroleplay.world-package/1",
  "rootEntityId": "world.caldris",
  "entities": [
    {
      "entityId": "secret.caldris.lore.1835-the-guest-winter-at-whitewindow-traces-and-stories.1",
      "name": "The Guest Winter at Whitewindow — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Paired surface and subterranean measurements on bridge stones; a winter board game; a guest register written in two hands. A damaged tunnel contains the missing eastern end of the old causeway and evidence of why contact stopped.",
            "provenance": "history-1900-1600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1848-the-white-hart-of-orrel-wood-gm-truth.1",
      "name": "The White Hart of Orrel Wood — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The hart was a predatory spirit that fed on exhausted, disoriented prey. Its motives were not a misunderstood demand for worship. The hunt ended its life, but a shed antler retained a weaker power to misdirect and was never recovered.",
            "provenance": "history-1900-1600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1848-the-white-hart-of-orrel-wood-traces-and-stories.1",
      "name": "The White Hart of Orrel Wood — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "A sinkhole called Hart's Mouth; trail marks cut below normal eye level; antler fragments sealed in a shrine. A modern disappearance follows the old pattern, inviting investigation of the pool and the shrine before assuming the dead creature has returned.",
            "provenance": "history-1900-1600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1861-the-orchard-that-could-not-grow-gm-truth.1",
      "name": "The Orchard That Could Not Grow — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "One stone marks a burial, not the magical boundary. Tessa asked that it resemble the others so her partner could remain among the trees without attracting pilgrims. A literal reconstruction from all twelve stones gives the wrong shape.",
            "provenance": "history-1900-1600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1861-the-orchard-that-could-not-grow-traces-and-stories.1",
      "name": "The Orchard That Could Not Grow — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Twelve stones, several later moved; old graft names preserved in nursery catalogues; a feast dish made from bruised fruit. A newly discovered stone would place an abandoned orchard inside the sheltered boundary, but the Guest must still be willing and able to renew the agreement.",
            "provenance": "history-1900-1600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1874-the-three-daughters-of-the-river-gm-truth.1",
      "name": "The Three Daughters of the River — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The three daughters of later legend were not Ceryn's children. They were the three river lordships, represented as women in an early ceremonial painting. Several later pedigrees were built on a literal reading of that picture.",
            "provenance": "history-1900-1600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1874-the-three-daughters-of-the-river-traces-and-stories.1",
      "name": "The Three Daughters of the River — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "River stones bearing three interlaced reeds; a drowned tollhouse; boat songs that praise Ceryn while mocking her relatives. A recovered navigation chart records a branch channel through supposedly impassable marsh.",
            "provenance": "history-1900-1600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1887-the-founding-of-alderwake-fair-gm-truth.1",
      "name": "The Founding of Alderwake Fair — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The original peace deliberately protected some debtors fleeing abusive patrons. Ysolde understood the loophole and preserved it. It did not protect violence committed inside the fair.",
            "provenance": "history-1900-1600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1887-the-founding-of-alderwake-fair-traces-and-stories.1",
      "name": "The Founding of Alderwake Fair — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Carved stall marks; a marriage custom involving four knots; a fair peace bell with successive replacement clappers. A fugitive claims protection under a later renewal of the fair charter, forcing its current keeper to decide whether the protection covers the alleged offence.",
            "provenance": "history-1900-1600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1899-the-autumn-without-a-debt-gm-truth.1",
      "name": "The Autumn Without a Debt — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Only three cups received any enchantment, a modest charm that slowed the cooling of a drink. Iven made hundreds of unenchanted copies. Their real historical value is evidence of where ordinary people travelled.",
            "provenance": "history-1900-1600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    }
