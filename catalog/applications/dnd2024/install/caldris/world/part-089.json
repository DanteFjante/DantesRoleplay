  "entities": [
    {
      "entityId": "secret.caldris.lore.0527-the-gardens-of-the-farther-window-traces-and-stories.1",
      "name": "The Gardens of the Farther Window — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Labels recording failures; seed orders; wall repairs made to alter shelter. A present garden problem can be solved by recognising that a celebrated method worked under different conditions.",
            "provenance": "history-600-500-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0535-the-empty-seat-of-the-road-court-gm-truth.1",
      "name": "The Empty Seat of the Road Court — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Orra was not certain which claim would ultimately prevail. Her decision protected a fairer hearing rather than disguising a predetermined result.",
            "provenance": "history-600-500-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0535-the-empty-seat-of-the-road-court-traces-and-stories.1",
      "name": "The Empty Seat of the Road Court — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Adjourned calendars; notices carried by named messengers; a chair painted on courthouse signs. A supposedly final ancient ruling may actually be a temporary order issued while testimony was still outstanding.",
            "provenance": "history-600-500-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0543-the-chalk-stag-at-rusk-hollow-gm-truth.1",
      "name": "The Chalk Stag at Rusk Hollow — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The stag was an old household emblem. Its resemblance to a famous monster is coincidental. The older niche remains a separate historical question.",
            "provenance": "history-600-500-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0543-the-chalk-stag-at-rusk-hollow-traces-and-stories.1",
      "name": "The Chalk Stag at Rusk Hollow — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "A chalk carving with later protective marks; rescue payments; a plan separating successive building phases. A future opening can reveal the niche's occupants or more of the storage complex without repeating the same rescue.",
            "provenance": "history-600-500-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0551-the-quiet-archive-of-serevan-gm-truth.1",
      "name": "The Quiet Archive of Serevan — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The strongest candidate was Leris Amat, an assistant involved in preparing glass surfaces. This chapter establishes a credible candidate, not a complete proof or the recovery of the full letter. A later adventure can find the missing corroboration.",
            "provenance": "history-600-500-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0551-the-quiet-archive-of-serevan-traces-and-stories.1",
      "name": "The Quiet Archive of Serevan — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Index cards made from reused cargo labels; annotated name comparisons; references to material subsequently moved elsewhere. Comparing handwriting, dates, and workshop roles can advance the search for the assistant's identity.",
            "provenance": "history-600-500-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0559-the-menders-procession-gm-truth.1",
      "name": "The Menders' Procession — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "One celebrated signature belongs to an apprentice who completed the work after the named master fell ill. The master deliberately asked for the apprentice to receive credit.",
            "provenance": "history-600-500-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0559-the-menders-procession-traces-and-stories.1",
      "name": "The Menders' Procession — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Hidden repair signatures; objects bearing both the original maker and later menders; a song naming tools in working order. Identifying a repairer's mark can explain a relic's unexpected materials or travels.",
            "provenance": "history-600-500-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0567-the-winter-at-crowstep-gm-truth.1",
      "name": "The Winter at Crowstep — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The predator was an ordinary dangerous animal, not an ancient winter deity. The host's advance planning saved more lives than the brief confrontation.",
            "provenance": "history-600-500-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0567-the-winter-at-crowstep-traces-and-stories.1",
      "name": "The Winter at Crowstep — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Feed tallies; a surviving list of shared chores; a route note marking a safer winter descent. Restocking the shelter offers a reason for a present expedition to compare the old route with changed terrain.",
            "provenance": "history-600-500-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0575-the-highmead-marriage-refused-gm-truth.1",
      "name": "The Highmead Marriage Refused — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "No hidden lover caused the refusal. Alin disliked the proposed life and said so. Neither party needed to become a villain for the marriage not to happen.",
            "provenance": "history-600-500-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0575-the-highmead-marriage-refused-traces-and-stories.1",
      "name": "The Highmead Marriage Refused — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "A cancelled wedding order repurposed as a shipping ledger; cloth seals; two incompatible love songs. A collector seeking a lost lover's name might discover a more useful history of an independent household.",
            "provenance": "history-600-500-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0583-the-silver-eels-of-penns-reach-gm-truth.1",
      "name": "The Silver Eels of Penn's Reach — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The creature helped a limited stretch of water suit its own needs. It promised no perpetual harvest. The useful agreement among the fishers remained necessary after it stopped appearing.",
            "provenance": "history-600-500-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0583-the-silver-eels-of-penns-reach-traces-and-stories.1",
      "name": "The Silver Eels of Penn's Reach — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Trap-spacing marks; a festival dish eaten from shared platters; descriptions of the willow pool. An apparently vanished local wonder may have moved after a later channel change rather than died or withdrawn in anger.",
            "provenance": "history-600-500-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0591-the-house-with-twelve-windows-gm-truth.1",
      "name": "The House with Twelve Windows — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Orrin could barely read when the school opened. He became one of its earliest adult pupils and never stopped being embarrassed by the ceremonial inscription crediting his wisdom.",
            "provenance": "history-600-500-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0591-the-house-with-twelve-windows-traces-and-stories.1",
      "name": "The House with Twelve Windows — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Slates bearing several learners' hands; windows with panes replaced across centuries; a meal list more complete than the surviving roll of pupils. A neglected account can identify an anonymous donor or restore credit to a teacher omitted from a patron's monument.",
            "provenance": "history-600-500-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0599-the-last-lesson-in-seln-gm-truth.1",
      "name": "The Last Lesson in Seln — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Her death was natural and final in this history. A later story that she walked into the singing grove confuses her burial procession with departure. The Listener is a separate place-spirit and contains none of her memories.",
            "provenance": "history-600-500-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0599-the-last-lesson-in-seln-traces-and-stories.1",
      "name": "The Last Lesson in Seln — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Several independent copies of her last corrections; a returned-tool receipt; a tune identified by its successive arrangers. A future search can recover a useful observation without requiring Ysra to be alive or her grave to contain an undiscovered weapon.",
            "provenance": "history-600-500-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0609-the-festival-of-unfinished-journeys-gm-truth.1",
      "name": "The Festival of Unfinished Journeys — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The festival did not close every case or reconcile every family. Some people did not want to be found. Its keepers distinguished a public historical puzzle from a living person's right to choose their relationships.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
