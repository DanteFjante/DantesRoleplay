      "name": "The Bent Penny",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "Function and texture: Pawnbroker, repair counter, second-hand clothing, discreet messages. Current pressure: A supposedly worthless brooch belongs to three living claimants.",
            "visibility": "public",
            "status": "active"
          }
        }
      ],
      "containment": {
