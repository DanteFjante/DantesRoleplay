{
  "format": "dantesroleplay.world-package/1",
  "rootEntityId": "world.caldris",
  "entities": [
    {
      "entityId": "location.caldris.lore.saffron-court",
      "name": "Saffron Court",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A busy courtyard market in Namar Vale with shared ovens, washing places, and a mixture of permanent and daily stalls. Its name remains grander than most of its meals. The reserved newcomer places survive through later lease renewals that vendors must occasionally defend.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 335,
            "y": 550
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lore.namar-vale",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.seven-scripts-court",
      "name": "Seven Scripts Court",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "Small workrooms around a courtyard, occupied by translators, copyists, and several unrelated businesses. The old name survives despite changes in its languages and organisation. Its oldest records are mostly later copies with identifiable chains of transmission.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 680,
            "y": 355
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lore.namar-vale",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.sunborrow-house",
      "name": "Sunborrow House",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A communal workroom in Seln with two surviving enchanted panes, one unreliable, and an ordinary replacement where the third once stood. Its summer gathering frame was moved during a later rebuilding. Keepers maintain both fuel stores and an illumination rota.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 665,
            "y": 665
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lore.seln",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.the-copper-kettle",
      "name": "The Copper Kettle",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A modest inn near Boughmeet's orchard road, rebuilt around successive kitchens. Blue pottery fragments form a small hearth mosaic, with replacement pieces documented by later keepers. A working copy of Nivren's boot-drying charm hangs beside the wet-weather bench. Most visitors come for food and shelter rather than the old story.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 440,
            "y": 190
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lore.boughmeet",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.the-dry-exchange",
      "name": "The Dry Exchange",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A covered trading hall in Brinefold with raised document rooms and a public counter for inspecting registered cargo pledges. Its rules have been revised under successive authorities. Carved fish on the older beam ends commemorate the early dispute over promises made against the same catch.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 355,
            "y": 325
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lore.brinefold",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.the-evening-market",
      "name": "The Evening Market",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A modest market yard in Brinefold where sailors, craftspeople, and households sell used equipment and small consignments after the working day. Inspection rules and fees reflect later amendments. Repaired awnings cover stalls carrying practical goods alongside occasional objects with unusual histories.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 650,
            "y": 480
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lore.brinefold",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.the-green-awning-yard",
      "name": "The Green Awning Yard",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A freight assembly yard in Brinefold with repaired awnings, shared weighing space, and places rented by independent carriers. Its earliest arrangements have been replaced or renewed over time. The spring gathering survives intermittently when trade and local organisers can support it.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 320,
            "y": 655
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lore.brinefold",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.the-hall-of-unsent-maps",
      "name": "The Hall of Unsent Maps",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A chart collection and copying business in Leth Sarai. Working extracts are updated as reports arrive; historical drafts retain their original qualifications. Restricted charts have custody records, and decorative copies are identified separately from surveys intended for travel.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 690,
            "y": 670
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lore.leth-sarai",
        "slot": "location"
      }
    }
  ],
