    {
      "entityId": "location.caldris.bramblebridge.tibbs-watch-post",
      "name": "Tibb's Watch Post",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "Function and texture: One-room civic watch office with maps, rejected poems, spare boots, and labelled string. Current pressure: A map drawn as a romantic gift accurately predicts a smuggler path Tibb has never walked.",
            "visibility": "public",
            "status": "active"
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.bramblebridge",
        "slot": "location"
