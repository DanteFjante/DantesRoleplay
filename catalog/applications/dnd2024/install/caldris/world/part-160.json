    {
      "entityId": "location.caldris.lore.ashglass-house",
      "name": "Ashglass House",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A glass workshop in Istravel with a small repair room and a collection of clearly labelled failed experiments. Most of its business is ordinary glass. Its modest enchanted vessels require careful handling, compatible materials, and occasional renewal by someone who understands their particular binding.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 350,
            "y": 330
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lore.istravel",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.cinder-meadow",
      "name": "Cinder Meadow",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A recovering meadow and nursery margin in Boughmeet's growing country. Later fires and planting changes have altered the ground. A few protected impressions are documented as surviving evidence of the ember herons; visitors can also see casts that are clearly labelled as copies.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 800,
            "y": 245
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lore.boughmeet",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.dunmere-steps",
      "name": "Dunmere Steps",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "Dunmere survives as a name for an old lower quarter of Highmead. Most ancient structures have been replaced, but a market stair incorporates original weighing stones. Bakers leave flowers on one step each year without agreeing whose grave it commemorates.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 510,
            "y": 755
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.alderwick.highmead",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.lastlight-pier",
      "name": "Lastlight Pier",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A modest landing rebuilt along the old line, used by local fishers and people walking the shore. The lamp has successive outer housings around an older internal bracket. Supplies and maintenance have passed between households; the spirit's continued residence is a working present-day premise, not evidence that its wooden shelter survived untouched.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 190,
            "y": 615
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lore.leth-sarai",
        "slot": "location"
      }
    }
  ],
