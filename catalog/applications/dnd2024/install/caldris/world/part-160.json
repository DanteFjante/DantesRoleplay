      "name": "The Crooked Saint",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "Function and texture: Tiny bridge shrine repaired so often no original material remains. Current pressure: Travellers leave unfamiliar copper tokens that are legal nowhere nearby.",
            "visibility": "public",
            "status": "active"
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.bramblebridge",
        "slot": "location"
