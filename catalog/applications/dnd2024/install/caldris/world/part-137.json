        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "status": "active",
            "summary": "A lighthouse island in the Lantern Sea, maintained jointly by four states that agree it belongs to none of them. The Halfway Light guides ships through Morrow Strait and shelters people brought ashore by its rescue crews. Four keeper households share watches, stores and a common ledger; no state may close the landing to another's mariners. A supply cutter brings lamp oil, provisions and replacement hands when weather permits. Stone paths connect the beacon, keeper court, fog bell and lifeboat ramp. Unlike the busy port of Tidecross, this small station exists to keep the passage visible and bring people home.",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.visual",
          "value": {
