    {
      "entityId": "location.caldris.lore.redbank-reach",
      "name": "Redbank Reach",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "Location: On the main river downstream of the Bramblebridge area and upstream of Reedminster. Livelihood: Barges, mills, pasture, and a working ferry near later bridges. Redbank's unfinished piers remain as heavily eroded stone islands, altered by salvage and repair. King's Span was replaced more than once and is now represented by abutments near a newer crossing. The shared district outlived the original peace only through later arrangements, some of which still influence local identity.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 340,
            "y": 175
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lore.vey-lowlands",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.reedminster",
      "name": "Reedminster",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "settlement",
            "summary": "Location: A low island in the lower Vey river system, upstream of the tidal ports. Livelihood: Reed work, gardens, ferry service, and donations for hospitality. Its buildings have been repeatedly raised above flood level. A landing shelter stands outside the devotional precinct, preserving the distinction between accepting hospitality and joining worship. Old guest rules survive through generations of commentary, including disagreements written neatly in the margins.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 575,
            "y": 580
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lore.vey-lowlands",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.reth-gate",
      "name": "Reth Gate",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "settlement",
            "summary": "A local administrative and lodging cluster in the former Reth jurisdiction. Its current rulers and borders remain for later history to establish. The old tollhouse is partly a shelter, with marks where removable sleeping platforms once fitted.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 470,
            "y": 665
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.atlas.roven-approaches",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.ribbon-bridge",
      "name": "Ribbon Bridge",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "Several replacement bridges have occupied the crossing. Ribbons are now tied to a separate frame so they do not obstruct inspections. Households remove them after a return, a confirmed death, or a decision to stop waiting; the meanings differ and are not publicly policed.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 640,
            "y": 455
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.atlas.orchard-march",
        "slot": "location"
      }
    }
  ],
