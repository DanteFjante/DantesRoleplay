    {
      "entityId": "location.caldris.alderwick.kings-patience-wood",
      "name": "King's Patience Wood",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "Managed oak woodland supplying bridge beams, charcoal, pannage, and the kingdom's slowest official hunting lodge. Present pressure: Foresters and villagers dispute emergency cutting after storm damage.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
