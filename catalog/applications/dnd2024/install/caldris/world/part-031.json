    {
      "entityId": "fact.caldris.landmark.crownroot-cathedral.custom",
      "name": "Crownroot Cathedral — Customs",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.fact",
          "value": {
            "status": "active",
            "summary": "The first ripe fruit is shared after a meal rather than auctioned. A graft must be accompanied by the name of the person who tended its parent tree. Sellers rent tables by the day; they cannot purchase a permanent root alcove. No pilgrimage fee buys a promise of frost protection.",
            "provenance": "Nine Wonders of Caldris; reconciled with the existing chronology before campaign play.",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "location",
            "sensitivity": "open"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "fact.caldris.landmark.crownroot-cathedral.gmtruth",
      "name": "Crownroot Cathedral — Keeper truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "location",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "One celebrated branch was quietly replaced after disease killed it. Its fruit is excellent, but a merchant markets it as the unchanged scion of the original compact. Exposing the claim threatens honest gardeners as well as the merchant. The Guest's limited capacity remains limited; the tree cannot be used to extend protection across all Alderwick by selling cuttings.",
            "provenance": "Nine Wonders of Caldris; reconciled with the existing chronology before campaign play.",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "fact.caldris.landmark.crownroot-cathedral.hooks",
      "name": "Crownroot Cathedral — Story seeds",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "location",
            "sensitivity": "secret"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The old teacher returns and finds the pupil she remembers as a boy preparing to retire. A lucrative new fruit variety threatens the unharvested bird strip. Two villages each possess a sound but incompatible record of a donated branch, and both need its crop to fund their winter kitchen.",
            "provenance": "Nine Wonders of Caldris; reconciled with the existing chronology before campaign play.",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "fact.caldris.landmark.crownroot-cathedral.lore",
      "name": "Crownroot Cathedral — Lore",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.fact",
          "value": {
            "status": "active",
            "summary": "Crownroot is a later daughter sanctuary of the Orchard Compact associated with Harth, not the original compact's birthplace. Successive grafts, living root columns and repeated soil work explain much of its size; small sheltering spells supplement that labour. The Guest Beneath the Boughs has been offered a place here on several occasions, but a vast canopy is not proof that the Guest protects every nearby field. The human grafter Oswin Pell keeps an empty seat for his former elven teacher, who last visited thirty-seven years ago. Historical threads: The Orchard Compact; The Orchard that Counted Birds.",
            "provenance": "Nine Wonders of Caldris; reconciled with the existing chronology before campaign play.",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "location",
            "sensitivity": "open"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "fact.caldris.landmark.emberglass-whale.access.da0b776d65",
