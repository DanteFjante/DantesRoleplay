    },
    {
      "entityId": "fact.caldris.ganji-elvish-lessons",
      "name": "An Improper Silence",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.fact",
          "value": {
            "status": "active",
            "summary": "An elven sect-brother felt it improper that Ganji didn't speak Elvish, and privately taught him the language during free hours.",
            "provenance": "Ganji's own account",
            "visibility": "party"
          }
        },
        {
