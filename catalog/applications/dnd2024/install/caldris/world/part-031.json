    {
      "entityId": "fact.caldris.ganji-escape",
      "name": "Ganji's Departure",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.fact",
          "value": {
            "status": "active",
            "summary": "Two weeks ago, Ganji left the Tensor Sect in the dark of night and has been travelling the Lantern Road toward Bramblebridge since.",
            "provenance": "Witnessed by Ganji himself",
            "visibility": "party"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "discreet"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "knowledge"
      }
    },
    {
      "entityId": "fact.caldris.ganji-musician-friend",
      "name": "The Old Musician",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.fact",
          "value": {
            "status": "active",
            "summary": "An old traveling musician once stayed at the Tensor Sect for a short time. Music wasn't permitted within the Sect's walls, so he played just outside them instead -- where Ganji, sneaking out from his required hours of solitary religious study, heard him. The two struck a quiet bargain not to tell on each other, became friends over the musician's short stay, and Ganji learned to play the flute from him. It was Ganji's first real experience of music, and part of why he later carved his quarterstaff to double as one.",
            "provenance": "Witnessed by Ganji himself",
            "visibility": "party"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "knowledge"
      }
    },
    {
      "entityId": "fact.caldris.ganji-unbidden-eye",
      "name": "The Unbidden Eye",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.fact",
          "value": {
            "status": "active",
            "summary": "The Tensor Sect named Ganji 'the Unbidden Eye,' believing his birth fulfilled an old teaching about a student who sees before learning how to look.",
            "provenance": "Tensor Sect internal teaching, known to Ganji and sect members",
            "visibility": "party"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "identity",
            "sensitivity": "discreet"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "knowledge"
      }
    },
    {
