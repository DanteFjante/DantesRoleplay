{
  "format": "dantesroleplay.world-package/1",
  "rootEntityId": "world.caldris",
  "entities": [
    {
      "entityId": "fact.caldris.custom.bellafont.rain-letters",
      "name": "Rain Letters",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.fact",
          "value": {
            "status": "active",
            "summary": "Orchard workers leave anonymous encouragement in preserve jars at roadside shelters. Disagreement: Court poets claim to have invented it; workers insist the custom is older. Story use: A threatening message violates the form in ways that reveal its writer.",
            "provenance": "Caldris history and lore atlas",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "open"
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.bellafont",
        "slot": "knowledge"
      }
    },
    {
      "entityId": "fact.caldris.custom.bellafont.the-blunt-dessert",
      "name": "The Blunt Dessert",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.fact",
          "value": {
            "status": "active",
            "summary": "Difficult negotiations end with an intentionally ugly but delicious tart. Disagreement: Nobles debate its symbolism; cooks say it prevents people pretending appearance is substance. Story use: Refusing or praising it communicates more than formal speeches.",
            "provenance": "Caldris history and lore atlas",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "open"
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.bellafont",
        "slot": "knowledge"
      }
    },
    {
      "entityId": "fact.caldris.custom.carrowmere.blue-roof-reckoning",
      "name": "Blue Roof Reckoning",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.fact",
          "value": {
            "status": "active",
            "summary": "Families paint a rescued tile with the name of the wreck it came from. Disagreement: Some names belong to smuggling craft officially declared never to exist. Story use: A roof becomes an accidental archive of maritime secrets.",
            "provenance": "Caldris history and lore atlas",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "open"
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.carrowmere",
        "slot": "knowledge"
      }
    },
    {
      "entityId": "fact.caldris.custom.carrowmere.the-dry-admirals-toast",
      "name": "The Dry Admiral's Toast",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.fact",
          "value": {
            "status": "active",
            "summary": "Retired captains toast a voyage that never occurred, adding one implausible detail each year. Disagreement: One “joke” detail consistently matches covert wartime charts. Story use: Players must separate affectionate nonsense from encoded testimony.",
            "provenance": "Caldris history and lore atlas",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "open"
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.carrowmere",
        "slot": "knowledge"
      }
    },
    {
      "entityId": "fact.caldris.custom.dunmarrow.a-rook-owes-one-blow",
      "name": "A Rook Owes One Blow",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.fact",
          "value": {
            "status": "active",
            "summary": "Smiths pause after a rook perfectly copies a hammer rhythm. Disagreement: Miners say it remembers the dead; smiths say the pause prevents fatigue. Story use: A rook repeats a rhythm used only in a supposedly sealed workshop.",
            "provenance": "Caldris history and lore atlas",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "open"
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.dunmarrow",
        "slot": "knowledge"
      }
    },
    {
      "entityId": "fact.caldris.custom.dunmarrow.crutch-courtesy",
      "name": "Crutch Courtesy",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.fact",
          "value": {
            "status": "active",
            "summary": "At mountain inns, the least mobile guest chooses the first seat and safest departure time. Disagreement: Escort captains treat it as quaint; locals treat it as survival law. Story use: Invoking courtesy can defeat a dangerous monopoly without drawing steel.",
            "provenance": "Caldris history and lore atlas",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "open"
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.dunmarrow",
        "slot": "knowledge"
      }
    },
    {
      "entityId": "fact.caldris.custom.kethria.the-shield-loaf",
      "name": "The Shield Loaf",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.fact",
          "value": {
            "status": "active",
            "summary": "A household breaks its stamped winter loaf only after confirming neighbors also have bread. Disagreement: Wealthy homes treat it symbolically; mountain villages still conduct the check. Story use: Missing flour becomes a network of mutual aid rather than a solitary theft.",
            "provenance": "Caldris history and lore atlas",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "open"
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.kethria",
        "slot": "knowledge"
      }
    },
    {
      "entityId": "fact.caldris.custom.kethria.the-unridden-saddle",
      "name": "The Unridden Saddle",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.fact",
          "value": {
            "status": "active",
            "summary": "One saddle remains empty on dangerous crossings so the dead or lost are not forgotten. Disagreement: Some survivors consider it comforting; others see a lie that prevents searches. Story use: Removing a saddle can be grief, evidence, or protection.",
            "provenance": "Caldris history and lore atlas",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "open"
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.kethria",
        "slot": "knowledge"
      }
    },
    {
      "entityId": "fact.caldris.custom.lornesse.goat-judgment",
      "name": "Goat Judgment",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.fact",
          "value": {
            "status": "active",
            "summary": "Grazing disputes are argued before an elected “goat judge,” who announces a practical compromise. Disagreement: Outsiders think the goat decides; locals know the decorated animal keeps tempers down. Story use: An antagonist dismisses the ritual and loses community trust before a serious hearing.",
            "provenance": "Caldris history and lore atlas",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "open"
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lornesse",
        "slot": "knowledge"
      }
    },
    {
      "entityId": "fact.caldris.custom.lornesse.the-missing-echo",
      "name": "The Missing Echo",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.fact",
          "value": {
            "status": "active",
            "summary": "Workers stop immediately if a familiar echo fails to return. Disagreement: Priests call it mountain displeasure; engineers call it changing voids. Story use: Both interpretations point toward real danger through different evidence.",
            "provenance": "Caldris history and lore atlas",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "open"
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lornesse",
        "slot": "knowledge"
      }
    },
    {
      "entityId": "fact.caldris.custom.namarra.paper-boats-carry-small-truths",
      "name": "Paper Boats Carry Small Truths",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.fact",
          "value": {
            "status": "active",
            "summary": "Children float unsigned worries to a trusted downstream elder. Disagreement: Adults debate whether reading them violates privacy or fulfills the custom. Story use: A paper fleet contains unrelated fears plus one crucial warning.",
            "provenance": "Caldris history and lore atlas",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "open"
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.namarra",
        "slot": "knowledge"
      }
    },
    {
      "entityId": "fact.caldris.custom.namarra.three-spoons-no-fourth",
      "name": "Three Spoons, No Fourth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.fact",
          "value": {
            "status": "active",
            "summary": "Communal kitchens use three serving spoons for children, workers, and guests. Disagreement: Reformers want a fourth for officials; cooks consider officials guests. Story use: A seating dispute reveals who expects privilege during crisis.",
            "provenance": "Caldris history and lore atlas",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "open"
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.namarra",
        "slot": "knowledge"
      }
    },
    {
      "entityId": "fact.caldris.custom.ordelain.black-pawed-testimony",
      "name": "Black-Pawed Testimony",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.fact",
          "value": {
            "status": "active",
            "summary": "An ink-stained cat crossing a courtroom pauses proceedings for water. Disagreement: Judges insist it is hygiene, not luck; everyone still watches which party the cat approaches. Story use: A light comic beat exposes tampered ink on a litigant's sleeve.",
            "provenance": "Caldris history and lore atlas",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "open"
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.ordelain",
        "slot": "knowledge"
      }
    },
    {
      "entityId": "fact.caldris.custom.ordelain.curved-boundaries-are-wiser",
      "name": "Curved Boundaries Are Wiser",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.fact",
          "value": {
            "status": "active",
            "summary": "Farmers preserve bends in hedges and paths even after rivers move. Disagreement: Lawyers call it superstition; flood workers recognize lost channels. Story use: A “nonsensical” boundary becomes a life-saving drainage map.",
            "provenance": "Caldris history and lore atlas",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "open"
          }
        }
      ],
      "containment": {
