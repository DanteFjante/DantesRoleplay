    {
      "entityId": "fact.caldris.dossier.lornesse",
      "name": "Polity dossier — Lornesse",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.fact",
          "value": {
            "status": "active",
            "summary": "Lornesse — mountains, bells, and things under stone. Land and livelihood: Lornspine valleys, silver, copper, slate, timber, goats, alpine pasture, Rule: Queen-Mother Eda serves as regent for a capable but underage king, advised by valley Character: careful speech, communal work, resonant bell traditions, cliffside hospitality, Magic: rune claims are mostly craft notation and property marks; genuine magic is rare and Old wound: Concord debt enforcers sealed entire mine communities during the Sundering. Current pressure: new chambers beneath Copperdeep contain fresh soot and a tithe niche too",
            "provenance": "Caldris world bible — polity dossiers",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "state",
            "sensitivity": "open"
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lornesse",
        "slot": "knowledge"
      }
    },
    {
