    {
      "entityId": "fact.caldris.dossier.veyr-marches",
      "name": "Polity dossier — Veyr Marches",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.fact",
          "value": {
            "status": "active",
            "summary": "Veyr Marches — many banners, one difficult road. Land and livelihood: eastern passes, mixed forest and pasture, horse breeding, timber, Rule: nine marches elect a High Warden for life while preserving separate laws and rival Character: practical pluralism, fierce local identity, excellent roadside food, competitive Magic: local customs vary widely; the Warden's law focuses on harmful acts rather than Old wound: several marches backed different sides in the war and later invented a story of Current pressure: the dying High Warden's likely successors include a strict reformer, a",
            "provenance": "Caldris world bible — polity dossiers",
            "visibility": "public"
          }
        },
        {
