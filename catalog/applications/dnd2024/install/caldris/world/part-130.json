    {
      "entityId": "location.caldris.alderwick.dunwarren",
      "name": "Dunwarren",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "settlement",
            "summary": "Dunwarren controls the eastern forest roads and supplies beams, charcoal, carts, and bow staves. Its walls incorporate living oaks protected by charter, making maintenance both impressive and botanically argumentative.",
            "visibility": "public",
            "status": "active"
          }
        }
      ],
