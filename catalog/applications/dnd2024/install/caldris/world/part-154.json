    {
      "entityId": "location.caldris.lore.low-fen-redoubt",
      "name": "Low Fen Redoubt",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "Overgrown wartime earthworks in the Vey Lowlands around the foundations of a former depot. Later drainage has altered parts of the site. Local households use nearby grazing while keeping known unstable pits marked; small finds are recorded inconsistently.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 290,
            "y": 565
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lore.vey-lowlands",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.morrowstep-sanctuary",
      "name": "Morrowstep Sanctuary",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A small sanctuary above a coastal road serving the western approaches to Morrow Strait. Its guest rooms and workshop are used more often than its ceremonial hall. Different communities preserve different explanations of the unlit-lamp emblem.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 210,
            "y": 680
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lore.vey-lowlands",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.nacre-quay",
      "name": "Nacre Quay",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "settlement",
            "summary": "Location: A sheltered coastal inlet south of Veymouth. Livelihood: Coastal cargo, fishing, rope work, and marine repair. The original night harbour is now a shallow boat basin within a larger, repeatedly rebuilt port. Old shell marks survive on stones reused in warehouses. Its rivalry with Veymouth is expressed as often through rowing contests and insulting pastries as through serious commercial competition.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 470,
            "y": 885
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lore.vey-lowlands",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.namar-vale",
      "name": "Namar Vale",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "settlement",
            "summary": "A settlement of shaded yards, carriers' lodging, potteries, and leaf warehouses near irrigated cultivation. Fine imported goods pass through, but most residents earn a living from ordinary growing, carrying, repairs, and food. Old survey lines are preserved unevenly beneath later subdivisions.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 490,
            "y": 530
          }
        },
