  "entities": [
    {
      "entityId": "location.caldris.lore.lanterns-end",
      "name": "Lanterns' End",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "Location: On the coast beyond Veymouth's river mouth, overlooking the approaches from Morrow Strait. Livelihood: Pilotage, sheep grazing, and maintenance of a coastal light. Successive towers stand on and beside the low observatory's foundations. Some carved sight lines still point usefully across the water; others refer to vanished sandbanks. The sea has eaten part of the old keeper's garden.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 320,
            "y": 780
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lore.vey-lowlands",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.leth-sarai",
      "name": "Leth Sarai",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "settlement",
            "summary": "A densely inhabited old quarter behind a rebuilt waterfront. Courtyards hold workshops, kitchens, and shared wells. Buildings have changed occupants and functions many times; old signs survive beneath paint or in reused lintels. The town trades in ordinary necessities as well as fine goods.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 160,
            "y": 585
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.visual",
          "value": {
