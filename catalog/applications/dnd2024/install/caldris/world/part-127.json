        {
          "qualifiedTypeId": "game.core.world.motive",
          "value": {
            "status": "active",
            "summary": "Tired bridge keeper with impeccable safety habits and a hobby painting tiny cheerful tollbooths. Wants the bridge closed without causing a riot; reads timber movement and crowds; broke procedure by hiding the cracks. Answerable to rival League councils. She accepts investigation if engineers, not politicians, control reopening.",
            "visibility": "party"
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.seven-lamps-league",
