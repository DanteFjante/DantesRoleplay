      "name": "Sister Dema Voss",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.motive",
          "value": {
            "status": "active",
            "summary": "Strict Mosquito Abbey healer who labels everything, including chairs, and secretly writes sentimental bird poems. Wants remedies distributed by need; tracks fever patterns and drainage; fears reform will empty stores before the worst month. Debates the Seed Mothers' Compact. Reliable resupply and transparent triage move her from restriction to coalition.",
            "visibility": "party"
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.namarra",
        "slot": "people"
      }
    },
