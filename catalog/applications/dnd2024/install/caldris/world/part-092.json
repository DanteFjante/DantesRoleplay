  "rootEntityId": "world.caldris",
  "entities": [
    {
      "entityId": "secret.caldris.lore.0799-the-spring-of-floating-doors-traces-and-stories.1",
      "name": "The Spring of Floating Doors — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Mud lines inside older buildings; lists of borrowed boats; household marks on reused doors. A later exposed deposit may contain objects from several settlements, so find location alone does not prove original ownership.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0809-the-first-feast-of-two-harvests-gm-truth.1",
      "name": "The First Feast of Two Harvests — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The gathering produced no universal crop or perfect harmony. Several visitors returned home disappointed. Its success lay in continuing exchange after people learned what would not work.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0809-the-first-feast-of-two-harvests-traces-and-stories.1",
      "name": "The First Feast of Two Harvests — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Trial beds bearing regional names; a recipe combining dried fruit with local grain; musical notation beside plant records. A forgotten failed trial may explain why a tempting modern planting would harm a particular soil or water arrangement.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0822-the-goat-path-and-the-painted-road-gm-truth.1",
      "name": "The Goat Path and the Painted Road — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Nerin did not sabotage the project. Her warnings were accurate. Later critics blamed her caution for the patron's embarrassment, while the smaller route continued supporting useful trade.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0822-the-goat-path-and-the-painted-road-traces-and-stories.1",
      "name": "The Goat Path and the Painted Road — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Different line conventions in related maps; pack-frame fragments; warehouse fees recording mixed transport. Reopening an old route may require local hauling services rather than engineering a grand road nobody can afford to maintain.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0835-the-parcel-that-had-arrived-somewhere-else-gm-truth.1",
      "name": "The Parcel That Had Arrived Somewhere Else — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The reference piece was a marked calibration blank for comparison during glass preparation, not a key or recorded farewell. The letter concerned an earlier disagreement and an unfinished act of thanks. This resolves the parcel's arrival while leaving its full wording and the later custody of its contents available for discovery.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0835-the-parcel-that-had-arrived-somewhere-else-traces-and-stories.1",
      "name": "The Parcel That Had Arrived Somewhere Else — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "An opening receipt; corrections attributed through a workshop rather than a famous author; a failed delivery address. A present search can follow the dispersed contents and the missing personal letter rather than pursue a parcel still waiting unopened.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0848-the-market-of-borrowed-tongues-gm-truth.1",
      "name": "The Market of Borrowed Tongues — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "No single enchanted translation device made this work unnecessary. Skilled interpretation remained about context, intent, custom, and accountability as well as vocabulary.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0848-the-market-of-borrowed-tongues-traces-and-stories.1",
      "name": "The Market of Borrowed Tongues — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Parallel-language summaries; tablets listing disputed cloth grades; marginal explanations written for apprentices. A supposed secret code may be an ordinary mixture of languages used by people who shared a trade but not a first language.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0861-the-crown-carried-in-a-bread-cart-gm-truth.1",
      "name": "The Crown Carried in a Bread Cart — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The baker, Orris Den, charged a fair hiring fee and refused a permanent court appointment. He preferred a predictable business and his own bed. His refusal was neither an insult nor evidence of secret allegiance.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    }
