    {
      "entityId": "secret.caldris.lore.0015-the-porch-at-the-last-mile-traces-and-stories.1",
      "name": "The Porch at the Last Mile — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
