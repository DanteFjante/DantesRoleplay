{
  "format": "dantesroleplay.world-package/1",
  "rootEntityId": "world.caldris",
  "entities": [
    {
      "entityId": "secret.caldris.lore.1899-the-autumn-without-a-debt-traces-and-stories.1",
      "name": "The Autumn Without a Debt — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "A broken cup links an otherwise unrecorded settlement to the early road. A collector wants an entire kiln excavated; the land's occupants need it left undisturbed until after harvest.",
            "provenance": "history-1900-1600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1909-the-lantern-settlement-gm-truth.1",
      "name": "The Lantern Settlement — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The settlement's steward organised that theft with the consent of two delegates. Their unauthorised compensation helped keep the peace but established a secret that could be mistaken for simple corruption.",
            "provenance": "history-2000-1900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1909-the-lantern-settlement-historical-traces.1",
      "name": "The Lantern Settlement — Historical traces",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Lamp niches beside gates; complaint stones in old market squares; a kitchen lantern described in inventories as an object of state.",
            "provenance": "history-2000-1900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1909-the-lantern-settlement-quest-seeds.1",
      "name": "The Lantern Settlement — Quest seeds",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "A road fund's founding document contains an overlooked obligation to a neglected hamlet. Recovering the missing silver lamp reveals it was broken up to compensate displaced ferrymen.",
            "provenance": "history-2000-1900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1919-the-last-supper-at-the-seventh-house-gm-truth.1",
      "name": "The Last Supper at the Seventh House — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Aveline paid with years of service: she agreed to bring the house one living guest each autumn for the remainder of this century. The guests were free to leave. She learned to arrange her travels around an annual promise. Whether she or the spirit survives into the present is deliberately unresolved.",
            "provenance": "history-2000-1900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1919-the-last-supper-at-the-seventh-house-historical-traces.1",
      "name": "The Last Supper at the Seventh House — Historical traces",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "A pear tree repeatedly grafted onto younger stock; an empty chair at certain roadside feasts; a song that loses a companion in each verse.",
            "provenance": "history-2000-1900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1919-the-last-supper-at-the-seventh-house-quest-seeds.1",
      "name": "The Last Supper at the Seventh House — Quest seeds",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Reassemble Derren's letters from household collections. An inn unexpectedly sets places for the party's dead acquaintances; determine whether the invitation is kindness, misunderstanding, or somebody exploiting an old custom.",
            "provenance": "history-2000-1900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1928-the-empty-storehouses-gm-truth.1",
      "name": "The Empty Storehouses — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Blocked ventilation caused much of the spoilage, but the footsteps belonged to a small household spirit carrying out instructions from dead custodians. It moved grain out of the damp, unintentionally mixing seed stocks and ownership marks. There is both an engineering problem and a lonely neighbour to deal with.",
            "provenance": "history-2000-1900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1928-the-empty-storehouses-historical-traces.1",
      "name": "The Empty Storehouses — Historical traces",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Protective marks carved over tally scratches; blocked ventilation channels; bronze clothing fasteners washed out of spoil heaps—one proposed source of the hills' later association with buttons.",
            "provenance": "history-2000-1900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1928-the-empty-storehouses-quest-seeds.1",
      "name": "The Empty Storehouses — Quest seeds",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "A sinkhole exposes a chamber that someone has recently cleaned. Investigate nocturnal footsteps while keeping curious children away from unstable workings.",
            "provenance": "history-2000-1900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1936-the-house-of-returning-names-gm-truth.1",
      "name": "The House of Returning Names — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Meret sheltered fugitives by recording some of them as dead. One much-celebrated reunion was a carefully arranged escape. Her records are valuable testimony, never infallible proof.",
            "provenance": "history-2000-1900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1936-the-house-of-returning-names-historical-traces.1",
      "name": "The House of Returning Names — Historical traces",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Name boards reused in later buildings; anonymous graves paired with occupational symbols; a custom of giving one's home village before requesting a bed.",
            "provenance": "history-2000-1900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1936-the-house-of-returning-names-quest-seeds.1",
      "name": "The House of Returning Names — Quest seeds",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Deliver an ancient personal effect to a long-lived recipient, if that person survives. Identify a nameless grave before roadworks move it. Resolve two families' incompatible claims to the same ancestor.",
            "provenance": "history-2000-1900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1944-the-eighty-day-crown-gm-truth.1",
      "name": "The Eighty-Day Crown — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The grant is authentic. One witness continued using her deceased husband's commercial identity because the council would not recognise her independent business. Proving the truth could also expose unrelated family property claims.",
            "provenance": "history-2000-1900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1944-the-eighty-day-crown-historical-traces.1",
      "name": "The Eighty-Day Crown — Historical traces",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Cloth seals resembling coins; a comic play about a crowned accountant; pasture stones with their inscriptions turned inward.",
            "provenance": "history-2000-1900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1944-the-eighty-day-crown-quest-seeds.1",
      "name": "The Eighty-Day Crown — Quest seeds",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "A grazing dispute sends travellers searching for the original grants. A claimant produces a convincing copy whose witnesses include someone supposedly dead before it was signed.",
            "provenance": "history-2000-1900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1952-the-bell-above-the-water-gm-truth.1",
      "name": "The Bell Above the Water — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The system was deliberately disabled once so a powerful household could deny receiving warning before a flood destroyed a rival's stores. Its maintenance record preserves a suspicious gap. This bell has no assumed connection to any modern campaign bell mystery.",
            "provenance": "history-2000-1900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1952-the-bell-above-the-water-historical-traces.1",
      "name": "The Bell Above the Water — Historical traces",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "A buried stair; a foundation built for a much smaller crossing; bell-shaped marks beside flood levels.",
            "provenance": "history-2000-1900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1952-the-bell-above-the-water-quest-seeds.1",
      "name": "The Bell Above the Water — Quest seeds",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "A bell rings beneath dry ground. Excavating its shaft would disturb occupied buildings, but leaving it alone may conceal a diverted underground stream.",
            "provenance": "history-2000-1900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1960-the-salt-petition-gm-truth.1",
      "name": "The Salt Petition — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Ossa used a smuggling route maintained by the same association she opposed. Its local agents had their own grievances and quietly helped her. The victory was made possible by divided loyalties.",
            "provenance": "history-2000-1900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
