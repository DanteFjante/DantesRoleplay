    {
      "entityId": "secret.caldris.lore.0699-the-court-of-seven-roads-gm-truth.1",
      "name": "The Court of Seven Roads — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "One district routinely sent a wealthy landholder to speak for everyone. The court's creation improved some remedies without establishing equal representation. Its later history can include reform, decline, or replacement.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0699-the-court-of-seven-roads-traces-and-stories.1",
      "name": "The Court of Seven Roads — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Travelling hearing calendars; roadside benches; testimony containing weather and repair details. A case preserved only as a judgment may become understandable when its field notes are located elsewhere.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0709-the-workroom-of-mended-things-gm-truth.1",
      "name": "The Workroom of Mended Things — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The house did not make all repairs free. Its arrangements balanced mutual help with the need for skilled workers to earn a living. Later charitable legends sometimes erase that essential part of its success.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0709-the-workroom-of-mended-things-traces-and-stories.1",
      "name": "The Workroom of Mended Things — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Tool registers; objects bearing several repair marks; a bench carved with apprentices' measurements. Following repairs across an object's life can identify its travels more reliably than a collector's claim that it remained untouched in one noble household.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0722-the-wedding-at-the-empty-orchard-gm-truth.1",
      "name": "The Wedding at the Empty Orchard — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The brief shelter was a freely given local gift. The menu did not summon the spirit, and repeating the wedding does not compel another awakening. Its later sleep remains compatible with present-day uncertainty about when it will appear.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0722-the-wedding-at-the-empty-orchard-traces-and-stories.1",
      "name": "The Wedding at the Empty Orchard — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "A marriage account with an unusual additional guest; competing recipes; a nursery lineage named Wedding Morning. A future festival can require clarifying what hospitality offers and what nobody has consented to owe.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0735-the-night-market-at-ash-salt-gm-truth.1",
      "name": "The Night Market at Ash Salt — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Nima knowingly protected some unlicensed sellers from excessive collection, but she expelled a profitable broker after discovering that his cheap equipment came from thefts against working crews.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0735-the-night-market-at-ash-salt-traces-and-stories.1",
      "name": "The Night Market at Ash Salt — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Oil stains in old lamp niches; tide-linked market calendars; fish-bone deposits beneath later stalls. A cargo said to have vanished at sea may have been sold in small lots through accounts that use local nicknames.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0748-the-saint-with-three-birthplaces-gm-truth.1",
      "name": "The Saint with Three Birthplaces — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "This chapter does not establish Meret's actual birthplace. Uncertainty is the result of lost evidence, not a clue that she was secretly three people or an immortal travelling under different names.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
