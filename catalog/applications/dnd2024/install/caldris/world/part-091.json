    {
      "entityId": "secret.caldris.lore.0748-the-saint-with-three-birthplaces-traces-and-stories.1",
      "name": "The Saint with Three Birthplaces — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Rival guidebooks; reused saint images; donor records. A contested relic can lead to a useful local history even if it does not belong to the famous founder.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
