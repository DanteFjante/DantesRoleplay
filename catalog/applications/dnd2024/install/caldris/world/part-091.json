    {
      "entityId": "secret.caldris.lore.0761-the-bargain-at-the-bedside-gm-truth.1",
      "name": "The Bargain at the Bedside — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Alessa was a capable negotiator who genuinely intended to observe the settlement. Its imperfections arose from unequal representation and competing interests, not a hidden magical loophole.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0761-the-bargain-at-the-bedside-traces-and-stories.1",
      "name": "The Bargain at the Bedside — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Different drafts of the succession terms; funeral purchases; a hall remodelled to accommodate an assembly. An alleged original clause may actually be an unadopted proposal with signatures acknowledging receipt rather than agreement.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0774-the-basilisk-in-the-dry-store-gm-truth.1",
      "name": "The Basilisk in the Dry Store — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The creature was an actual basilisk, not a disguised guardian or punishment for salvage. Its death is established. The storage complex has a separate human history, and any further occupants must arise from later events.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0774-the-basilisk-in-the-dry-store-traces-and-stories.1",
      "name": "The Basilisk in the Dry Store — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Screen fittings; an expense roll for specialist assistance; a drain plan. A stone figure recovered from later river work may be a carved statue or a petrified victim; the distinction requires investigation.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0787-the-agreement-of-the-open-sluices-gm-truth.1",
      "name": "The Agreement of the Open Sluices — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Halda's preferred plan was not the one adopted. She helped implement the compromise because its likely protection was better than another season without coordinated work.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0787-the-agreement-of-the-open-sluices-traces-and-stories.1",
      "name": "The Agreement of the Open Sluices — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Boundary posts with water-level marks; inspection paths; competing engineering sketches. A present blockage can be investigated through changed land use and later agreements, not just an ancient diagram treated as timeless authority.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0799-the-spring-of-floating-doors-gm-truth.1",
      "name": "The Spring of Floating Doors — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "No single act caused the whole disaster. One estate had obstructed a relief channel and worsened local flooding, but blaming it for every flooded village conceals other failures and the force of the weather itself.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
