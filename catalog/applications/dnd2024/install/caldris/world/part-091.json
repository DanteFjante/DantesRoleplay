  "entities": [
    {
      "entityId": "secret.caldris.lore.0674-the-lord-beneath-the-rushes-traces-and-stories.1",
      "name": "The Lord Beneath the Rushes — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Scarred landing posts; a trap frame in a later shed; accounts separating hunting costs from channel clearance. An impressive tooth sold as a royal relic may be authentic animal material with a wholly invented political history.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0687-the-glassmakers-daughter-and-the-false-relics-gm-truth.1",
      "name": "The Glassmaker's Daughter and the False Relics — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The reference piece has no concealed power awaiting the correct bloodline. The meaningful inheritance is transferable knowledge. Aveline's personal letter remains a separate, incompletely traced part of the dispersed parcel.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0687-the-glassmakers-daughter-and-the-false-relics-traces-and-stories.1",
      "name": "The Glassmaker's Daughter and the False Relics — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Conflicting sale descriptions; calibration marks; copied preparation corrections. A present quest can establish whether an object works and what it was used for without guaranteeing that a famous person touched it.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
