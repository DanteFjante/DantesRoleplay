{
  "format": "dantesroleplay.world-package/1",
  "rootEntityId": "world.caldris",
  "entities": [
    {
      "entityId": "location.caldris.lore.the-hollow-mint",
      "name": "The Hollow Mint",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "Former mint buildings in Highmead's old commercial quarter, now divided among licensed assayers, metalworkers, and small shops. The original furnaces survive only below one protected floor. The public weighing counter uses renewed standards rather than ancient coins as unquestioned authority.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 775,
            "y": 535
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.alderwick.highmead",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.the-house-of-paired-seals",
      "name": "The House of Paired Seals",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A record and meeting house in Highmead containing copies of negotiations before the Three Banner War and later comparative work. Some originals are held elsewhere. Exhibits distinguish signatures, proposed terms, and provisions that were actually adopted.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 565,
            "y": 290
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.alderwick.highmead",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.the-house-of-salt-letters",
      "name": "The House of Salt Letters",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A copying and forwarding house in Leth Sarai, with dry storage for letters awaiting reliable carriers. Its procedures distinguish delivery, copying, and private storage. Some historical packets remain sealed because later custodians have found no legitimate recipient or permission to open them.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 375,
            "y": 470
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lore.leth-sarai",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.the-house-of-two-hands",
      "name": "The House of Two Hands",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A craftspeople's teaching house in Istravel, with pottery benches, finishing tables, and copies of Nen Tal's documented work. Original objects rotate between collections; labels distinguish originals, teaching copies, and later reconstructions. Some teaching places are supported by renewed endowments.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 630,
            "y": 660
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lore.istravel",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.the-last-measure-workshop",
      "name": "The Last Measure Workshop",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "An instrument workshop in Willowrace whose later owners preserve copies of Orven's deposit lists and teaching arrangements. The benches and tools have changed repeatedly. A few documented components survive in protected storage, while working instruments continue to be altered for living players.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 265,
            "y": 355
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lore.willowrace",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.the-last-mile-porch",
      "name": "The Last Mile Porch",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A covered waiting and message space at Bramblebridge's Lantern Road approach, supported by nearby food and lodging. Travellers mend straps, arrange deliveries, and compare current directions. Posted notices distinguish confirmed information from reports still awaiting a witness.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 135,
            "y": 550
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.bramblebridge",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.the-listening-house",
      "name": "The Listening House",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A much-repaired house used for visiting researchers and musicians. Some notebooks belong to other collections; the local inventory records where known copies went. Its garden contains descendants of propagated plants, subject to documented losses and replacements. Ysra is not assumed to live here in the present.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 325,
            "y": 395
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lore.seln",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.the-names-house",
      "name": "The Names House",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A small search archive and mediation office in Rookwater. Its records distinguish confirmed outcomes from unanswered inquiries. Later household correspondence supplements the post-war material, and restricted notes have custody rules governing their use.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 360,
            "y": 425
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lore.rookwater",
        "slot": "location"
      }
    }
  ],
