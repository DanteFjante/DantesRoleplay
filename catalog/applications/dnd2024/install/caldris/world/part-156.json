{
  "format": "dantesroleplay.world-package/1",
  "rootEntityId": "world.caldris",
  "entities": [
    {
      "entityId": "location.caldris.lore.the-mile-of-little-bridges",
      "name": "The Mile of Little Bridges",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "The route has a different count of spans after centuries of channel movement, rebuilding, and diversion. Some ancient abutments stand beside active crossings; others lie in grass away from the modern road. Its maintenance remains local and visible.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 480,
            "y": 590
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lore.aunholt",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.the-seventh-hearth",
      "name": "The Seventh Hearth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "Repeated repairs have replaced nearly every timber, while the original hearthstone and threshold remain. The road bypassed it long ago. Brambles obscure the approach; inside, ordinary dust lies beside a carefully swept place at the table. Whether its spirit has remained awake continuously is left for later history to establish.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 210,
            "y": 170
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.atlas.orchard-march",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.the-south-turning",
      "name": "The South Turning",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A much-rebuilt inn at a junction where visitors can choose the main road or the old local track toward the Seventh Hearth. A milestone in its yard gives a distance that ceased to be accurate centuries ago. Older inn cellars lie farther along the abandoned alignment.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 385,
            "y": 470
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.atlas.orchard-march",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.the-unfinished-stair",
      "name": "The Unfinished Stair",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A partly maintained ascent in the Veyr uplands, ending at abandoned gallery sockets above a ravine. The lower steps serve shepherds and surveyors. A sheltered burial shelf lies beyond the intended road alignment, and later walkers have marked a respectful route around its approach.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 845,
            "y": 150
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.atlas.roven-approaches",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.the-winter-latch",
      "name": "The Winter Latch",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A small maintained refuge near the lower approach to the Unfinished Stair in the Veyr uplands. Its walls incorporate stones placed during the old rescue. It serves a limited seasonal route and keeps an ordinary store of fuel, fodder, and food when local deliveries succeed.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 785,
            "y": 245
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.atlas.roven-approaches",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.thistlewood-arch",
      "name": "Thistlewood Arch",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "Location: In wooded pasture beyond Wetherfold, away from the main road. Livelihood: Surrounding smallholdings; the arch itself supports no settlement. The visible arch was dismantled in Oren's time. Its foundations lie beneath a rectangular thicket that flowers oddly in exceptional years. No continuously open portal or convenient shortcut is established. A surviving fiddle and regional songs supply clues to the old crossing's cost.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 140,
            "y": 770
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.atlas.chalklands",
        "slot": "location"
      }
    }
  ],
