      "name": "Archivist Nan Wimple",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.motive",
          "value": {
            "status": "active",
            "summary": "irritable guardian of local memory. Role: lay archivist at Mallow Abbey, Odo's professional foil. Immediate want: stabilize damaged charters before enthusiastic investigators touch them. Hidden depth: knows the erased name and the abbey's benefit; hides that she forged a copy years ago to protect the original.",
            "visibility": "party"
          }
        }
      ],
