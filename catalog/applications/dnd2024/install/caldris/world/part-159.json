    {
      "entityId": "actor.caldris.arlen-pott",
      "name": "Arlen Pott",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.motive",
          "value": {
            "status": "active",
            "summary": "rival adventurer and overprepared worrier. Role: captain of the Wayward Company. Immediate want: complete the contract accidentally assigned to both companies. Hidden depth: knows a League courier route; suspects the party resents her; hides that her contract is financially ruinous.",
