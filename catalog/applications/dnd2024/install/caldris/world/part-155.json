          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "settlement",
            "summary": "Workshops stand among managed woodland. The original hollow trunks have died or changed; younger trees and carefully maintained structures preserve parts of the soundscape. The Listener's presence is intermittent and tied to the place, not guaranteed at every performance.",
            "visibility": "public",
            "status": "active"
          }
