  "entities": [
    {
      "entityId": "location.caldris.lore.thistlewood-arch",
      "name": "Thistlewood Arch",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "Location: In wooded pasture beyond Wetherfold, away from the main road. Livelihood: Surrounding smallholdings; the arch itself supports no settlement. The visible arch was dismantled in Oren's time. Its foundations lie beneath a rectangular thicket that flowers oddly in exceptional years. No continuously open portal or convenient shortcut is established. A surviving fiddle and regional songs supply clues to the old crossing's cost.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 140,
            "y": 770
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.atlas.chalklands",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.veymouth",
      "name": "Veymouth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "settlement",
            "summary": "A smaller working port beside the silted remains of a former harbour. Commercial importance has shifted elsewhere more than once. Inland families remember Ossa as a champion, while local tradition celebrates the otherwise obscure boat crews who brought the cargoes through.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 540,
            "y": 760
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lore.vey-lowlands",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.veyrs-lantern",
      "name": "Veyr's Lantern",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A rough landing, seabird cliffs, and partially buried foundations reached only in suitable conditions. Erosion has changed access and may uncover screened glass. No continuously inhabited lighthouse settlement is established by its name.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 160,
            "y": 325
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lore.serevan",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.wetherfold-common",
      "name": "Wetherfold Common",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A smaller common surrounded by successive enclosures. Later grants renew parts of the original arrangement, giving the ancient settlement practical relevance without making it automatically binding. A boundary stone has been reused as the base of a roadside shrine.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 285,
            "y": 650
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.atlas.chalklands",
        "slot": "location"
      }
    }
  ],
