{
  "format": "dantesroleplay.world-package/1",
  "rootEntityId": "world.caldris",
  "entities": [
    {
      "entityId": "secret.caldris.lore.0987-the-dowry-of-maps-traces-and-stories.1",
      "name": "The Dowry of Maps — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Different editions of a wedding atlas; lodging accounts; paired garden designs adapted to different climates. A beautiful map may omit the corrections needed for a journey, while an unattractive copy provides the useful route.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0999-the-stonecutters-spring-gm-truth.1",
      "name": "The Stonecutters' Spring — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The company's early work included repairs and occasional mistakes. Its mark indicates a particular history of responsibility, not an enchantment guaranteeing eternal structural soundness.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0999-the-stonecutters-spring-traces-and-stories.1",
      "name": "The Stonecutters' Spring — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "A plumb-shaped mason's mark; foundation notes; tool-sharing accounts. Distinguishing a genuine company inspection from an imitation can matter when deciding whether an old bridge is safe to reopen.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1009-the-winter-of-the-pale-roofs-gm-truth.1",
      "name": "The Winter of the Pale Roofs — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Nella ordered one unsafe bridge abandoned despite an isolated family's request to keep using it. The family survived by another route. That fortunate outcome does not make the decision painless or prove that every similar choice will succeed.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1009-the-winter-of-the-pale-roofs-traces-and-stories.1",
      "name": "The Winter of the Pale Roofs — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Snow-load braces incorporated into later roofs; route closures dated in courier books; shared tool marks. A modern winter problem can be approached through known lower routes and realistic limits rather than treating every old pass as permanently accessible.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1022-the-children-of-the-guest-rooms-gm-truth.1",
      "name": "The Children of the Guest Rooms — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Verra protected some private information because publishing it would expose families to retaliation. Missing details are not automatically evidence of falsehood; some were deliberately kept in a separate, restricted record.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1022-the-children-of-the-guest-rooms-traces-and-stories.1",
      "name": "The Children of the Guest Rooms — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Placement books with corrections; paired household tokens; a courtyard measuring post. A family history inquiry can uncover consent, coercion, or a chosen home without reducing every foster relationship to either rescue or wrongdoing.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1035-the-hound-of-empty-houses-gm-truth.1",
      "name": "The Hound of Empty Houses — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The hound was a predatory bound spirit exploiting a narrow permission. It was not the collective anger of war victims, and its destruction did not free every bereaved family from grief. No surviving intact binding is established.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1035-the-hound-of-empty-houses-traces-and-stories.1",
      "name": "The Hound of Empty Houses — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Door-opening customs; a burned lintel fragment documented in a later collection; a survivor's route sketch. A new haunting must be investigated on its own evidence rather than assumed to be the same hound returned.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1048-the-mill-that-ground-for-both-banks-gm-truth.1",
      "name": "The Mill That Ground for Both Banks — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Osa's teenage son had served in an abusive requisition party. She did not conceal his service, and some neighbours continued blaming him. Her useful work did not automatically resolve that injury.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    }
