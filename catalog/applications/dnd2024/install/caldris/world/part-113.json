    {
      "entityId": "location.caldris.tidecross",
      "name": "Tidecross",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "settlement",
            "status": "active",
            "summary": "Tidecross fills the long island at the southern mouth of the Lantern Sea. One of the most common stops on journeys between Eredane and Solasca, it lives by pilotage, fresh water, repairs, cargo exchange and beds for people waiting on wind or passage. Several thousand permanent residents share steep streets with a shifting population of sailors, merchants, pilgrims and deck passengers. Merchant ships anchor beyond the quays; harbour ferries carry people and goods ashore. Fishing families still work the inner basin at dawn. The Common Quay charter promises one published tariff and a hearing to crews from either continent. Wealthy warehouse factors now want priority berths, while ferrymen and fishers defend the water stairs their grandparents built.",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.visual",
          "value": {
