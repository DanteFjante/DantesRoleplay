{
  "format": "dantesroleplay.world-package/1",
  "rootEntityId": "world.caldris",
  "entities": [
    {
      "entityId": "secret.caldris.lore.0861-the-crown-carried-in-a-bread-cart-traces-and-stories.1",
      "name": "The Crown Carried in a Bread Cart — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Compensation rolls; a painted bread cart in a civic hall; a ceremonial crown confused with several later replacements. A family's apparently absurd account of feeding a royal retinue may be supported by an overlooked payment entry.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0874-the-singing-wood-of-seln-gm-truth.1",
      "name": "The Singing Wood of Seln — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The grove's beauty arose from a collaboration among natural acoustics, musicians, and a modest spirit. The claim that every tree contained a dead singer was a later invention that encouraged destructive relic collecting.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0874-the-singing-wood-of-seln-traces-and-stories.1",
      "name": "The Singing Wood of Seln — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Timber marks on older instruments; a platform foundation; tuning notes accompanied by weather observations. Restoring an instrument may require understanding the living conditions in which its makers worked, not simply obtaining more rare wood.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0887-the-orchard-of-winter-apples-gm-truth.1",
      "name": "The Orchard of Winter Apples — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The fruit was naturally well suited to storage when handled correctly. It was not enchanted, and the Guest had neither created it nor promised to protect its growers. Agricultural knowledge deserves its own place among the setting's achievements.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0887-the-orchard-of-winter-apples-traces-and-stories.1",
      "name": "The Orchard of Winter Apples — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Nursery labels preserving several names for the same stock; storage-pit plans; an apple-shaped shop sign. An old graft lineage can matter when a modern disease harms more fashionable varieties.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0899-the-valley-already-named-gm-truth.1",
      "name": "The Valley Already Named — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Aunholt had traded westward for generations. Contact with these particular southern travellers widened an existing network; it did not awaken an isolated people to the existence of the world.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0899-the-valley-already-named-traces-and-stories.1",
      "name": "The Valley Already Named — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Two incompatible expedition maps; botanical names followed by local corrections; fodder payments omitted from the patron's public account. A modern route hunt can succeed by seeking the local name rather than the famous expedition name.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0909-the-fair-of-three-roads-gm-truth.1",
      "name": "The Fair of Three Roads — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The fair's legacy depends on later renewals, adaptations, and failures. Its most durable immediate achievement was bringing people into direct contact who had previously understood one another through prices and rumours.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0909-the-fair-of-three-roads-traces-and-stories.1",
      "name": "The Fair of Three Roads — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Three-road marks on seals; stall records naming distant hometowns; an expedition supply list. A present party might follow a regional edition of the fair agreements to identify an overlooked stopping place or trace Ysra's next journey.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0922-the-rain-at-darnel-field-gm-truth.1",
      "name": "The Rain at Darnel Field — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "One apparent officer's burial belonged to a civilian carter wearing borrowed clothing when he died. Careful identification matters because impressive equipment can produce a persuasive but wrong story.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0922-the-rain-at-darnel-field-traces-and-stories.1",
      "name": "The Rain at Darnel Field — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "A memorial with intentionally blank panels; copied identity comparisons; fruit trees planted around protected graves. A new discovery can fill one blank without revealing an entire lost regiment or overturning the whole war's history.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0935-the-cellar-beneath-the-seventh-hearth-gm-truth.1",
      "name": "The Cellar Beneath the Seventh Hearth — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The cellar box was not the parcel. The plain travel cup Aveline left at the house remained there, subject to later repair and custody. The inventory does not confirm that the wrapped object was magical or that any recorded voice existed inside it.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0935-the-cellar-beneath-the-seventh-hearth-traces-and-stories.1",
      "name": "The Cellar Beneath the Seventh Hearth — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "A documented cellar discovery; two related inventory copies; a carrier's mark that changed over time. A future search gains a concrete next step without requiring the parcel or its contents to be found in this chapter.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0948-the-pilgrimage-of-the-unlit-lamps-gm-truth.1",
      "name": "The Pilgrimage of the Unlit Lamps — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "One sanctuary's account of a lamp lighting itself is unsupported by the surviving witnesses, while Little Lastlight's modest activity elsewhere is real. This world contains both genuine wonders and sincere reports that evidence does not confirm.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0948-the-pilgrimage-of-the-unlit-lamps-traces-and-stories.1",
      "name": "The Pilgrimage of the Unlit Lamps — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Lamps with names scratched beneath the base; repair lists; a walking song whose verses change by district. Recovering the original use of a disputed emblem can complicate a modern claim to exclusive ownership of it.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0961-the-scent-of-a-house-that-was-gone-gm-truth.1",
      "name": "The Scent of a House That Was Gone — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The cloth did not preserve Jalen's soul or reveal scenes of his life. Tera's response belonged to her own imagination and family knowledge. The wild flower needs a specific habitat; planting it everywhere is not a solution.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0961-the-scent-of-a-house-that-was-gone-traces-and-stories.1",
      "name": "The Scent of a House That Was Gone — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Nursery notes naming the restored pocket; a tools inventory linked to older notebooks; accounts of a cloth whose scent later faded. Reconstructing the charm requires a living source to record and cannot recover every lost smell on command.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0974-the-empty-chair-at-whitewindow-gm-truth.1",
      "name": "The Empty Chair at Whitewindow — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The chair was never cursed. Its political meaning was an attempted expectation, not magical compulsion. Its quiet later use was a deliberate act of hospitality rather than a disguised insult.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0974-the-empty-chair-at-whitewindow-traces-and-stories.1",
      "name": "The Empty Chair at Whitewindow — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "A chair repaired repeatedly; competing ceremonial descriptions; a guest-law commentary. An inherited gift with an alleged hidden obligation can prompt a search for what was actually offered and accepted.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0987-the-dowry-of-maps-gm-truth.1",
      "name": "The Dowry of Maps — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Some financed houses served the couple's commercial partners preferentially. The work improved travel and advanced private interests at the same time. Later users can benefit without accepting the patrons' entire public legend.",
            "provenance": "history-1200-900-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
