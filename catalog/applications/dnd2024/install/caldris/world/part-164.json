{
  "format": "dantesroleplay.world-package/1",
  "rootEntityId": "world.caldris",
  "entities": [
    {
      "entityId": "location.caldris.lore.the-listening-house",
      "name": "The Listening House",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A much-repaired house used for visiting researchers and musicians. Some notebooks belong to other collections; the local inventory records where known copies went. Its garden contains descendants of propagated plants, subject to documented losses and replacements. Ysra is not assumed to live here in the present.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 325,
            "y": 395
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lore.seln",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.the-names-house",
      "name": "The Names House",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A small search archive and mediation office in Rookwater. Its records distinguish confirmed outcomes from unanswered inquiries. Later household correspondence supplements the post-war material, and restricted notes have custody rules governing their use.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 360,
            "y": 425
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lore.rookwater",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.the-narrow-bell-foundry",
      "name": "The Narrow Bell Foundry",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A working foundry in Highmead with later furnaces and a retained collection of casting marks, failed pieces, and signal tables. Its reputation rests on inspection and repair as much as new bells. Objects attributed to its founders require assessment rather than automatic acceptance.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 770,
            "y": 325
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.alderwick.highmead",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.the-open-ledger-room",
      "name": "The Open Ledger Room",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A public reading and teaching room in Highmead with comparative seal casts, local measures, and copies of disputed obligations. Original records remain with their custodians unless specifically deposited. Staff distinguish teaching examples, authenticated evidence, and unanswered questions.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 560,
            "y": 445
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.alderwick.highmead",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.the-open-string-hall",
      "name": "The Open String Hall",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A community teaching and performance hall in Willowrace with repaired instruments, ordinary rehearsal rooms, and a collection of marked teaching scores. Fees, supported places, and instrument loans are recorded separately. Its paired performances remain a living custom rather than a fixed reconstruction of the founders' first concert.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 455,
            "y": 630
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lore.willowrace",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.the-orchard-of-departures",
      "name": "The Orchard of Departures",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A nursery and memorial plot in Boughmeet with propagated descendants of some older trees and replacements for others. Labels distinguish documented continuity from commemorative replanting. The associated collection keeps forwarding notes and recipes contributed by travelling households.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 530,
            "y": 690
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lore.boughmeet",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.the-pear-walk",
      "name": "The Pear Walk",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A quiet path through a younger orchard beside the library grounds. Aveline's stone was reset after later bank damage; records of that work preserve the connection to the original burial. The pear lineage has survived through grafting, replacement, and at least one disputed identification.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 175,
            "y": 440
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lore.sallowmere",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.the-quiet-archive",
      "name": "The Quiet Archive",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A small archive and copying business in Leth Sarai, occupying repaired rooms above an ordinary shop. Its collections have moved within the district several times; custody lists explain the surviving material.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 575,
            "y": 300
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lore.leth-sarai",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.the-shared-bank",
      "name": "The Shared Bank",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A maintained riverbank work in the Penn's Reach district, repeatedly repaired since the wartime flood. A small marker records the shared labour, while local maintenance documents identify later alterations. Its present condition depends on inspection and repair.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 650,
            "y": 720
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lore.penns-reach",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.the-twelve-windows",
      "name": "The Twelve Windows",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A rebuilt school and communal dining room in Highmead's Dunmere quarter. Successive windows preserve the tradition of mixed donated glass. Its early slates survive mainly as reused fragments and copied exercises.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 295,
            "y": 615
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.alderwick.highmead",
        "slot": "location"
      }
    }
  ],
