{
  "format": "dantesroleplay.world-package/1",
  "rootEntityId": "world.caldris",
  "entities": [
    {
      "entityId": "secret.caldris.lore.1415-avelines-last-winter-traces-and-stories.1",
      "name": "Aveline's Last Winter — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Three bequest lists; a gravestone preserved through later resetting; a final letter asking whether a parcel arrived safely. Recovering part of the bequest can reconnect collections without discovering a secret claim to her soul.",
            "provenance": "history-1600-1200-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1432-the-supper-of-unremembered-faces-gm-truth.1",
      "name": "The Supper of Unremembered Faces — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "One of Derren's letters at the table was a later imitation composed by a descendant who wanted to say something on his behalf. Aveline recognised the change in voice and kept it, labelled with its actual author.",
            "provenance": "history-1600-1200-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1432-the-supper-of-unremembered-faces-traces-and-stories.1",
      "name": "The Supper of Unremembered Faces — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "A guest list containing several crossed-out assumptions of kinship; a song with Aveline's notes; cups bearing different workshop marks. A commission to reconstruct the supper can become an affectionate journey through scattered family traditions.",
            "provenance": "history-1600-1200-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1449-the-choir-below-greyfold-gm-truth.1",
      "name": "The Choir Below Greyfold — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The Cantor died. The lower passages conceal older architecture and the remains of earlier victims, not an automatically recurring version of the same monster. Its apparent ability to summon the dead was deception, not resurrection.",
            "provenance": "history-1600-1200-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1449-the-choir-below-greyfold-traces-and-stories.1",
      "name": "The Choir Below Greyfold — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "A slate route board; memorial pebbles bearing occupations rather than heroic titles; a passage marked with a crossed mouth. A recent imitation of the song might be an opportunist exploiting the legend or an acoustic remnant worth investigating.",
            "provenance": "history-1600-1200-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1466-the-honey-road-gm-truth.1",
      "name": "The Honey Road — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Marel occasionally rejected good material because her method was imperfect. Her later notes explain the exceptions. A simplified textbook version creates opportunities for modern mistakes and deliberate abuse.",
            "provenance": "history-1600-1200-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1466-the-honey-road-traces-and-stories.1",
      "name": "The Honey Road — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Wax cakes stamped with household marks; account entries for payment in candle ends; an old fair song naming flowers that no longer grow nearby. A shipment of genuine but unfamiliar wax is accused of being false, and resolving the dispute requires knowledge rather than exposing a villain.",
            "provenance": "history-1600-1200-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1483-the-river-without-a-king-gm-truth.1",
      "name": "The River Without a King — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "One Keld claimant became a harbour accountant under his own name. His descendants later found exile and secret royalty more marketable than competent employment.",
            "provenance": "history-1600-1200-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1483-the-river-without-a-king-traces-and-stories.1",
      "name": "The River Without a King — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Royal stones recut with local emblems; coins circulating long after the sovereign died; three incompatible official accounts of the last court. A burial discovery can give an unglamorous answer to the fate of a supposedly vanished prince.",
            "provenance": "history-1600-1200-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1499-the-meadows-that-moved-uphill-gm-truth.1",
      "name": "The Meadows That Moved Uphill — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The settlers knew the high fields were marginal. Later landlords converted a cautious experiment into a claim that the slopes had always supported higher rents.",
            "provenance": "history-1600-1200-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    }
