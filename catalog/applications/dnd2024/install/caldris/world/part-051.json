        {
          "qualifiedTypeId": "game.core.world.faction",
          "value": {
            "status": "active",
            "summary": "A small Highmead philosophical order whose monks study the instant before action and believe perfect perception may reveal the divine source refracted through the Nine Lamps. Their sincere reverence for exceptional students can become coercive custody.",
            "visibility": "public",
            "goals": [
              "Achieve increasingly complete perception through disciplined observation and martial training.",
              "Return the escaped novice called the Unbidden Eye to Tensor instruction."
            ],
            "methods": [
              "Train breath, balance, gaze, prediction, and nonlethal combat through repeated observation exercises.",
              "Use hospitality, philosophical debate, apprenticeship obligations, and retrieval parties to preserve the order."
            ],
            "assets": [
              "House of the Ninth Angle",
              "Prediction Court",
              "Disciplined travelling monks",
              "Detailed observation and intake folios"
            ],
            "agenda": {
              "state": "ready",
              "summary": "Locate Ganji, determine how he crossed the Prediction Court unheard, and bring him back without allowing outsiders to redefine the sect's claim over him."
