      "name": "Ylsa Kern",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.motive",
          "value": {
            "status": "active",
            "summary": "Quietly intense smith and keeper of Rook Anvil, speaking mostly in questions about workmanship. Wants to identify the brittle scrap before someone dies; reads fracture patterns expertly; fears a recall will bankrupt neighboring families. Buys tools from Pella Sorn and distrusts mine owners. She supports public disclosure once a repair fund exists.",
            "visibility": "party"
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.dunmarrow",
        "slot": "people"
      }
    },
