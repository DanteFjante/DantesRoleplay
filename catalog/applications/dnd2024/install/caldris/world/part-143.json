      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "settlement",
            "summary": "Oakshield guards forest passes with layered timber walls designed to be repaired, not admired. It exports horses, charcoal, leather, and excellent preserved mushrooms.",
