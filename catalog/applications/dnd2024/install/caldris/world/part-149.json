    {
      "entityId": "location.caldris.lantern-sea.the-halfway-light.beacon-tower",
      "name": "The Halfway Beacon",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "status": "active",
            "summary": "A tall stone tower rises above the northern rocks. Its lamp is watched through the night, and a sheltered workroom holds spare wicks, polished reflectors and the weather book. Keeper Edda Vale checks the light before arguing over anything else. Each watch signs the same ledger regardless of which state pays its wages. The worn steps are steep, the gallery catches the full wind, and the view makes approaching trouble visible long before the landing hears about it.",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 494,
            "y": 119
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lantern-sea.the-halfway-light",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lantern-sea.the-halfway-light.cistern-gardens",
      "name": "The Rain Court",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "status": "active",
            "summary": "A covered rain cistern and carefully tended beds supply the keeper households with water, greens and herbs. Ration marks are visible to everyone during a dry spell. Garden keeper Fen Arel trades seedlings with supply crews and tolerates no washing of oily hands near the water. The little court is also where island children learn knots and mariners recovering at the refuge sit out of the wind.",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 457,
            "y": 464
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lantern-sea.the-halfway-light",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lantern-sea.the-halfway-light.fog-bell",
      "name": "The Fog Bell",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "status": "active",
            "summary": "A heavy bell hangs on a western clifftop platform. When mist hides the beacon, its measured strokes warn vessels away from the rocks. Keepers take paired watches so one can ring while the other listens for replies. The exposed stair has a rope handline renewed every season. Locals say the bell belongs to whoever cannot see the shore; its iron has been repaired by smiths from all four contributing states.",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 154,
            "y": 296
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lantern-sea.the-halfway-light",
        "slot": "location"
      }
    }
