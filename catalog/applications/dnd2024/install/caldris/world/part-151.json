  "entities": [
    {
      "entityId": "location.caldris.lore.doorhaven",
      "name": "Doorhaven",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "settlement",
            "summary": "A small riverland settlement whose oldest lanes follow the original raised camp areas. Houses contain reused materials from several places. Flood preparedness is a practical community concern, and door carvings preserve stories whose details are not always reliable.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 740,
            "y": 460
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lore.vey-lowlands",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.goats-ledger",
      "name": "Goat's Ledger",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "settlement",
            "summary": "Warehouses, animal yards, repair sheds, and lodging cluster around unloading grounds. Its wealth depends on reliable handling rather than ownership of every cargo. Marks on older warehouse beams record different generations of carrying partnerships.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 720,
            "y": 470
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lore.aunholt",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.greyfold-ridge",
      "name": "Greyfold Ridge",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "An abandoned deep quarry beside a smaller working stone face. The hunt's sealed approaches have undergone erosion and later interference. Upper chambers contain quarry remains; lower architecture belongs to an older, still-unresolved history.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 810,
            "y": 640
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.atlas.roven-approaches",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.harth-orchard",
      "name": "Harth Orchard",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "settlement",
            "summary": "The orchard boundaries have changed many times, but growers keep renewing the unpicked strip. The founding tree survives only through successive grafts. The guesthouse is now a small hospice whose garden contains the oldest known graft.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 490,
            "y": 300
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.atlas.orchard-march",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.hazelstairs",
      "name": "Hazelstairs",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "Terraces, cellar mouths, and fragments of the mill stand among summer grazing. Later shepherd shelters occupy some foundations. Streams have changed course and roots have shifted retaining walls; exploration requires care around unstable drops.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 180,
            "y": 615
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.atlas.roven-approaches",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.hearthscar-shelter",
      "name": "Hearthscar Shelter",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A maintained northern shelter on the lower alternative to a difficult pass. Human and animal accommodation are separate. Stores depend on deliveries and honest use. Older braces and wall scars remain visible among later work.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 315,
            "y": 370
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.atlas.roven-approaches",
        "slot": "location"
      }
    }
  ],
