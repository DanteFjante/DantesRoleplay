{
  "format": "dantesroleplay.world-package/1",
  "rootEntityId": "world.caldris",
  "entities": [
    {
      "entityId": "secret.caldris.lore.0609-the-festival-of-unfinished-journeys-traces-and-stories.1",
      "name": "The Festival of Unfinished Journeys — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "A programme separating public performances from private inquiries; route books marked with new destinations; a letter refusing sole authorship. A future discovery can connect a family's apparently unfinished journey to a fulfilling life elsewhere.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0622-the-mile-of-little-bridges-gm-truth.1",
      "name": "The Mile of Little Bridges — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The crossing was not sustained by an ancient spell. Its elegance lay in accommodating the landscape. A magical shortcut that ignored drainage could damage precisely what made the route useful.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0622-the-mile-of-little-bridges-traces-and-stories.1",
      "name": "The Mile of Little Bridges — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Short abutments partly buried in marsh grass; inspection tallies; songs with different bridge counts. Restoring one section can require recognising a deliberately open watercourse rather than filling every apparent gap in the road.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0635-the-year-the-music-stayed-home-gm-truth.1",
      "name": "The Year the Music Stayed Home — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Ysra did not take students in search of a chosen successor. Several people learned different parts of her work. Her eventual death is not set in this chapter, and nothing here establishes that she survives into the campaign present.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0635-the-year-the-music-stayed-home-traces-and-stories.1",
      "name": "The Year the Music Stayed Home — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Corrected notebooks; letters declining invitations; an instrument inventory showing extensive replacement parts. A later collection can preserve her working uncertainty instead of presenting every remark as ancient authority.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0648-the-library-in-the-laundry-loft-gm-truth.1",
      "name": "The Library in the Laundry Loft — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The fragment supplies real content without recovering the entire letter or proving that every later attribution is correct. Erena was not secretly a magical scholar; her knowledge of damp, heat, cloth, and workspaces helped preserve the scholarship of others.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0648-the-library-in-the-laundry-loft-traces-and-stories.1",
      "name": "The Library in the Laundry Loft — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Drying arrangements described in accounts; fragments with linked inventory numbers; an apology quoted without its full addressee. Identifying the assistant can restore credit to someone overshadowed by a celebrated traveller.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0661-the-duke-who-counted-empty-beds-gm-truth.1",
      "name": "The Duke Who Counted Empty Beds — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Samel faced real defence and maintenance costs. His solution shifted them badly and created harmful incentives. Opposing the tax did not eliminate the need to support the road.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0661-the-duke-who-counted-empty-beds-traces-and-stories.1",
      "name": "The Duke Who Counted Empty Beds — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Bed inventories; removable sleeping platforms; a satirical count of beds occupied by cats. A modern dispute may repeat the underlying problem under different rules without treating this ancient settlement as universally binding.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.0674-the-lord-beneath-the-rushes-gm-truth.1",
      "name": "The Lord Beneath the Rushes — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The Rush Lord was neither a disguised water deity nor a surviving basilisk from the previous century. It was a distinct animal whose behaviour was worsened by human attempts at appeasement. Its death is established; later marsh dangers have their own causes.",
            "provenance": "history-900-600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    }
