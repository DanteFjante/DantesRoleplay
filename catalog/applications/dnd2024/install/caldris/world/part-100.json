  "entities": [
    {
      "entityId": "secret.caldris.lore.1648-the-winter-teeth-traces-and-stories.1",
      "name": "The Winter Teeth — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "A collapsed quarry mouth; hunting payments; a blue-white tooth in a regional treasury. Recovering the actual casualty roll restores names to a damaged memorial. Exploring the old workings may find dangerous unstable galleries and scavengers attracted to the remains.",
            "provenance": "history-1900-1600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1661-the-thistlewood-bride-gm-truth.1",
      "name": "The Thistlewood Bride — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Oren was welcome to leave but was not told what delay would mean outside. His hosts regarded the omission as discourtesy, not abduction. That failure of understanding does not erase the harm, nor does it make accepting a second invitation safe.",
            "provenance": "history-1900-1600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1661-the-thistlewood-bride-traces-and-stories.1",
      "name": "The Thistlewood Bride — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "A fiddle with eleven small cuts; flowering shrubs in an unnatural rectangle; two incompatible marriage songs. A renewed bloom offers a possible search for another missing visitor, with the risk of altered time made discoverable before entry.",
            "provenance": "history-1900-1600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1674-the-broken-counter-gm-truth.1",
      "name": "The Broken Counter — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The initial failure was not a master theft. One official then concealed losses to protect his relatives, turning a solvency crisis into a fraud. Different harmed families have different responsible parties.",
            "provenance": "history-1900-1600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1674-the-broken-counter-traces-and-stories.1",
      "name": "The Broken Counter — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Cancelled seals; household ledgers with prices crossed out; a fair custom of publicly opening the market chest. A forged claim tries to attach a modern charity to the wrong historical institution.",
            "provenance": "history-1900-1600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1687-the-crown-above-the-market-gm-truth.1",
      "name": "The Crown Above the Market — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The original circlet was later dismantled to pay a hostage ransom. A contemporary replacement became the object used in later ceremonies. Authenticity can belong to a history of use as well as to an untouched first object.",
            "provenance": "history-1900-1600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1687-the-crown-above-the-market-traces-and-stories.1",
      "name": "The Crown Above the Market — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Iron-and-silver motifs; an audience bench worn unevenly by later reuse; contradictory boundary surveys. A modern collector offers a supposed coronation circlet whose alloy and repairs suggest a more complicated identity.",
            "provenance": "history-1900-1600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1699-the-fever-at-the-lower-gate-gm-truth.1",
      "name": "The Fever at the Lower Gate — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Leth survived and strongly disliked being depicted as a beautiful young martyr. Her last known petition demanded replacement buckets and payment for three months of unpaid work.",
            "provenance": "history-1900-1600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1699-the-fever-at-the-lower-gate-traces-and-stories.1",
      "name": "The Fever at the Lower Gate — Traces and stories",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "A communal memorial with names added in different hands; a blocked lodging court; a charitable washing house rebuilt on the old site. Restoring the burial garden uncovers personal tokens useful for identifying forgotten families.",
            "provenance": "history-1900-1600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
      "containment": {
        "containerEntityId": "world.caldris",
        "slot": "lore"
      }
    },
    {
      "entityId": "secret.caldris.lore.1709-the-first-lantern-league-gm-truth.1",
      "name": "The First Lantern League — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Early league promises expired and required verification. An ancient seal is historical evidence, not a bearer instrument redeemable for unlimited modern wealth. Later endowments and renewed obligations can still make particular records matter.",
            "provenance": "history-1900-1600-years-ago.md",
            "visibility": "gm"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
          "value": {
            "subjectKind": "event",
            "sensitivity": "secret"
          }
        }
      ],
