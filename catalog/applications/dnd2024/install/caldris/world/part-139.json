          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "Mud-brick landing for scribes' ink, fish oil, reeds, and legal couriers, notorious for black-stained cats. Present pressure: Official documents fade to blank within days.",
