      "components": [
        {
          "qualifiedTypeId": "game.core.world.fact",
          "value": {
            "status": "active",
            "summary": "A thirteenth strike means “the count is wrong; come verify it,” never bad luck. Disagreement: Bridge chapters disagree whether any citizen may ring it. Story use: A comic civic rule becomes a reliable alarm and a source of jurisdictional conflict.",
            "provenance": "Caldris history and lore atlas",
            "visibility": "public"
