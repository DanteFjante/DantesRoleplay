    {
      "entityId": "fact.caldris.custom.alderwick.the-last-button-home",
      "name": "The Last Button Home",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.fact",
          "value": {
            "status": "active",
            "summary": "Travelers leave one spare button at a hill cairn and collect a different one on returning. Disagreement: Some call it luck; historians think it once counted families using famine stores. Story use: A button links a missing traveler to a route they publicly denied taking.",
            "provenance": "Caldris history and lore atlas",
            "visibility": "public"
          }
        },
        {
