    {
      "entityId": "creature.caldris.dragon.karsh-veyru",
      "name": "Karsh Veyru, the Copper Eater",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.motive",
          "value": {
            "status": "active",
            "summary": "An ancient red dragon believed to sleep beneath Kethria's highest volcanic ridge. The royal tithe is real, though mostly copper, crafted bells, and written accounts of mountain change rather than treasure. Karsh accepted the bargain to deny a rival dragon the passes. If the doubled tithe wakes the dragon early, Karsh may be angrier about fraudulent accounting than hungry for conquest.",
            "visibility": "public"
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.kethria",
        "slot": "creatures"
      }
    },
    {
      "entityId": "creature.caldris.dragon.mourenne-under-mere",
      "name": "Mourenne Under-Mere",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.motive",
          "value": {
            "status": "active",
            "summary": "A green dragon associated with drowned forests beneath Alderwick's eastern reservoir. Old village stories claim Mourenne bargained for the preservation of three groves and punishes broken promises, while Crown records describe a defeated monster. Recent black-green scales suggest the stories and records are both incomplete. Mourenne is patient, territorial, and capable of sincere attachment to places rather than people.",
            "visibility": "public"
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.alderwick",
        "slot": "creatures"
      }
    },
    {
      "entityId": "creature.caldris.dragon.oriselle-cloud-turner",
      "name": "Oriselle Cloud-Turner",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.motive",
          "value": {
            "status": "active",
            "summary": "A silver dragon of the Lornspine heights, rarely seen and widely credited with every fortunate avalanche. Oriselle once carried refugees over a closed pass but refuses worship and dislikes being asked to solve political problems. The dragon's true hoard is a network of sworn rescue obligations among mountain communities.",
            "visibility": "public"
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lornesse",
        "slot": "creatures"
      }
    },
    {
      "entityId": "creature.caldris.dragon.sable-annek-of-the-reed-graves",
      "name": "Sable Annek of the Reed Graves",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.motive",
          "value": {
            "status": "active",
            "summary": "A black dragon presumed killed during the Sundering. Namar folk tales attribute disappearing channels, drowned archives, and perfectly preserved corpses to Annek. The dragon actually survives in a remote brackish basin and has spent centuries cultivating legal nonexistence. Annek buys discarded names and erased villages through intermediaries.",
            "visibility": "gm"
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.namarra",
        "slot": "creatures"
      }
    }
