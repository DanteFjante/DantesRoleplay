          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A maintained refuge on a local northern branch near the Roven approaches. It serves fewer carriers than Hearthscar and depends on seasonal deliveries. The winter descent has changed after later rockfalls.",
