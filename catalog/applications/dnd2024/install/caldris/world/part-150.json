{
  "format": "dantesroleplay.world-package/1",
  "rootEntityId": "world.caldris",
  "entities": [
    {
      "entityId": "location.caldris.lantern-sea.the-halfway-light.keepers-court",
      "name": "Four Keepers' Court",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "status": "active",
            "summary": "Four modest keeper houses face a common house inside a low stone enclosure. Here the households eat, divide watches and settle maintenance arguments at a table with four equal places. No national banner flies above the others. Clerk Tomas Renn records every delivery and repair in duplicate so a delayed payment cannot become a claim of ownership. In bad weather the common room fills with wet coats, mending work and news carried by rescued crews.",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 463,
            "y": 388
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lantern-sea.the-halfway-light",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lantern-sea.the-halfway-light.lamp-store",
      "name": "The Lamp Store",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "status": "active",
            "summary": "A detached stone store holds sealed lamp-oil vessels, rope, spare fittings and repair tools away from the tower and living rooms. Two keepers count the reserve together when a delivery arrives. Its public tally matters: every state must see that the light can continue through a missed supply run. A cracked lid, damp wick or short shipment is ordinary work with serious consequences, and discrepancies are written down before blame travels ashore.",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 610,
            "y": 503
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lantern-sea.the-halfway-light",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lantern-sea.the-halfway-light.lifeboat-station",
      "name": "The Rescue Shed",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "status": "active",
            "summary": "A broad shed and steep southern slip shelter rescue boats, oars, cork belts, blankets and hauling ropes. Coxswain Jessa Orr drills whoever is fit to pull, including visiting sailors. Crews are chosen by skill rather than flag. After a rescue, the boats are cleaned and the missing names entered before anyone discusses salvage. The ramp can be dangerous even when the eastern landing looks calm.",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 464,
            "y": 717
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lantern-sea.the-halfway-light",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lantern-sea.the-halfway-light.mariners-refuge",
      "name": "The Open Door Refuge",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "interior",
            "status": "active",
            "summary": "A small refuge above the southeastern rocks offers dry bunks, hot broth and a place to recover before travelling on. Caretaker Orla Penn keeps spare clothes sorted by size, not origin, and refuses payment from people brought in by the lifeboat. A memorial garden beside the house remembers mariners whose names were learned too late. Messages to families wait in a tin box for a trusted ship; several former guests now send blankets every winter.",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 756,
            "y": 611
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lantern-sea.the-halfway-light",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lantern-sea.the-halfway-light.supply-jetty",
      "name": "The Common Landing",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "status": "active",
            "summary": "A timber jetty occupies the sheltered eastern cove. The supply cutter unloads oil, flour, mail and relief keepers here; visiting boats must leave room for rescue work. Boatkeeper Neri Sann reads the swell before allowing anyone onto the wet steps. There is no permanent customs post or passenger market. A scratched board lists supplies still needed from each of the four contributors, beside letters waiting for the next safe departure.",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 772,
            "y": 402
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lantern-sea.the-halfway-light",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.alderwake",
      "name": "Alderwake",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "settlement",
            "summary": "Location: East of Harth's orchard branch, where a drovers' track meets the route toward the river. Livelihood: Livestock, cloth, lodging, and seasonal fairs. The ancient fairground becomes a small town whose widest lanes remain open for temporary stalls. On ordinary days it feels half empty. On fair days kitchens overflow into courtyards and children navigate by stall awnings rather than house numbers. The original fair bell is lost; successive bells inherit its name.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 765,
            "y": 440
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.atlas.orchard-march",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.amberstile",
      "name": "Amberstile",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "settlement",
            "summary": "A modest market town whose wax sheds serve candle makers, craftspeople, and local households. Seasonal trading fills a broad yard behind the old gate. The honey cakes sold to visitors are good enough that residents forgive the inaccurate stories printed on their wrappers.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 660,
            "y": 730
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.atlas.orchard-march",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.ash-salt",
      "name": "Ash Salt",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "settlement",
            "summary": "Working stalls, smokehouses, net sheds, and lamps arranged around a tidal landing. The market's busiest hours change with local water conditions. It is a place of honest work, occasional opportunism, and visitors who mistake informality for lawlessness.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 750,
            "y": 730
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lore.vey-lowlands",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.bellwade",
      "name": "Bellwade",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "settlement",
            "summary": "An inland village facing a tidal marsh where fragments of its first site occasionally emerge. Some houses incorporate old lintels, though many claimed originals are later commemorations. The communal bell has been recast since its relocation, preserving portions of earlier metal and its inherited name.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 760,
            "y": 270
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.lore.vey-lowlands",
        "slot": "location"
      }
    },
    {
      "entityId": "location.caldris.lore.bluecup-hollow",
      "name": "Bluecup Hollow",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.location",
          "value": {
            "kind": "site",
            "summary": "A small protected patch amid working land near the routes between the orchard country and the northern foothills. Propagated plants grow in a nearby nursery, but the wild pocket retains conditions difficult to reproduce elsewhere. The ancient companions' exact collecting spot is only approximately known.",
            "visibility": "public",
            "status": "active"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.map.anchor",
          "value": {
            "x": 610,
            "y": 730
          }
        }
      ],
      "containment": {
        "containerEntityId": "location.caldris.atlas.chalklands",
        "slot": "location"
      }
    }
  ],
