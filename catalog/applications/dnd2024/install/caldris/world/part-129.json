    {
      "entityId": "fact.caldris.custom.lornesse.the-missing-echo",
      "name": "The Missing Echo",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.fact",
          "value": {
            "status": "active",
            "summary": "Workers stop immediately if a familiar echo fails to return. Disagreement: Priests call it mountain displeasure; engineers call it changing voids. Story use: Both interpretations point toward real danger through different evidence.",
            "provenance": "Caldris history and lore atlas",
            "visibility": "public"
          }
        },
        {
