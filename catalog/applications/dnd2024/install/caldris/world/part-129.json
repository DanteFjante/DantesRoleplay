    {
      "entityId": "fact.caldris.dossier.alderwick",
      "name": "Polity dossier — Alderwick",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.fact",
          "value": {
            "status": "active",
            "summary": "Alderwick — the kingdom of bridges and committees. Land and livelihood: green river valleys, beech hills, sheep uplands, flax, oats, apples, Rule: Queen Adela II governs through the Crown Council, shire courts, chartered towns, and Character: proud of fairness, compromise, practical engineering, and pies baked in extremely Magic: tolerated and licensed loosely in cities; public enchantment or mind influence is Old wound: Alderwick changed sides twice during the Three Banner War and remembers the second Current factions: Crown Council, Company of Weirs, Quiet Bell chapter, Honest Weights Guild, Campaign use: starting homeland, institutional humour, fair-minded people under corruptible",
            "provenance": "Caldris world bible — polity dossiers",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
