    {
      "entityId": "fact.caldris.dossier.carrowmere",
      "name": "Polity dossier — Carrowmere",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.fact",
          "value": {
            "status": "active",
            "summary": "Carrowmere — salt, ships, and stubborn civic pride. Land and livelihood: tidal marshes, cliffs, oak ship timber, fisheries, salt pans, sailcloth, Rule: Queen Ysabet governs through port charters whose lawyers can remember insults for five Character: maritime humour, public argument, strong mutual-aid societies, elaborate rescue Magic: weather-workers are respected but scrutinized; sea charms flourish, most mundane. Old wound: a royal convoy abandoned refugee vessels during the war; the official account is Current pressure: shipwrights demand safe hours and injury support before fitting the autumn",
            "provenance": "Caldris world bible — polity dossiers",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
