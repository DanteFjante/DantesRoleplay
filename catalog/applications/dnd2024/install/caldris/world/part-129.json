    {
      "entityId": "fact.caldris.custom.lornesse.goat-judgment",
      "name": "Goat Judgment",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.fact",
          "value": {
            "status": "active",
            "summary": "Grazing disputes are argued before an elected “goat judge,” who announces a practical compromise. Disagreement: Outsiders think the goat decides; locals know the decorated animal keeps tempers down. Story use: An antagonist dismisses the ritual and loses community trust before a serious hearing.",
            "provenance": "Caldris history and lore atlas",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
