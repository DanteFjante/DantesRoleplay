    {
      "entityId": "fact.caldris.dossier.bellafont",
      "name": "Polity dossier — Bellafont",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.fact",
          "value": {
            "status": "active",
            "summary": "Bellafont — orchards, cloth, and smiling competition. Land and livelihood: warm southern hills, orchards, vineyards, sheep, dyes, fine cloth, Rule: King Lucan and a dense web of landholding abbeys, city guilds, and irrigation courts. Character: graceful manners, devastating compliments, garden contests, amateur theatre, and Magic: small household charms are culturally accepted; formal practitioners cluster around Old wound: peasant water-right records were “lost” during Crownmaking consolidation. Current pressure: the pale-canker blight affects old orchards along a route marked by ancient",
            "provenance": "Caldris world bible — polity dossiers",
            "visibility": "public"
          }
        },
        {
          "qualifiedTypeId": "game.core.world.knowledge.classification",
