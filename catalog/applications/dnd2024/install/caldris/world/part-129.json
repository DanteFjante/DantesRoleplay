      "name": "Tavaros of the Empty Nets",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.motive",
          "value": {
            "status": "active",
            "summary": "A bronze sea dragon ranging across the Saffron Reach. Tavaros protects wreck survivors, sabotages slavers and some pirates, and also steals navigational instruments of exceptional workmanship. Selucian sailors adore the dragon in song and complain bitterly about it in port. Tavaros recently returned a compass belonging to a ship that has not yet been built.",
            "visibility": "public"
          }
