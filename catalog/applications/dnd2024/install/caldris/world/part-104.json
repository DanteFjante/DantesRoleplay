    {
      "entityId": "secret.caldris.lore.1968-the-small-wonders-journey-gm-truth.1",
      "name": "The Small Wonders Journey — GM truth",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Derren's marginal notes contain the only account of their friendship written for Aveline herself. Most later copies omit them as irrelevant bookkeeping.",
            "provenance": "history-2000-1900-years-ago.md",
            "visibility": "gm"
          }
        },
