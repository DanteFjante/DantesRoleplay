          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "The Guest can shelter only a limited area. Enlarging the orchards without renegotiation eventually made apparent favouritism inevitable. Its silence arose from shame as much as pride.",
