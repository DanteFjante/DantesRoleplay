      "name": "The Salt Petition — Quest seeds",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Find a convoy lost with the subscribers' original register. A surviving token may support a claim to a charitable endowment, but demonstrating it could bankrupt the institution currently feeding the poor.",
            "provenance": "history-2000-1900-years-ago.md",
