      "name": "The Salt Petition — Historical traces",
      "components": [
        {
          "qualifiedTypeId": "game.core.world.secret",
          "value": {
            "status": "active",
            "summary": "Subscription marks on small lead tokens; salt cupboards with two locks; songs about a widow who bought a road one spoonful at a time.",
            "provenance": "history-2000-1900-years-ago.md",
            "visibility": "gm"
          }
        },
