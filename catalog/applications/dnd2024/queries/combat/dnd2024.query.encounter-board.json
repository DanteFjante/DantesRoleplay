          "position": {
            "$ref": "#/$defs/position"
          },
          "activeTurn": {
            "type": "boolean"
          }
        }
      },
      "turn": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "participationId",
          "ordinal"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "participationId": {
            "$ref": "#/$defs/id"
          },
          "ordinal": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          }
        }
      }
