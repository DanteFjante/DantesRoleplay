            "minimum": 0,
            "maximum": 63
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "elevationFeet": {
            "type": "integer",
            "minimum": -1000,
            "maximum": 1000
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "participant": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "participationId",
