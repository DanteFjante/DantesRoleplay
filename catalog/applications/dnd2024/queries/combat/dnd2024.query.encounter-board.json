        "required": [
          "id",
          "label",
          "area",
          "blocksMovement",
          "visibility"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "area": {
            "$ref": "#/$defs/area"
          },
          "blocksMovement": {
            "const": true
