            "maximum": 64
          },
          "rows": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "feetPerSquare": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "backgroundMediaOrder": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              }
            ]
          }
        }
      },
      "terrain": {
