{
  "id": "dnd2024.query.encounter-board",
  "category": "dnd2024.ruleset.core.combat.tactical-board.read-model",
  "name": "Current tactical encounter board",
  "description": "Returns one audience-authorized encounter's bounded grid, visible terrain and obstacles, positioned participants, Initiative order, and active turn.",
  "matches": [
    "show the tactical encounter board",
    "show combat positions and obstacles",
    "where is everyone in this encounter"
  ],
  "roles": {
    "encounter": "The exact audience-authorized encounter."
  },
  "executor": "mechanic-projection",
  "campaignSelection": {
    "queryId": "dnd2024.query.current-scene",
    "entityIdField": "encounterId"
  },
  "projection": {
    "qualifiedId": "dnd2024.mechanic.encounter.board.project",
    "version": 1,
    "contentHash": "CE51BFD7AE90A51332D7A6BE3526ADF0E71FDB4495134FCCCB9F2CA19DE19F97",
    "outputSchemaHash": "40EBE81FA45C4738B3BB573A26453C7773A7545D0765AF1CD2E4902797F234A5"
  },
  "outputSchema": {
