        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        }
      },
      "area": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "x",
          "y",
          "width",
          "height"
        ],
        "properties": {
          "x": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          },
          "y": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          }
        }
      },
      "board": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision",
          "columns",
          "rows",
          "feetPerSquare"
