      },
      "obstacles": {
        "type": "array",
        "maxItems": 256,
        "items": {
          "$ref": "#/$defs/obstacle"
        }
      },
      "participants": {
        "type": "array",
        "maxItems": 100,
        "items": {
          "$ref": "#/$defs/participant"
        }
      },
      "turn": {
        "oneOf": [
