{
  "id": "dnd2024.query.world-campaign-directory",
  "category": "campaign.directory",
  "name": "World campaign directory",
  "description": "Returns source-revision-bound pages of active campaigns linked to the selected campaign's exact World.",
  "matches": ["list campaigns in this world", "choose campaign"],
  "roles": { "campaign": "The selected authorized campaign.", "world": "The World resolved by the campaign-context query." },
  "executor": "object-projection",
  "campaignSelection": { "queryId": "dnd2024.query.campaign-context", "entityIdField": "worldId" },
  "object": { "qualifiedId": "dnd2024.object.world-campaign-directory", "version": 1, "contentFingerprint": "9417995A10D17B3EA16BBF0155C56BD2ACE9FC49FBF91B7B63384019EEA93215" },
  "collection": "campaigns",
  "outputSchema": {
    "type": "object", "additionalProperties": false,
    "properties": {
      "worldSummary": { "type": "string", "minLength": 1, "maxLength": 1000 },
      "selectedWorld": { "$ref": "#/$defs/entityReference" },
      "campaigns": {
        "type": "array", "maxItems": 25,
        "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "name", "status", "title", "premise", "partyGoals", "toneAndBoundaries", "rulesetScope", "creationMethod", "reviewFingerprint"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 200 }, "name": { "type": "string", "minLength": 1, "maxLength": 400 }, "status": { "const": "active" },
            "title": { "type": "string", "minLength": 1, "maxLength": 160 }, "premise": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "partyGoals": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
            "toneAndBoundaries": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
            "rulesetScope": { "const": "dnd2024" }, "creationMethod": { "const": "manual" }, "reviewFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      },
      "totalCount": { "type": "integer", "minimum": 0, "maximum": 256 }, "complete": { "type": "boolean" }, "nextCursor": { "type": ["string", "null"], "maxLength": 2048 }
    },
    "$defs": { "entityReference": { "type": "object", "additionalProperties": false, "required": ["id", "name"], "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 200 }, "name": { "type": "string", "minLength": 1, "maxLength": 400 } } } }
  },
  "exposure": "model-visible",
  "status": "active"
}
