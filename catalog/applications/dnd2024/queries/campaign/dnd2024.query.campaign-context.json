    "$defs": {
      "entityReference": {
        "type": "object", "additionalProperties": false, "required": ["id", "name"],
        "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 200 }, "name": { "type": "string", "minLength": 1, "maxLength": 400 } }
      }
    }
  },
  "exposure": "model-visible",
  "status": "active"
}
