      "party": { "type": "array", "maxItems": 20, "items": { "type": "object", "additionalProperties": false, "required": ["id", "name", "status"], "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 200 }, "name": { "type": "string", "minLength": 1, "maxLength": 400 }, "status": { "enum": ["active", "withdrawn"] } } } },
      "totalCount": { "type": "integer", "minimum": 0, "maximum": 20 },
      "complete": { "type": "boolean" },
      "nextCursor": { "type": ["string", "null"], "maxLength": 2048 }
    }
  },
  "exposure": "model-visible",
  "status": "active"
}
