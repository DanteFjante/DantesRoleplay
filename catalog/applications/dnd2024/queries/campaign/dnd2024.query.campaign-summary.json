{
  "id": "dnd2024.query.campaign-summary",
  "category": "campaign.summary",
  "name": "Campaign summary",
  "description": "Reads the selected campaign summary and its bounded read-only party participation references.",
  "matches": ["campaign summary", "show campaign"],
  "roles": { "campaign": "The selected authorized campaign." },
  "executor": "object-projection",
  "object": {
    "qualifiedId": "dnd2024.object.campaign-summary",
    "version": 1,
    "contentFingerprint": "3AE6FD831B4319BA96E15A1501896549030C80FDBFA49D5503D0568DB9B61DEB"
  },
  "collection": "party",
  "outputSchema": {
    "type": "object",
