{
  "id": "dnd2024.query.unresolved-decisions",
  "category": "dnd2024.play.read-model",
  "name": "Unresolved decisions",
  "description": "Returns the unresolved decision point for one authorized play scene, including eligible participants and already declared intents but no undeclared conversation context.",
  "matches": ["what decisions are unresolved", "what choice is waiting", "show the current decision point"],
  "roles": { "scene": "The exact audience-authorized current play scene." },
  "executor": "mechanic-projection",
  "projection": {
    "qualifiedId": "dnd2024.mechanic.play.unresolved-decisions.project",
    "version": 1,
    "contentHash": "0889C15680AC5E9F29A38045A98181065CD39C83B751C29FE9650B30829B0C4A",
    "outputSchemaHash": "FEE16C1C2B3CD390CA6C30F4593E61953A426FF8F84AF4B2212B1A6B2E0332AF"
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object", "additionalProperties": false,
    "required": ["version", "scene", "items"],
    "properties": {
      "version": { "const": 1 },
      "scene": { "type": "object", "additionalProperties": false, "required": ["id", "name", "status", "pillarId", "encounterId"], "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/text" }, "status": { "enum": ["framing", "active", "paused", "resolved"] }, "pillarId": { "$ref": "#/$defs/nullableId" }, "encounterId": { "$ref": "#/$defs/nullableId" } } },
      "items": { "type": "array", "maxItems": 1, "items": { "$ref": "#/$defs/decision" } }
    },
    "$defs": {
      "id": { "type": "string", "minLength": 1, "maxLength": 200 },
      "text": { "type": "string", "minLength": 1, "maxLength": 12000 },
      "nullableId": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 },
      "decision": { "type": "object", "additionalProperties": false, "required": ["sceneId", "status", "promptingEntityId", "eligibleParticipantIds", "declaredIntents"], "properties": { "sceneId": { "$ref": "#/$defs/id" }, "status": { "enum": ["open", "declared", "resolving"] }, "promptingEntityId": { "$ref": "#/$defs/nullableId" }, "eligibleParticipantIds": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "declaredIntents": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/intent" } } } },
      "intent": { "type": "object", "additionalProperties": false, "required": ["participantId", "actorId", "text", "activityId"], "properties": { "participantId": { "$ref": "#/$defs/id" }, "actorId": { "$ref": "#/$defs/nullableId" }, "text": { "$ref": "#/$defs/text" }, "activityId": { "$ref": "#/$defs/nullableId" } } }
    }
  },
  "exposure": "model-visible",
  "status": "active"
}
