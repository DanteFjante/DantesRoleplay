{
  "id": "dnd2024.query.inventory-container",
  "category": "dnd2024.presentation.inventory.container",
  "name": "D&D 2024 bounded character inventory",
  "description": "Returns one audience-authorized character's bounded containment tree, visible unclassified contents, and wallet without loading item dossiers, recipes, or uses.",
  "matches": [
    "show bounded character inventory",
    "inspect nested containers and wallet"
  ],
  "roles": {
    "subject": "The exact audience-authorized character entity."
  },
  "executor": "mechanic-projection",
  "projection": {
    "qualifiedId": "dnd2024.mechanic.inventory-container.project",
    "version": 1,
    "contentHash": "66929B55679B5759F65F99FB723D38A4C3D2600C5593CE6AD6BA743A4746549F",
    "outputSchemaHash": "84F826F94A8A32B2D92DDFD8EF65CF0B5E9C085AC7479BBAFCC2E0AA46C52953"
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["version", "owner", "state", "reasons", "items", "wallet", "limits"],
    "properties": {
      "version": { "const": 1 },
      "owner": { "$ref": "#/$defs/named" },
      "state": { "enum": ["ready", "partial"] },
      "reasons": {
        "type": "array",
        "maxItems": 2,
        "uniqueItems": true,
        "items": { "enum": ["depth-limit", "unclassified-content"] }
      },
      "items": {
        "type": "array",
        "maxItems": 100,
        "items": { "$ref": "#/$defs/item" }
      },
      "wallet": { "$ref": "#/$defs/wallet" },
      "limits": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contentsDepth", "itemCount", "complete"],
        "properties": {
          "contentsDepth": { "const": 4 },
          "itemCount": { "const": 100 },
          "complete": { "type": "boolean" }
        }
      }
    },
    "allOf": [
      {
        "if": { "properties": { "state": { "const": "ready" } } },
        "then": {
          "properties": {
            "reasons": { "maxItems": 0 },
            "limits": { "properties": { "complete": { "const": true } } }
          }
        }
      },
      {
        "if": { "properties": { "state": { "const": "partial" } } },
        "then": {
          "properties": {
            "reasons": { "minItems": 1 },
            "limits": { "properties": { "complete": { "const": false } } }
          }
        }
      }
    ],
    "$defs": {
      "id": { "type": "string", "minLength": 1, "maxLength": 200 },
      "text": { "type": "string", "minLength": 1, "maxLength": 400 },
      "nonnegative": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
      "named": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "$ref": "#/$defs/text" }
        }
      },
      "item": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "definition", "quantity", "slot", "parentItemId", "order", "depth", "childCount", "deeperContentsOmitted", "equipmentSlots", "classification"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "$ref": "#/$defs/text" },
          "definition": { "anyOf": [{ "$ref": "#/$defs/named" }, { "type": "null" }] },
          "quantity": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, { "type": "null" }] },
          "slot": { "type": "string", "maxLength": 200 },
          "parentItemId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
          "order": { "type": "integer", "minimum": 0, "maximum": 99 },
          "depth": { "type": "integer", "minimum": 1, "maximum": 4 },
          "childCount": { "type": "integer", "minimum": 0, "maximum": 100 },
          "deeperContentsOmitted": { "type": "boolean" },
          "equipmentSlots": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/named" } },
          "classification": { "enum": ["item", "unclassified"] }
        }
      },
      "wallet": {
        "type": "object",
        "additionalProperties": false,
        "required": ["coinCount", "copperValue", "gpCount", "denominations"],
        "properties": {
          "coinCount": { "$ref": "#/$defs/nonnegative" },
          "copperValue": { "$ref": "#/$defs/nonnegative" },
          "gpCount": { "$ref": "#/$defs/nonnegative" },
          "denominations": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["denomination", "code", "count", "copperValuePerCoin", "totalCopperValue"],
              "properties": {
                "denomination": { "$ref": "#/$defs/named" },
                "code": { "enum": ["cp", "sp", "ep", "gp", "pp"] },
                "count": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                "copperValuePerCoin": { "enum": [1, 10, 50, 100, 1000] },
                "totalCopperValue": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
              }
            }
          }
        }
      }
    }
  },
  "exposure": "binding-only",
  "status": "active"
}
