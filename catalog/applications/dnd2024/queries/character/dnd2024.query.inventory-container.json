{
  "id": "dnd2024.query.inventory-container",
  "category": "dnd2024.presentation.inventory.container",
  "name": "D&D 2024 inventory container page",
  "description": "Returns the complete direct contents of one authorized inventory owner or contained object without loading item details, recipes, or uses.",
  "matches": ["show one inventory container", "inspect direct contained items"],
  "roles": { "subject": "The exact inventory owner or contained object." },
  "roleBindings": { "subject": { "source": "route-entity" } },
  "executor": "mechanic-projection",
  "projection": {
    "qualifiedId": "dnd2024.mechanic.inventory-container-page.project",
    "version": 1,
    "contentHash": "894A94AA6D6C007C2BCDE9D58A0F0C4E32D84DF84D84409F3531E71D4B6660C0",
    "outputSchemaHash": "A9F1FAB085349F43DB95DA022320289A3B0DE6C7853B32DA4DAC75AF9D817BF8"
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["version", "container", "state", "reasons", "items", "limits"],
    "properties": {
      "version": { "const": 2 },
      "container": { "$ref": "#/$defs/named" },
      "state": { "enum": ["ready", "partial"] },
      "reasons": { "type": "array", "maxItems": 2, "uniqueItems": true, "items": { "enum": ["unclassified-content", "source-incomplete"] } },
      "items": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/item" } },
      "limits": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contentsDepth", "itemCount", "directComplete", "recursiveComplete"],
        "properties": {
          "contentsDepth": { "const": 1 },
          "itemCount": { "const": 200 },
          "directComplete": { "const": true },
          "recursiveComplete": { "const": false }
        }
      }
    },
    "allOf": [
      { "if": { "properties": { "state": { "const": "ready" } } }, "then": { "properties": { "reasons": { "maxItems": 0 } } } },
      { "if": { "properties": { "state": { "const": "partial" } } }, "then": { "properties": { "reasons": { "minItems": 1 } } } }
    ],
    "$defs": {
      "id": { "type": "string", "minLength": 1, "maxLength": 200 },
      "text": { "type": "string", "minLength": 1, "maxLength": 400 },
      "named": {
        "type": "object", "additionalProperties": false, "required": ["id", "label"],
        "properties": { "id": { "$ref": "#/$defs/id" }, "label": { "$ref": "#/$defs/text" } }
      },
      "item": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "definition", "quantity", "slot", "order", "classification"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "$ref": "#/$defs/text" },
          "definition": { "anyOf": [{ "$ref": "#/$defs/named" }, { "type": "null" }] },
          "quantity": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, { "type": "null" }] },
          "slot": { "type": "string", "maxLength": 200 },
          "order": { "type": "integer", "minimum": 0, "maximum": 199 },
          "equipmentSlots": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/named" } },
          "classification": { "enum": ["item", "unclassified"] },
          "isContainer": { "type": "boolean" }
        }
      }
    }
  },
  "exposure": "binding-only",
  "status": "active"
}
