{
  "id": "dnd2024.query.character-dossier-v1",
  "category": "dnd2024.presentation.character-dossier",
  "name": "D&D 2024 canonical character dossier",
  "description": "Returns one audience-safe character dossier containing the canonical sheet, origin, class, feature, equipment, and provenance metadata.",
  "matches": [
    "show complete character dossier",
    "inspect character origin traits features and inventory",
    "read canonical character details with provenance"
  ],
  "roles": {
    "subject": "The exact audience-authorized character entity."
  },
  "executor": "mechanic-projection",
  "projection": {
    "qualifiedId": "dnd2024.mechanic.character-dossier-v1.project",
    "version": 1,
    "contentHash": "B31FCD00E42469E44B9D2614CF171E1C27A82EB6DCEE2FE79BEB978B279A0548",
    "outputSchemaHash": "D5701EAC2C3526E326E4C83C46C42F4C37B3D8380F1510881EB6A3467BEE8A5F"
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["version", "sheet", "origin", "classes", "features", "inventory", "definitions", "provenance"],
    "properties": {
      "version": { "const": 1 },
      "sheet": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "subject", "origin", "classes", "features", "inventory", "wallet"],
        "properties": {
          "version": { "const": 2 },
          "subject": { "$ref": "#/$defs/named" },
          "identity": { "type": "object" },
          "origin": { "type": "object" },
          "experience": { "type": "object" },
          "classes": { "type": "array", "maxItems": 20 },
          "level": { "type": "integer", "minimum": 1, "maximum": 20 },
          "proficiencyBonus": { "type": "integer", "minimum": 2, "maximum": 6 },
          "abilities": { "type": "array", "maxItems": 6 },
          "savingThrows": { "type": "array", "maxItems": 6 },
          "skills": { "type": "array", "maxItems": 18 },
          "initiative": { "type": "object" },
          "hitPoints": { "type": "object" },
          "temporaryHitPoints": { "type": "object" },
          "armorClass": { "type": "object" },
          "body": { "type": "object" },
          "movement": { "type": "array", "maxItems": 16 },
          "senses": { "type": "array", "maxItems": 32 },
          "conditions": { "type": "array", "maxItems": 100 },
          "proficiencies": { "type": "array", "maxItems": 256 },
          "features": { "type": "array", "maxItems": 1024 },
          "resources": { "type": "array", "maxItems": 256 },
          "spellcasting": { "type": "array", "maxItems": 64 },
          "actions": { "type": "array", "maxItems": 256 },
          "inventory": { "type": "object" },
          "wallet": { "type": "object" }
        }
      },
      "origin": {
        "type": "object",
        "additionalProperties": false,
        "required": ["species", "background", "traits"],
        "properties": {
          "species": { "$ref": "#/$defs/definition" },
          "background": { "$ref": "#/$defs/definition" },
          "traits": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/pendingTrait" } }
        }
      },
      "classes": {
        "type": "array",
        "minItems": 1,
        "maxItems": 20,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "definition", "level", "subclass"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "name": { "$ref": "#/$defs/text" },
            "definition": { "$ref": "#/$defs/definition" },
            "level": { "type": "integer", "minimum": 1, "maximum": 20 },
            "subclass": { "anyOf": [{ "$ref": "#/$defs/named" }, { "type": "null" }] }
          }
        }
      },
      "features": {
        "type": "array",
        "maxItems": 1024,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["definition", "grantedBy", "grantKind", "classLevel", "configurationKey", "implementation"],
          "properties": {
            "definition": { "$ref": "#/$defs/definition" },
            "grantedBy": { "$ref": "#/$defs/definition" },
            "grantKind": { "$ref": "#/$defs/id" },
            "classLevel": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 20 }, { "type": "null" }] },
            "configurationKey": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
            "implementation": { "$ref": "#/$defs/implementation" }
          }
        }
      },
      "inventory": {
        "type": "object",
        "additionalProperties": false,
        "required": ["definitions", "contentsDepth", "mayOmitDeeperContents"],
        "properties": {
          "definitions": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/definition" } },
          "contentsDepth": { "const": 4 },
          "mayOmitDeeperContents": { "const": true }
        }
      },
      "definitions": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/definition" } },
      "provenance": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sheetQueryId", "sheetProjectionId", "dossierProjectionId", "definitionCount", "inventoryDepth", "ruleTextPolicy"],
        "properties": {
          "sheetQueryId": { "const": "dnd2024.query.character-sheet-v2" },
          "sheetProjectionId": { "const": "dnd2024.mechanic.character-sheet-v2.project" },
          "dossierProjectionId": { "const": "dnd2024.mechanic.character-dossier-v1.project" },
          "definitionCount": { "type": "integer", "minimum": 3, "maximum": 512 },
          "inventoryDepth": { "const": 4 },
          "ruleTextPolicy": { "const": "canonical-only" }
        }
      }
    },
    "$defs": {
      "id": { "type": "string", "minLength": 1, "maxLength": 200 },
      "text": { "type": "string", "minLength": 1, "maxLength": 5000 },
      "named": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": { "id": { "$ref": "#/$defs/id" }, "label": { "$ref": "#/$defs/text" } }
      },
      "source": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "locator"],
        "properties": { "sourceId": { "$ref": "#/$defs/id" }, "locator": { "$ref": "#/$defs/text" } }
      },
      "definition": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "canonicalName", "kind", "status", "summary", "source"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "$ref": "#/$defs/text" },
          "canonicalName": { "$ref": "#/$defs/text" },
          "kind": { "$ref": "#/$defs/id" },
          "status": { "enum": ["active", "identity-only"] },
          "summary": { "anyOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] },
          "source": { "anyOf": [{ "$ref": "#/$defs/source" }, { "type": "null" }] }
        }
      },
      "pendingTrait": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "status", "reason", "source"],
        "properties": {
          "key": { "$ref": "#/$defs/id" },
          "label": { "$ref": "#/$defs/text" },
          "status": { "const": "pending" },
          "reason": { "$ref": "#/$defs/id" },
          "source": { "anyOf": [{ "$ref": "#/$defs/source" }, { "type": "null" }] }
        }
      },
      "implementation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "reason", "entitlementKey"],
        "properties": {
          "status": { "enum": ["recorded", "pending"] },
          "reason": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
          "entitlementKey": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
        }
      }
    }
  },
  "exposure": "model-visible",
  "status": "active"
}
