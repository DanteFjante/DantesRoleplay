<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.5984942">
  <PropertyGroup>
    <ShouldRunNpmInstall>false</ShouldRunNpmInstall>
    <ShouldRunNpmAudit>false</ShouldRunNpmAudit>
    <ShouldRunBuildScript>false</ShouldRunBuildScript>
    <BaseIntermediateOutputPath>../../../artifacts/dnd2024-esproj/obj/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../../prototype/dnd2024/**/*"
          Exclude="../../../prototype/dnd2024/node_modules/**"
          Link="Prototype/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
