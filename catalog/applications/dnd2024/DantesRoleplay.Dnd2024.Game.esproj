<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.5984942">
  <PropertyGroup>
    <ShouldRunNpmInstall>false</ShouldRunNpmInstall>
    <ShouldRunNpmAudit>false</ShouldRunNpmAudit>
    <ShouldRunBuildScript>false</ShouldRunBuildScript>
    <BaseIntermediateOutputPath>../../../artifacts/dnd2024-esproj/obj/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../../src/system/web-interface/dnd2024/**/*"
          Exclude="../../../src/system/web-interface/dnd2024/node_modules/**;../../../src/system/web-interface/dnd2024/server-dist/**"
          Link="Web/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
