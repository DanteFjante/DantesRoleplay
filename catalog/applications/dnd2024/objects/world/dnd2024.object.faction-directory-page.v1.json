{
  "id": "dnd2024.object.faction-directory-page",
  "version": 1,
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "worldSummary": { "type": "string", "minLength": 1, "maxLength": 1000 },
      "items": {
        "type": "array",
        "maxItems": 25,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "status", "summary", "visibility", "goals", "methods", "assets", "agenda", "members", "controlledSites", "territories", "allies", "opponents"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 200 },
            "name": { "type": "string", "minLength": 1, "maxLength": 400 },
            "status": { "enum": ["draft", "active", "archived"] },
            "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "visibility": { "enum": ["public", "party", "gm"] },
            "goals": { "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
            "methods": { "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
            "assets": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
            "agenda": {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "summary"],
              "properties": {
                "state": { "enum": ["ready", "advanced"] },
                "summary": { "type": "string", "minLength": 1, "maxLength": 1000 }
              }
            },
            "members": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "$ref": "#/$defs/entityReference" } },
            "controlledSites": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "$ref": "#/$defs/entityReference" } },
            "territories": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "$ref": "#/$defs/entityReference" } },
            "allies": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "$ref": "#/$defs/entityReference" } },
            "opponents": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "$ref": "#/$defs/entityReference" } }
          }
        }
      },
      "totalCount": { "type": "integer", "minimum": 0, "maximum": 100 },
      "complete": { "type": "boolean" },
      "nextCursor": { "type": ["string", "null"], "maxLength": 2048 }
    },
    "$defs": {
      "entityReference": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "name": { "type": "string", "minLength": 1, "maxLength": 400 }
        }
      }
    }
  },
  "roles": {
    "world": { "required": true },
    "faction": { "required": false },
    "member": { "required": false },
    "site": { "required": false },
    "related-faction": { "required": false }
  },
  "sources": [
    {
      "id": "world",
      "role": "world",
      "component": {
        "qualifiedId": "game.core.world.root",
        "version": 1,
        "schemaHash": "B958F2DF352FA2B15FA704DCAAB340B4EE5EB4F838437943A90DFB77675C615D"
      },
      "required": true
    }
  ],
  "relationships": [
    {
      "id": "factions",
      "qualifiedKind": "game.core.world.faction.in-world",
      "fromRole": "faction",
      "toRole": "world",
      "direction": "incoming",
      "cardinality": "many",
      "targetPointer": "/items",
      "requiredEndpointComponents": [
        {
          "endpoint": "from",
          "component": {
            "qualifiedId": "game.core.world.faction",
            "version": 1,
            "schemaHash": "A939B23A49385B9C7A3CDE667F286653154385453D9BE3CD0865DDBE1DC15F77"
          }
        }
      ],
      "optionalEndpointComponents": []
    },
    {
      "id": "members",
      "qualifiedKind": "game.core.world.faction.member",
      "fromRole": "faction",
      "toRole": "member",
      "cardinality": "many",
      "targetPointer": "/items/*/members",
      "requiredEndpointComponents": [],
      "optionalEndpointComponents": []
    },
    {
      "id": "controlled-sites",
      "qualifiedKind": "game.core.world.faction.controls",
      "fromRole": "faction",
      "toRole": "site",
      "cardinality": "many",
      "targetPointer": "/items/*/controlledSites",
      "requiredEndpointComponents": [],
      "optionalEndpointComponents": []
    },
    {
      "id": "territories",
      "qualifiedKind": "game.core.world.faction.territory-controls",
      "fromRole": "faction",
      "toRole": "site",
      "cardinality": "many",
      "targetPointer": "/items/*/territories",
      "requiredEndpointComponents": [],
      "optionalEndpointComponents": []
    },
    {
      "id": "allies",
      "qualifiedKind": "game.core.world.faction.allied-with",
      "fromRole": "faction",
      "toRole": "related-faction",
      "cardinality": "many",
      "targetPointer": "/items/*/allies",
      "requiredEndpointComponents": [],
      "optionalEndpointComponents": []
    },
    {
      "id": "opponents",
      "qualifiedKind": "game.core.world.faction.opposed-to",
      "fromRole": "faction",
      "toRole": "related-faction",
      "cardinality": "many",
      "targetPointer": "/items/*/opponents",
      "requiredEndpointComponents": [],
      "optionalEndpointComponents": []
    }
  ],
  "references": [],
  "mappings": [
    { "inputId": "world", "sourcePointer": "/summary", "targetPointer": "/worldSummary" }
  ],
  "collections": [
    {
      "id": "factions",
      "sourceId": "factions",
      "pageSize": 25,
      "maximumPageSize": 25,
      "order": [{ "path": "/name", "direction": "asc" }],
      "cursor": "source-revision-bound"
    }
  ],
  "limits": { "traversalDepth": 2, "itemCount": 100, "outputBytes": 262144, "sqlQueries": 12 },
  "access": { "read": ["dm"], "write": [] }
}
