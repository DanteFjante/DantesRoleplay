{
  "id": "dnd2024.object.world-campaign-directory",
  "version": 1,
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "worldSummary": { "type": "string", "minLength": 1, "maxLength": 1000 },
      "selectedWorld": { "$ref": "#/$defs/entityReference" },
      "campaigns": {
        "type": "array", "maxItems": 25,
        "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "name", "status", "title", "premise", "partyGoals", "toneAndBoundaries", "rulesetScope", "creationMethod", "reviewFingerprint"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 200 },
            "name": { "type": "string", "minLength": 1, "maxLength": 400 },
            "status": { "const": "active" },
            "title": { "type": "string", "minLength": 1, "maxLength": 160 },
            "premise": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "partyGoals": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
            "toneAndBoundaries": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
            "rulesetScope": { "const": "dnd2024" },
            "creationMethod": { "const": "manual" },
            "reviewFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      },
      "totalCount": { "type": "integer", "minimum": 0, "maximum": 256 },
      "complete": { "type": "boolean" },
      "nextCursor": { "type": ["string", "null"], "maxLength": 2048 }
    },
    "$defs": {
      "entityReference": {
        "type": "object", "additionalProperties": false, "required": ["id", "name"],
        "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 200 }, "name": { "type": "string", "minLength": 1, "maxLength": 400 } }
      }
    }
  },
  "roles": { "campaign": { "required": true }, "world": { "required": true }, "listed-campaign": { "required": false } },
  "sources": [{
    "id": "world", "role": "world",
    "component": { "qualifiedId": "game.core.world.root", "version": 1, "schemaHash": "B958F2DF352FA2B15FA704DCAAB340B4EE5EB4F838437943A90DFB77675C615D" },
    "required": true
  }],
  "relationships": [
    {
      "id": "selected-world", "qualifiedKind": "game.core.campaign.in-world", "fromRole": "campaign", "toRole": "world",
      "cardinality": "one", "targetPointer": "/selectedWorld", "requiredEndpointComponents": [], "optionalEndpointComponents": []
    },
    {
      "id": "campaigns", "qualifiedKind": "game.core.campaign.in-world", "fromRole": "listed-campaign", "toRole": "world", "direction": "incoming",
      "cardinality": "many", "targetPointer": "/campaigns",
      "requiredEndpointComponents": [{ "endpoint": "from", "component": { "qualifiedId": "game.core.campaign.root", "version": 1, "schemaHash": "FF68DCFF34FA11442CFAF9E75C8F1E73C64FBD6CE525C34EA06A197614D68BD9" } }],
      "optionalEndpointComponents": []
    }
  ],
  "references": [],
  "mappings": [{ "inputId": "world", "sourcePointer": "/summary", "targetPointer": "/worldSummary" }],
  "collections": [{ "id": "campaigns", "sourceId": "campaigns", "pageSize": 25, "maximumPageSize": 25, "order": [{ "path": "/name", "direction": "asc" }, { "path": "/id", "direction": "asc" }], "cursor": "source-revision-bound" }],
  "limits": { "traversalDepth": 1, "itemCount": 256, "outputBytes": 262144, "sqlQueries": 12 },
  "access": { "read": ["dm"], "write": [] }
}
