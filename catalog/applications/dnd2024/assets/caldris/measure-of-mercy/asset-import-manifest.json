    "preconditions": [
      "Verify the live state-space and each existing component revision/hash against authority and previousActiveMap.",
      "Retain a database backup and every current blob before mutation.",
      "Land the P2 site/interior map-parent validator change.",
      "Resolve the authored map.visual schema versus the registered live hash-bearing schema before import."
    ],
    "order": [
      "Upload all 11 PNG files to content-addressed blob storage and verify SHA-256 and byte length.",
      "Create the 14 locations, then their containment and map.anchor components with expected absence.",
      "Apply eight map.visual bindings with exact component CAS; preserve both player and DM variants on one terrain master.",
      "Retain the three scene attachments but leave them unbound until explicit scene use.",
      "Import prepared-situation clue entities and relationships as unrevealed GM content.",
      "Read back entity, component, containment, relationship, blob, and audience projections before activation."
    ],
    "rollback": [
      "Restore each of the six replaced map.visual values from previousActiveMap through a new version-checked operation.",
      "Remove only newly created records that are still unreferenced, using supported versioned operations.",
      "Do not delete retained blobs or rewrite operation history."
    ],
    "knownContractDependencies": [
      "P2 must accept direct map-owning parents of kind site or interior.",
      "The live registered game.core.world.map.visual schema stores content-addressed metadata, while the authored catalog schema currently stores assetKey and alt; coordinator must choose and migrate one contract."
    ]
  }
