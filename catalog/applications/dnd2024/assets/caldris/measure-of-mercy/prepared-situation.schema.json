{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Package document validation only. Runtime values are separately validated against registered component schemas.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "id",
    "title",
    "status",
    "applicationId",
    "stateSpaceId",
    "campaignId",
    "chapterId",
    "arcId",
    "opening",
    "npcGoals",
    "dmTruthReferences",
    "reusedClueReferences",
    "clueCreates",
    "relationshipCreates",
    "scenes",
    "consequences",
    "optionalHooks",
    "playerOrientationCandidates",
    "prohibitedMutations",
    "canonicalKnowledgeRecord"
  ],
  "properties": {
    "format": {
      "const": "dnd2024.prepared-situation/1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "\\S"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "status": {
      "const": "future-ready-not-played"
    },
    "applicationId": {
      "const": "dnd2024"
    },
    "stateSpaceId": {
      "const": "dnd2024-main"
    },
    "campaignId": {
      "const": "campaign.caldris.measure-of-mercy"
    },
    "chapterId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "\\S"
    },
    "arcId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "\\S"
    },
    "opening": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locationId",
        "text",
        "hasOccurred"
      ],
      "properties": {
        "locationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "\\S"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "hasOccurred": {
          "const": false
        }
      }
    },
    "npcGoals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "actorId",
          "motiveRevision",
          "goal"
        ],
        "properties": {
          "actorId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "\\S"
          },
          "motiveRevision": {
            "type": "integer",
            "minimum": 1
          },
          "goal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          }
        }
      }
    },
    "dmTruthReferences": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "const": "secret.caldris.quest.q01.the-thirteenth-bell"
      }
    },
    "reusedClueReferences": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "disposition",
          "sourceEvidenceFile",
          "sourceStateSpaceFingerprint",
          "projectionDocumentRevision",
          "subjectId",
          "title",
          "summary"
        ],
        "properties": {
          "id": {
            "enum": [
              "clue.caldris.q01.dry-flour",
              "clue.caldris.q01.theatre-fibres",
              "clue.caldris.q01.barge-timing"
            ]
          },
          "disposition": {
            "const": "reuse-existing-record-and-relationships"
          },
          "sourceEvidenceFile": {
            "const": "party-knowledge-dm-page-0.json"
          },
          "sourceStateSpaceFingerprint": {
            "const": "717BE58BCC02FE2A2F2727D3227E43C45086E2AFE93577F4B1A4695F9CB9A45B"
          },
          "projectionDocumentRevision": {
            "const": "BC07473896F1395ACD7F9BC2C5B9A5A3E23BB78BE1A90AE359F11D9950E7FAF5"
          },
          "subjectId": {
            "const": "location.caldris.bramblebridge"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "\\S"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          }
        }
      }
    },
    "clueCreates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "container",
          "components"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "\\S"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "\\S"
          },
          "container": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "slot"
            ],
            "properties": {
              "id": {
                "const": "location.caldris.atlas"
              },
              "slot": {
                "const": "opening-clues"
              }
            }
          },
          "components": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 8
          }
        }
      }
    },
    "relationshipCreates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "kind",
          "data"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "\\S"
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "\\S"
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "\\S"
          },
          "data": {
            "type": "object"
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "locationId",
          "assetKey",
          "trigger",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "\\S"
          },
          "locationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "\\S"
          },
          "assetKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "\\S"
          },
          "trigger": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          },
          "status": {
            "const": "prepared-unused"
          }
        }
      }
    },
    "consequences": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "condition",
          "result"
        ],
        "properties": {
          "condition": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          },
          "result": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          }
        }
      }
    },
    "optionalHooks": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "locationId",
          "hook"
        ],
        "properties": {
          "locationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "\\S"
          },
          "hook": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          }
        }
      }
    },
    "playerOrientationCandidates": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subjectId",
          "text",
          "admitToActorId",
          "requiresExplicitAdmission",
          "currentlyAdmitted"
        ],
        "properties": {
          "subjectId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "\\S"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          },
          "admitToActorId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "\\S"
          },
          "requiresExplicitAdmission": {
            "const": true
          },
          "currentlyAdmitted": {
            "const": false
          }
        }
      }
    },
    "prohibitedMutations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000,
        "pattern": "\\S"
      }
    },
    "canonicalKnowledgeRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "entityCreate",
        "relationshipCreates",
        "retrieval"
      ],
      "properties": {
        "owner": {
          "const": "existing-world-knowledge"
        },
        "entityCreate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "container",
            "components"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240,
              "pattern": "\\S"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240,
              "pattern": "\\S"
            },
            "container": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "slot"
              ],
              "properties": {
                "id": {
                  "const": "location.caldris.atlas"
                },
                "slot": {
                  "const": "knowledge"
                }
              }
            },
            "components": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 8
            }
          }
        },
        "relationshipCreates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "kind",
              "data"
            ],
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "\\S"
              },
              "to": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "\\S"
              },
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "\\S"
              },
              "data": {
                "type": "object"
              }
            }
          }
        },
        "retrieval": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        }
      }
    }
  }
}
