{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "extensionId",
    "applicationId",
    "sourceId",
    "displayName",
    "description",
    "classification",
    "requiredSourceIds",
    "enabledByDefault"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "extensionId": {
      "type": "string",
      "minLength": 9,
      "maxLength": 120
    },
    "applicationId": { "const": "dnd2024" },
    "sourceId": {
      "type": "string",
      "minLength": 19,
      "maxLength": 160
    },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "classification": {
      "type": "string",
      "enum": ["compatibility", "homebrew", "third-party"]
    },
    "requiredSourceIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": { "const": "dnd2024-core" }
    },
    "enabledByDefault": { "const": false }
  }
}
