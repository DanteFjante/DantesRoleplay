{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "applicationId", "extensionId", "displayName", "description", "classification", "sourceIds", "namespaceIds", "dependencies", "conflictsWith", "higherPriorityThan", "overridesBase"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "applicationId": { "const": "dnd2024" },
    "extensionId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "classification": { "enum": ["compatibility", "homebrew", "third-party"] },
    "sourceIds": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
    "namespaceIds": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "pattern": "^dnd2024\\.[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*$", "maxLength": 200 } },
    "dependencies": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" } },
    "conflictsWith": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" } },
    "higherPriorityThan": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" } },
    "overridesBase": { "type": "boolean" }
  }
}
