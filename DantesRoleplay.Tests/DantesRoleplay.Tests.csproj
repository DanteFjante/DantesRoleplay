<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The tests reference DantesRoleplay.MCPServer, which is an ASP.NET Core application. Without
      this the test project tries to resolve the ASP.NET Core assemblies as NuGet packages instead
      of using the shared framework, which fails offline and pins patch versions that have nothing
      to do with this solution. It is also what lets the end-to-end test host the server in-process.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!--
      DataAccess, not just the core project. The tests exercise DantesRoleplayDbContext,
      ProcedureStore, OperationLog and WorldStore, all of which live here — and this reference is
      also what brings Microsoft.EntityFrameworkCore and Microsoft.Data.Sqlite into scope
      transitively, which is what SqliteFixture needs.

      The core project comes along with it (DataAccess references it), so it is not listed twice.
    -->
    <ProjectReference Include="..\DantesRoleplay.DataAccess\DantesRoleplay.DataAccess.csproj" />

    <!--
      The MCP tool tests invoke the thin adapters directly. The server references DataAccess,
      so this adds no alternate implementation or dependency direction in the production code.
    -->
    <ProjectReference Include="..\DantesRoleplay.MCPServer\DantesRoleplay.MCPServer.csproj" />
    <ProjectReference Include="..\DantesRoleplay.LocalAI\DantesRoleplay.LocalAI.csproj" />
    <ProjectReference Include="..\DantesRoleplay.Tools\DantesRoleplay.Tools.csproj" />
    <ProjectReference Include="..\DantesRoleplay.Web\DantesRoleplay.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Focused tests move beside each capability while retaining the shared test assembly. -->
    <Compile Include="..\src\system\**\tests\*.cs">
      <Link>Components\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <!-- Retained tests for former game adapters are not part of the generic host test assembly. -->
    <Compile Remove="DevelopmentKnowledgeAudienceTests.cs" />
    <Compile Remove="CatalogWorldFeature7Tests.cs" />
    <Compile Remove="CatalogWorldFeature9Tests.cs" />
    <Compile Remove="CategoryToolTests.cs" />
    <Compile Remove="InformationTests.cs" />
    <Compile Remove="ProcedureBoundActionVerifierTests.cs" />
    <Compile Remove="ProtocolWalkTests.cs" Condition="'$(IncludeProtocolWalkTests)' != 'true'" />
    <Compile Remove="SessionFeature4Tests.cs" />
    <Compile Remove="SqliteVecExtensionProbeTests.cs" />
    <Compile Remove="VerbToolTests.cs" />
    <Compile Remove="..\src\system\events-and-notifications\tests\SubscriptionStoreTests.cs" />
    <Compile Remove="..\src\system\actions\tests\ActionRunnerParticipantTests.cs" />
    <Compile Remove="..\src\system\snapshots\tests\SnapshotFeature1Tests.cs" />
  </ItemGroup>

</Project>
